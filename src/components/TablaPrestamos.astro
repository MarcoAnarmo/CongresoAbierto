---
import type { Prestamo } from '../lib/types';
interface Props { prestamos: Prestamo[] }
const { prestamos } = Astro.props;
---
<div class="card tabla-prestamos" style="padding:0">
  <table>
    <thead><tr><th scope="col">Préstamo (descripción y acreedor)</th><th scope="col">Concesión</th><th scope="col" class="num">Importe concedido</th><th scope="col" class="num">Saldo pendiente</th></tr></thead>
    <tbody>
      {prestamos.map((x) => (
        <tr>
          <td class="desc">{x.descripcion || '—'}</td>
          <td data-label="Concesión">{x.fechaConcesion ?? '—'}</td>
          <td class="num" data-label="Concedido">{x.concedido ?? '—'}</td>
          <td class="num" data-label="Pendiente"><strong>{x.pendiente ?? '—'}</strong></td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .tabla-prestamos td.num { white-space: nowrap; }
  @media (max-width: 640px) {
    .tabla-prestamos thead { display: none; }
    .tabla-prestamos tr { display: block; padding: 12px 16px; border-bottom: 1px solid var(--border); }
    .tabla-prestamos tr:last-child { border-bottom: 0; }
    .tabla-prestamos td { display: flex; justify-content: space-between; gap: 16px; border: 0; padding: 3px 0; text-align: right; font-size: .9rem; }
    .tabla-prestamos td.desc { display: block; text-align: left; font-size: 1rem; padding-bottom: 4px; }
    .tabla-prestamos td[data-label]::before { content: attr(data-label); color: var(--muted); font-size: .8rem; }
  }
</style>
