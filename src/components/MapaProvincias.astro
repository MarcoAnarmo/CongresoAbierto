---
import { diputados, colorGrupo, url, slug, etiquetaPartido, grupos } from '../lib/data';
import { PROVINCIAS, COLUMNAS, FILAS, nombreLegible } from '../lib/provincias';
import { idiomaDeUrl, formatos, f, pl } from '../i18n';
import comun from '../i18n/textos/comun';
import textos from '../i18n/textos/mapa';

const lang = idiomaDeUrl(Astro.url.pathname);
const c = comun[lang];
const t = textos[lang];
const fmt = formatos(lang);

const orden = new Map(grupos.map((g) => [g.corto, g.orden]));
const porProvincia = PROVINCIAS.map((p) => {
  const ds = diputados
    .filter((d) => d.circunscripcion === p.nombre)
    .sort((a, b) => (orden.get(a.grupoCorto)! - orden.get(b.grupoCorto)!) || fmt.comparar(a.apellidos, b.apellidos));
  const conDatos = ds.filter((d) => d.patrimonio.viviendas !== null);
  const viviendas = conDatos.reduce((a, d) => a + (d.patrimonio.viviendas ?? 0), 0);
  const propiedades = conDatos.reduce((a, d) => a + (d.patrimonio.propiedades ?? 0), 0);
  return {
    ...p,
    legible: nombreLegible(p.nombre),
    escanos: ds.length,
    propiedades,
    viviendas,
    conDatos: conDatos.length,
    dips: ds.map((d) => ({ n: d.nombreCompleto, g: d.grupoCorto, c: colorGrupo(d.grupoCorto), p: etiquetaPartido(d, lang), v: d.patrimonio.viviendas, pr: d.patrimonio.propiedades, f: d.fotoUrl, s: slug(d) })),
  };
});
const sinCasilla = diputados.filter((d) => !PROVINCIAS.some((p) => p.nombre === d.circunscripcion));
if (sinCasilla.length) throw new Error(`Circunscripciones sin casilla en el mapa: ${[...new Set(sinCasilla.map((d) => d.circunscripcion))].join(', ')}`);

/** enVista: dentro de las pestañas de Diputados (título solo para lectores de pantalla, sin margen arriba). */
interface Props { enVista?: boolean }
const { enVista = false } = Astro.props;

const celdas: ((typeof porProvincia)[number] | null)[] = [];
for (let f = 0; f < FILAS; f++) for (let c = 0; c < COLUMNAS; c++) celdas.push(porProvincia.find((p) => p.col === c && p.fila === f) ?? null);
---
<section class:list={['mapa', { 'en-vista': enVista }]} aria-labelledby="mapa-h" id="mapa">
  <h2 id="mapa-h" class:list={{ 'sr-only': enVista }}>{t.titulo}</h2>
  <p class="muted small intro">{t.intro}</p>

  <div class="controles">
    <div class="segmentado" role="group" aria-label={t.modosAria}>
      <button class="btn" type="button" data-mmodo="escanos" aria-pressed="true">{c.nav.diputados}</button>
      <button class="btn" type="button" data-mmodo="propiedades" aria-pressed="false">{t.modos.propiedades}</button>
      <button class="btn" type="button" data-mmodo="viviendas" aria-pressed="false">{t.modos.viviendas}</button>
    </div>
    <form class="buscar-cp" id="mapa-cp-form" novalidate>
      <label for="mapa-cp" class="sr-only">{t.cpLabel}</label>
      <input type="search" id="mapa-cp" inputmode="numeric" maxlength="5" placeholder={t.cpPlaceholder} autocomplete="postal-code" aria-describedby="mapa-cp-error" />
      <button class="btn" type="submit">{t.buscar}</button>
    </form>
  </div>
  <p class="error small" id="mapa-cp-error" aria-live="polite"></p>

  <div class="disposicion">
    <div>
      <div class="rejilla" style={`--cols:${COLUMNAS}`}>
        {celdas.map((p) => p
          ? <button type="button" class="casilla" data-ab={p.abrev} data-escanos={p.escanos} data-propiedades={p.conDatos ? p.propiedades : ''} data-viviendas={p.conDatos ? p.viviendas : ''} aria-label={f(t.casillaAria, { provincia: p.legible, diputados: pl(p.escanos, c.palabras.diputados, lang) })} title={p.legible}>{p.abrev}</button>
          : <span class="hueco" aria-hidden="true"></span>)}
      </div>
      <div class="leyenda small" id="mapa-leyenda" aria-hidden="true"></div>
    </div>

    <div class="panel card" id="mapa-panel" aria-live="polite">
      <p class="small muted">{t.elige}</p>
    </div>
  </div>
</section>

<script type="application/json" data-textos="mapa" set:html={JSON.stringify(t.cliente)} />
<script type="application/json" id="mapa-datos" set:html={JSON.stringify({ base: url(''), provincias: porProvincia.map(({ col, fila, nombre, ...r }) => r) })} />

<script>
  import { textos, f, pl, prefijo } from '../i18n/cliente';
  type Tx = {
    escanosMas: string; masDe: string; leyendaEscanos: string; leyendaPropiedades: string; leyendaViviendas: string;
    propiedadesDip: [string, string]; viviendasDip: [string, string]; elegidos: [string, string]; declaradas: [string, string]; errorCp: string; cpSinProvincia: string;
  };
  const tx = textos<Tx>('mapa');
  /** Singular o plural con la cifra tal cual (como en la lista de cada provincia). */
  const cuenta = (n: number | null, [uno, varios]: [string, string]) => f(n === 1 ? uno : varios, { n: String(n) });
  type Dip = { n: string; g: string; c: string; p: string; v: number | null; pr: number | null; f: string; s: string };
  type Prov = { abrev: string; legible: string; cp: number; escanos: number; propiedades: number; viviendas: number; conDatos: number; dips: Dip[] };
  const raw = JSON.parse(document.getElementById('mapa-datos')!.textContent!) as { base: string; provincias: Prov[] };
  const casillas = [...document.querySelectorAll<HTMLButtonElement>('.mapa .casilla')];
  const botones = [...document.querySelectorAll<HTMLButtonElement>('.mapa [data-mmodo]')];
  const panel = document.getElementById('mapa-panel')!;
  const leyenda = document.getElementById('mapa-leyenda')!;
  const form = document.getElementById('mapa-cp-form') as HTMLFormElement;
  const cp = document.getElementById('mapa-cp') as HTMLInputElement;
  const error = document.getElementById('mapa-cp-error')!;
    const escala = [0, 1, 2, 3, 4, 5].map((i) => `var(--int-${i})`);
  const modos = {
    escanos: { cortes: [1, 3, 5, 8, 16], etiquetas: ['1', '2–3', '4–5', '6–8', '9–16', f(tx.escanosMas, { n: 30 })], valor: (c: HTMLElement) => Number(c.dataset.escanos) },
    propiedades: { cortes: [5, 10, 15, 25, 40], etiquetas: ['1–5', '6–10', '11–15', '16–25', '26–40', f(tx.masDe, { n: 40 })], valor: (c: HTMLElement) => (c.dataset.propiedades ? Number(c.dataset.propiedades) : null) },
    viviendas: { cortes: [3, 6, 10, 15, 25], etiquetas: ['1–3', '4–6', '7–10', '11–15', '16–25', f(tx.masDe, { n: 25 })], valor: (c: HTMLElement) => (c.dataset.viviendas ? Number(c.dataset.viviendas) : null) },
  };
  let actual: Prov | null = null;
  const esc = (s: string) => s.replace(/[&<>"]/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[ch]!);

  function pintar(m: keyof typeof modos) {
    botones.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.mmodo === m)));
    const t = modos[m];
    casillas.forEach((c) => {
      const v = t.valor(c);
      const i = v === null ? -1 : (t.cortes.findIndex((x) => v <= x) + 1 || t.cortes.length + 1) - 1;
      c.style.background = i < 0 ? 'transparent' : escala[i];
      c.classList.toggle('oscura', i >= 3);
    });
    leyenda.innerHTML = ({ escanos: tx.leyendaEscanos, propiedades: tx.leyendaPropiedades, viviendas: tx.leyendaViviendas })[m]
      + escala.map((c, i) => `<span class="pill"><span class="dot" style="background:${c}"></span>${t.etiquetas[i]}</span>`).join(' ');
    if (actual) mostrar(actual, false);
  }

  function mostrar(p: Prov, enfocar = true) {
    actual = p;
    casillas.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.ab === p.abrev)));
    const filas = p.dips.map((d) => `
      <li><a href="${prefijo()}/diputado/${d.s}">
        <img src="${esc(d.f)}" alt="" width="40" height="50" loading="lazy" referrerpolicy="no-referrer" />
        <span class="quien"><strong>${esc(d.n)}</strong><span class="muted small"><span class="dot" style="background:${d.c}"></span> ${esc(d.p)}</span></span>
        <span class="cifra small">${d.pr === null ? '<strong>—</strong>' : `<span>${cuenta(d.pr, tx.propiedadesDip)}</span><span>${cuenta(d.v, tx.viviendasDip)}</span>`}</span>
      </a></li>`).join('');
    panel.innerHTML = `
      <h3>${esc(p.legible)}</h3>
      <p class="small muted">${pl(p.escanos, tx.elegidos)} ${p.conDatos ? ` · ${pl(p.propiedades, tx.declaradas)} ${pl(p.viviendas, tx.viviendasDip)}` : ''}</p>
      <ul class="lista">${filas}</ul>`;
    if (enfocar && matchMedia('(max-width: 860px)').matches) panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  casillas.forEach((c) => c.addEventListener('click', () => mostrar(raw.provincias.find((p) => p.abrev === c.dataset.ab)!)));
  botones.forEach((b) => b.addEventListener('click', () => pintar(b.dataset.mmodo as keyof typeof modos)));
  cp.addEventListener('input', () => { error.textContent = ''; });
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const v = cp.value.trim();
    if (!/^\d{5}$/.test(v)) { error.textContent = tx.errorCp; return; }
    const p = raw.provincias.find((x) => x.cp === Number(v.slice(0, 2)));
    if (!p) { error.textContent = tx.cpSinProvincia; return; }
    mostrar(p);
  });
  pintar('escanos');
</script>

<style>
  .mapa { margin-top: 2.4rem; }
  .mapa.en-vista { margin-top: 0; }
  .en-vista .intro { margin-top: 0; }
  .intro { max-width: 62ch; margin-top: -.3rem; }
  .controles { display: flex; flex-wrap: wrap; gap: 10px 16px; align-items: center; margin: 12px 0 4px; }
  .buscar-cp { display: flex; gap: 6px; flex: 1 1 260px; min-width: 0; max-width: min(360px, 100%); }
  .buscar-cp input { flex: 1; min-width: 0; }
  .error { color: var(--no); min-height: 1.4em; margin: 2px 0 8px; }
  .disposicion { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 20px; align-items: start; }
  @media (max-width: 860px) { .disposicion { grid-template-columns: minmax(0, 1fr); } }
  .rejilla { display: grid; grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); gap: 4px; max-width: 560px; }
  .casilla, .hueco { aspect-ratio: 1; }
  .casilla { border: 1px solid var(--border); border-radius: 6px; padding: 0; cursor: pointer; font-size: clamp(.6rem, 2.3vw, .8rem); font-weight: 650; color: var(--text); letter-spacing: -.02em; transition: transform .12s, box-shadow .12s; }
  .casilla.oscura { color: var(--bg); }
  .casilla:hover { transform: scale(1.08); box-shadow: 0 0 0 2px var(--accent); }
  .casilla[aria-pressed='true'] { box-shadow: 0 0 0 3px var(--accent); }
  .leyenda { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; margin-top: 12px; color: var(--muted); }
  /* El panel se rellena desde el script: sus estilos van en :global() */
  .panel :global(h3) { margin: 0; font-size: 1.15rem; }
  .panel :global(> p) { margin: 2px 0 10px; }
  .panel :global(.lista) { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  @media (min-width: 861px) { .panel :global(.lista) { max-height: 460px; overflow-y: auto; } }
  .panel :global(.lista a) { display: flex; align-items: center; gap: 10px; padding: 6px; border-radius: 8px; text-decoration: none; }
  .panel :global(.lista a:hover) { background: color-mix(in srgb, var(--accent) 8%, transparent); color: inherit; }
  .panel :global(.lista img) { width: 40px; height: 50px; object-fit: cover; border-radius: 6px; background: var(--chip); flex: none; }
  .panel :global(.quien) { display: flex; flex-direction: column; min-width: 0; flex: 1; line-height: 1.3; }
  .panel :global(.quien strong) { font-size: .95rem; }
  .panel :global(.cifra) { white-space: nowrap; color: var(--muted); display: flex; flex-direction: column; align-items: flex-end; line-height: 1.3; }
  .panel :global(.cifra strong) { color: var(--text); }
  .leyenda :global(.pill) { font-size: .78rem; }
</style>
