---
/**
 * Estadísticas y Descargar comparten botón en la barra del móvil («Datos»): estas pestañas, arriba de las dos
 * páginas, cambian de una a otra.
 */
import Icono from './Icono.astro';
import { idiomaDeUrl, enlace } from '../i18n';
import comun from '../i18n/textos/comun';
interface Props { actual: 'estadisticas' | 'datos' }
const { actual } = Astro.props;
const lang = idiomaDeUrl(Astro.url.pathname);
const t = comun[lang].nav;
---
<nav class="segmentado pestanas-datos" aria-label={t.seccionDatos}>
  <a class="btn" href={enlace('/estadisticas', lang)} aria-current={actual === 'estadisticas' ? 'page' : undefined}><Icono n="estadisticas" tam={19} />{t.estadisticas}</a>
  <a class="btn" href={enlace('/datos', lang)} aria-current={actual === 'datos' ? 'page' : undefined}><Icono n="descarga" tam={19} />{t.descargar}</a>
</nav>

<style>
  .pestanas-datos { display: flex; width: 100%; max-width: 420px; margin: 4px 0 18px; }
  .pestanas-datos .btn { flex: 1 1 0; min-width: 0; display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 8px 10px; text-decoration: none; background-image: none; white-space: nowrap; }
  /* Móvil estrecho (iPhone SE): sin iconos y algo más pequeño, para que «Estadístiques» y «Descarregar» quepan */
  @media (max-width: 380px) { .pestanas-datos .btn { font-size: .9rem; padding: 8px 6px; } .pestanas-datos .btn :global(svg) { display: none; } }
  .pestanas-datos .btn[aria-current='page'] { background: var(--surface); color: var(--accent-text); font-weight: 650; box-shadow: 0 1px 3px rgb(0 0 0 / .12), 0 0 0 1px var(--border); }
</style>
