---
/**
 * Selector en chips que se desliza en horizontal (temas, grupos…). Cada chip muestra solo su bloque:
 * los elementos `[data-bloque="<elige>"][data-id="<valor>"]` de la misma sección. El activo lleva `data-activo`.
 * Sin JavaScript los chips no se ven y se ven todos los bloques.
 */
export interface OpcionChip { id: string; texto: string; n?: string; punto?: string }
interface Props { elige: string; etiqueta: string; opciones: OpcionChip[]; inicial: string }
const { elige, etiqueta, opciones, inicial } = Astro.props;
---
<div class="chips-sel" role="group" aria-label={etiqueta} data-chips={elige}>
  {opciones.map((o) => (
    <button type="button" class="chip-sel" data-valor={o.id} aria-pressed={o.id === inicial ? 'true' : 'false'}>
      {o.punto && <span class="dot" style={`background:${o.punto}`}></span>}{o.texto}{o.n && <span class="chip-n">{o.n}</span>}
    </button>
  ))}
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-chips]').forEach((grupo) => {
    const clave = grupo.dataset.chips!;
    const ambito = grupo.closest('section') ?? document.body;
    const bloques = [...ambito.querySelectorAll<HTMLElement>(`[data-bloque="${clave}"]`)];
    grupo.addEventListener('click', (e) => {
      const b = (e.target as Element).closest<HTMLButtonElement>('.chip-sel');
      if (!b || b.getAttribute('aria-pressed') === 'true') return;
      grupo.querySelectorAll('.chip-sel').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      bloques.forEach((x) => x.toggleAttribute('data-activo', x.dataset.id === b.dataset.valor));
      b.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    });
  });
</script>

<style>
  .chips-sel {
    display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none; margin: 0 calc(-1 * var(--pad, 16px)) 14px; padding: 2px var(--pad, 16px);
    scroll-padding-inline: var(--pad, 16px); -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 14px, #000 calc(100% - 22px), transparent);
    mask-image: linear-gradient(90deg, transparent 0, #000 14px, #000 calc(100% - 22px), transparent);
  }
  .chips-sel::-webkit-scrollbar { display: none; }
  :global(html:not(.js)) .chips-sel { display: none; }
  .chip-sel {
    flex: none; display: inline-flex; align-items: center; gap: 6px; min-height: 38px; padding: 6px 14px; border-radius: 999px;
    border: 1px solid var(--border); background: var(--surface); color: var(--text); font-size: .88rem; font-weight: 550;
    white-space: nowrap; cursor: pointer; transition: background-color .15s, border-color .15s, color .15s;
  }
  .chip-sel:hover { border-color: var(--accent); }
  .chip-sel[aria-pressed='true'] { background: var(--text); border-color: var(--text); color: var(--surface); }
  .chip-sel .dot { width: 8px; height: 8px; }
  .chip-n { font-size: .78rem; font-weight: 500; opacity: .7; font-variant-numeric: tabular-nums; }
</style>
