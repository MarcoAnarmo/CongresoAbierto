---
import { diputados, votaciones, votacionesPleno, TEMAS, temasDe, grupos, colorGrupo, url, slug, etiquetaPartido } from '../lib/data';
import { disponerPorGrupos } from '../lib/hemiciclo';
import { idiomaDeUrl, enlace, formatos, f } from '../i18n';
import comun from '../i18n/textos/comun';
import textos from '../i18n/textos/hemiciclo';

const lang = idiomaDeUrl(Astro.url.pathname);
const c = comun[lang];
const t = textos[lang];
const fmt = formatos(lang);

const orden = new Map(grupos.map((g) => [g.corto, g.orden]));
const ordenados = [...diputados].sort((a, b) =>
  (orden.get(a.grupoCorto)! - orden.get(b.grupoCorto)!) || fmt.comparar(a.apellidos, b.apellidos));
const gruposOrden = [...grupos].sort((a, b) => a.orden - b.orden).filter((g) => ordenados.some((d) => d.grupoCorto === g.corto));
const { escanos, sectores, rPunto } = disponerPorGrupos(gruposOrden.map((g) => ordenados.filter((d) => d.grupoCorto === g.corto).length));
const W = 1000, H = 590, S = 440, CX = W / 2, CY = 560;
// Radio libre en el centro (fila interior 0.38 menos el radio de un escaño): ahí van la cifra y su texto
const HUECO = ((0.38 - rPunto) * S).toFixed(0);
const px = (r: number, ang: number) => [(CX + r * S * Math.cos(ang)).toFixed(1), (CY - r * S * Math.sin(ang)).toFixed(1)];

// Franja de color de cada grupo por fuera del hemiciclo y su nombre
const RB = 1.065;
const franjas = sectores.map((s, i) => {
  const [x1, y1] = px(RB, s.desde); const [x2, y2] = px(RB, s.hasta);
  return { d: `M${x1} ${y1} A${(RB * S).toFixed(1)} ${(RB * S).toFixed(1)} 0 0 1 ${x2} ${y2}`, color: gruposOrden[i].color };
});
const etiquetas = sectores.map((s, i) => {
  const ang = (s.desde + s.hasta) / 2;
  const estrecho = s.desde - s.hasta < 0.12;
  const r = estrecho && i % 2 === 1 ? 1.2 : 1.12;
  const [x, y] = px(r, ang);
  return { texto: gruposOrden[i].corto, x, y, color: gruposOrden[i].color, ancla: Math.cos(ang) > 0.25 ? 'start' : Math.cos(ang) < -0.25 ? 'end' : 'middle' };
});

// Selector de votaciones: las votaciones clave y, por tema, las más recientes del Pleno (el resto se busca en Votaciones).
// Una votación con varios temas aparece en cada uno. Las que no son clave se descargan al elegirlas.
const POR_TEMA = 12;
const fechaCorta = fmt.fechaCorta;
const recorta = (t: string, n = 95) => (t.length > n ? `${t.slice(0, n - 1).trimEnd()}…` : t);
/** El final del detalle es lo que distingue votaciones del mismo asunto («Enmienda 14», «Punto 2»). */
const finDe = (t: string, n: number) => (t.length > n ? `…${t.slice(-(n - 1)).replace(/^\S*\s/, '')}` : t);
const etiquetaVoto = (v: (typeof votacionesPleno)[number]) =>
  v.automatica
    ? `${fechaCorta(v.fecha)} · ${f(t.numero, { n: v.numeroVotacion })} · ${recorta(v.titulo, 70)}${v.detalle ? ` · ${finDe(v.detalle.replace(/\.$/, ''), 50)}` : ''}`
    : f(t.votacionClave, { texto: `${fechaCorta(v.fecha)} · ${v.tema.replace(/\s*\(\d{2}\/\d{2}\/\d{4}\)\s*$/, '')}` });
const recientes = (xs: typeof votacionesPleno) => [...xs].sort((a, b) => b.fecha.localeCompare(a.fecha) || b.sesion - a.sesion || b.numeroVotacion - a.numeroVotacion);
const gruposVoto = [
  { nombre: t.claveVivienda, votaciones: recientes(votacionesPleno.filter((v) => !v.automatica)) },
  ...TEMAS.map((tema) => ({ nombre: f(t.recientesTema, { tema: c.temas[tema.id] ?? tema.nombre }), votaciones: recientes(votacionesPleno.filter((v) => v.automatica && temasDe(v).includes(tema.id))).slice(0, POR_TEMA) })),
].filter((g) => g.votaciones.length > 0);

const votosCliente = Object.fromEntries(votaciones.map((v) => [v.id, Object.fromEntries(Object.entries(v.votos).map(([c, x]) => [c, x === 'Sí' ? 'S' : x === 'No' ? 'N' : x === 'Abstención' ? 'A' : 'X']))]));
const datos = Object.fromEntries(ordenados.map((d) => [d.codParlamentario, {
  n: d.nombreCompleto, g: d.grupoCorto, p: etiquetaPartido(d, lang), ci: d.circunscripcion,
  pr: d.patrimonio.propiedades, v: d.patrimonio.viviendas, co: d.patrimonio.vehiculos,
  r: d.retribucion.totalMensual, s: slug(d), rv: d.patrimonio.revisar,
}]));
const colores = Object.fromEntries(grupos.map((g) => [g.corto, g.color]));
---
<section class="hemi" id="hemiciclo" aria-labelledby="hemi-h">
  <h2 id="hemi-h" class="sr-only">{c.nav.hemiciclo}</h2>
  <div class="controles">
    <div class="modos segmentado" role="group" aria-label={t.modosAria}>
      <button class="btn" data-modo="grupo" aria-pressed="false">{t.modos.grupo}</button>
      <button class="btn" data-modo="propiedades" aria-pressed="false">{t.modos.propiedades}</button>
      <button class="btn" data-modo="viviendas" aria-pressed="false">{t.modos.viviendas}</button>
    </div>
    {votaciones.length > 0 && (
      <div class="selector">
        <label for="hemi-voto" class="sr-only">{t.verVotacion}</label>
        <select id="hemi-voto">
          <option value="">{t.verVotacionOpcion}</option>
          {gruposVoto.map((g) => (
            <optgroup label={g.nombre}>
              {g.votaciones.map((v) => <option value={`voto:${v.id}`}>{etiquetaVoto(v)}</option>)}
            </optgroup>
          ))}
          <optgroup label={t.masVotaciones}>
            <option value="ir:votaciones">{f(t.buscarEntre, { n: fmt.num(votacionesPleno.length) })}</option>
          </optgroup>
        </select>
      </div>
    )}
  </div>
  <p class="desc small muted" id="hemi-desc" aria-live="polite"></p>

  <div class="lienzo">
    <svg viewBox={`-130 0 ${W + 260} ${H}`} data-hueco={HUECO} data-vb-movil={`12 ${(CY - RB * S - 10).toFixed(0)} ${W - 24} ${(RB * S + 26).toFixed(0)}`} role="img" aria-labelledby="hemi-titulo">
      <title id="hemi-titulo">{t.svgTitulo}</title>
      <g class="franjas" aria-hidden="true">
        {franjas.map((f) => <path d={f.d} stroke={f.color} />)}
      </g>
      <g class="etiquetas" aria-hidden="true">
        {etiquetas.map((e) => <text x={e.x} y={e.y} text-anchor={e.ancla} fill={e.color}>{e.texto}</text>)}
      </g>
      {ordenados.map((d, i) => {
        const e = escanos[i];
        return (
          <a href={enlace(`/diputado/${slug(d)}`, lang)} aria-label={`${d.nombreCompleto}, ${etiquetaPartido(d, lang)}`}>
            <circle cx={(CX + e.x * S).toFixed(1)} cy={(CY - e.y * S).toFixed(1)} r={(e.r * S).toFixed(1)}
              data-cod={d.codParlamentario} data-color={colorGrupo(d.grupoCorto)} style={`fill:${colorGrupo(d.grupoCorto)}`} />
          </a>
        );
      })}
      <text x={CX} y={CY - 52} text-anchor="middle" class="centro" id="hemi-centro">350</text>
      <text x={CX} y={CY - 16} text-anchor="middle" class="centro-sub" id="hemi-centro-sub">{t.cliente.diputados[1]}</text>
    </svg>
    <div class="tip" id="hemi-tip" hidden>
      <button class="cerrar" type="button" aria-label={c.palabras.cerrar}>×</button>
      <div class="tip-cuerpo"></div>
      <a class="btn primario ver" href="#">{t.verFicha}</a>
    </div>
  </div>
  <div class="leyenda small" id="hemi-leyenda" role="group" aria-label={t.leyendaAria}></div>
  <p class="grupos-movil small" aria-label={t.gruposMovilAria}>
    {gruposOrden.map((g) => <span><i style={`background:${g.color}`}></i>{g.corto}</span>)}
  </p>
  <p class="small muted nota">{t.nota}</p>
</section>

<script type="application/json" data-textos="hemiciclo" set:html={JSON.stringify({ ...t.cliente, votos: c.voto, resultados: c.resultado, sinDatos: c.palabras.sinDatos })} />
<script type="application/json" id="hemi-datos" set:html={JSON.stringify({ datos, votos: votosCliente, colores, base: url(''), votaciones: votaciones.map((v) => ({ id: v.id, titulo: v.titulo, tipo: v.tipo, fecha: v.fecha, resultado: v.resultado, totales: v.totales })) })} />

<script>
  import { deslizarParaCerrar } from '../scripts/hoja';
  import { TRAMOS, tramo } from '../lib/hemiciclo';
  import { precargar } from '../scripts/precarga';
  import { textos, f, locale, localeNum, fmtFechaCorta, prefijo } from '../i18n/cliente';
  type Tx = {
    diputados: [string, string]; viviendas: string; propiedades: string; tramoViviendas: string; tramoPropiedades: string; sinDatosAria: string; sd: string;
    descGrupo: string; descViviendas: string; descPropiedades: string; noEraDiputado: string; resultado: string; centroVoto: string; sinEscano: string;
    voto: string; noEraEnVotacion: string; patrimonio: string; vehiculos: string; errorCarga: string;
    /** De comun.ts: voto y resultado oficiales (en castellano) → texto en el idioma de la página; «sin datos». */
    votos: Record<string, string>; resultados: Record<string, string>; sinDatos: string;
  };
  const tx = textos<Tx>('hemiciclo');
  /** Resultado oficial traducido (si no está en la lista, tal cual). */
  const resultadoTx = (r: string) => tx.resultados[r] ?? r;
  type Info = { n: string; g: string; p: string; ci: string; pr: number | null; v: number | null; co: number | null; r: number; s: string; rv: boolean };
  type Voto = 'S' | 'N' | 'A' | 'X';
  const raw = JSON.parse(document.getElementById('hemi-datos')!.textContent!) as {
    datos: Record<string, Info>; votos: Record<string, Record<string, Voto>>; colores: Record<string, string>; base: string;
    votaciones: { id: string; titulo: string; tipo: string; fecha: string; resultado: string; totales: { si: number; no: number; abstencion: number; noVota: number } }[];
  };
  // Variables CSS: así los colores cambian solos al pasar de modo claro a oscuro
  const cVoto: Record<Voto, string> = { S: 'var(--si)', N: 'var(--no)', A: 'var(--abs)', X: 'var(--novota)' };
  const etVoto: Record<Voto, string> = { S: tx.votos['Sí'], N: tx.votos['No'], A: tx.votos['Abstención'], X: tx.votos['No vota'] };
  const escala = [0, 1, 2, 3, 4, 5].map((i) => `var(--int-${i})`);
  const tramos = {
    viviendas: { ...TRAMOS.viviendas, aria: tx.tramoViviendas },
    propiedades: { ...TRAMOS.propiedades, aria: tx.tramoPropiedades },
  };

  const circulos = [...document.querySelectorAll<SVGCircleElement>('.hemi circle[data-cod]')];
  const tip = document.getElementById('hemi-tip')!;
  const tipCuerpo = tip.querySelector('.tip-cuerpo') as HTMLElement;
  const tipVer = tip.querySelector('.ver') as HTMLAnchorElement;
  const leyenda = document.getElementById('hemi-leyenda')!;
  const desc = document.getElementById('hemi-desc')!;
  const centro = document.getElementById('hemi-centro')!;
  const centroSub = document.getElementById('hemi-centro-sub')!;
  const seccion = document.querySelector('.hemi') as HTMLElement;
  const botones = [...document.querySelectorAll<HTMLButtonElement>('.hemi [data-modo]')];
  const selVoto = document.getElementById('hemi-voto') as HTMLSelectElement | null;
  const eur = new Intl.NumberFormat(localeNum(), { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });
  const num = new Intl.NumberFormat(localeNum());
  const tactil = () => matchMedia('(hover: none), (max-width: 640px)').matches;
  let modo = 'grupo';

  // Cada elemento de la leyenda es un botón: al pulsarlo se resaltan solo los escaños de ese color
  const item = (color: string, texto: string, clave: string, borde = false) =>
    `<button type="button" class="pill filtro" data-f="${clave}" aria-pressed="false"><span class="dot${borde ? ' vacio' : ''}" style="background:${color}"></span>${texto}</button>`;
  /** Escala ordenada de menos a más: una barra de tramos con su número debajo */
  const escalaHtml = (etiquetas: readonly string[], aria: string, cuenta: number[], sinDatos: number) =>
    `<div class="escala">${escala.map((c, i) => `<button type="button" class="tramo filtro" data-f="${i}" aria-pressed="false" aria-label="${f(aria, { tramo: etiquetas[i], n: cuenta[i] })}"><i style="background:${c}"></i><span>${etiquetas[i]}</span></button>`).join('')}` +
    (sinDatos ? `<button type="button" class="tramo filtro sd" data-f="-1" aria-pressed="false" aria-label="${f(tx.sinDatosAria, { n: sinDatos })}"><i></i><span>${tx.sd}</span></button>` : '') + '</div>';
  const rellenar = (c: SVGCircleElement, color: string | null) => { c.style.fill = color ?? 'transparent'; c.classList.toggle('vacio', color === null); };

  function pintar(m: string) {
    modo = m;
    seccion.dataset.modo = m.startsWith('voto:') ? 'voto' : m;
    botones.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.modo === m)));
    if (selVoto) selVoto.value = m.startsWith('voto:') ? m : '';
    try { localStorage.setItem('hemi-modo', m); } catch {}
    // La votación elegida queda en la dirección (?votacion=…) para poder compartirla
    const dir = new URL(location.href);
    if (m.startsWith('voto:')) dir.searchParams.set('votacion', m.slice(5)); else dir.searchParams.delete('votacion');
    if (dir.href !== location.href) history.replaceState(history.state, '', dir);
    if (m === 'grupo') {
      circulos.forEach((c) => { rellenar(c, c.dataset.color!); c.dataset.k = raw.datos[c.dataset.cod!].g; });
      const cuenta: Record<string, number> = {};
      Object.values(raw.datos).forEach((d) => (cuenta[d.g] = (cuenta[d.g] ?? 0) + 1));
      leyenda.innerHTML = Object.entries(raw.colores).map(([g, c]) => item(c, `${g} · ${cuenta[g] ?? 0}`, g)).join(' ');
      desc.textContent = tx.descGrupo;
      centro.textContent = '350'; centroSub.textContent = tx.diputados[1];
    } else if (m === 'viviendas' || m === 'propiedades') {
      const t = tramos[m]; const campo = m === 'viviendas' ? 'v' : 'pr';
      const cuenta = escala.map(() => 0); let sinDatos = 0;
      circulos.forEach((c) => {
        const i = tramo(raw.datos[c.dataset.cod!][campo], t.cortes);
        rellenar(c, i < 0 ? null : escala[i]); c.dataset.k = String(i);
        if (i < 0) sinDatos++; else cuenta[i]++;
      });
      leyenda.innerHTML = escalaHtml(t.etiquetas, t.aria, cuenta, sinDatos);
      const total = Object.values(raw.datos).reduce((a, d) => a + (d[campo] ?? 0), 0);
      desc.textContent = m === 'viviendas'
        ? tx.descViviendas
        : tx.descPropiedades;
      centro.textContent = num.format(total); centroSub.textContent = m === 'viviendas' ? tx.viviendas : tx.propiedades;
    } else {
      const id = m.slice(5); const vot = raw.votos[id]; const info = raw.votaciones.find((v) => v.id === id)!;
      circulos.forEach((c) => { const x = vot[c.dataset.cod!]; rellenar(c, x ? cVoto[x] : null); c.dataset.k = x ?? '-'; });
      const t = info.totales;
      leyenda.innerHTML = [item(cVoto.S, `${etVoto.S} · ${t.si}`, 'S'), item(cVoto.N, `${etVoto.N} · ${t.no}`, 'N'), item(cVoto.A, `${etVoto.A} · ${t.abstencion}`, 'A'), item(cVoto.X, `${etVoto.X} · ${t.noVota}`, 'X'), item('transparent', tx.noEraDiputado, '-', true)].join(' ');
      desc.innerHTML = `<span>${info.tipo} ${fmtFechaCorta(info.fecha)}</span><br><strong class="texto">${info.titulo}</strong> ${f(tx.resultado, { r: resultadoTx(info.resultado) })}`;
      centro.textContent = `${t.si}–${t.no}`; centroSub.textContent = f(tx.centroVoto, { r: resultadoTx(info.resultado).toLowerCase() });
    }
    centroBase = [centro.textContent!, centroSub.textContent!];
    filtrar(null);
    if (!tip.hidden && activo) mostrar(activo);
  }

  // Filtro de la leyenda: resalta los escaños de un color y la cifra central cuenta cuántos son
  let filtro: string | null = null;
  let centroBase: [string, string] = ['', ''];
  function filtrar(f: string | null) {
    filtro = f;
    let n = 0;
    circulos.forEach((c) => { const fuera = f !== null && c.dataset.k !== f; c.classList.toggle('atenuado', fuera); if (f !== null && !fuera) n++; });
    leyenda.classList.toggle('filtrando', f !== null);
    leyenda.querySelectorAll<HTMLButtonElement>('.filtro').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.f === f)));
    if (f === null) { centro.textContent = centroBase[0]; centroSub.textContent = centroBase[1]; }
    else {
      centro.textContent = num.format(n);
      centroSub.textContent = seccion.dataset.modo === 'grupo' ? f : seccion.dataset.modo === 'voto' ? (f === '-' ? tx.sinEscano : etVoto[f as Voto].toLowerCase()) : n === 1 ? tx.diputados[0] : tx.diputados[1];
    }
    ajustarCentro();
  }
  leyenda.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>('.filtro');
    if (b) filtrar(filtro === b.dataset.f ? null : b.dataset.f!);
  });

  /** La cifra y su texto no deben tocar los escaños: si no caben en el hueco central, se reduce la letra. */
  function ajustarCentro() {
    const radio = Number((document.querySelector('.hemi svg') as SVGSVGElement).dataset.hueco);
    ([[centro, 52], [centroSub, 16]] as const).forEach(([el, dy]) => {
      el.style.fontSize = '';
      let f = parseFloat(getComputedStyle(el).fontSize);
      for (let k = 0; k < 4; k++) {
        const alto = dy + 0.74 * f;
        const cabe = 2 * Math.sqrt(Math.max(0, radio * radio - alto * alto)) - 24;
        const largo = (el as unknown as SVGTextElement).getComputedTextLength();
        if (largo <= cabe) break;
        f = Math.floor(f * Math.max(0.5, cabe / largo) * 10) / 10;
        el.style.fontSize = `${f}px`;
      }
    });
  }

  let activo: SVGCircleElement | null = null;
  function mostrar(c: SVGCircleElement, x?: number, y?: number) {
    activo = c;
    const d = raw.datos[c.dataset.cod!];
    const lineas = [
      `<strong class="nombre">${d.n}</strong>`,
      `<span class="muted"><span class="dot" style="background:${raw.colores[d.g]}"></span> ${d.p} · ${d.ci}</span>`,
    ];
    if (modo.startsWith('voto:')) { const v = raw.votos[modo.slice(5)][c.dataset.cod!]; lineas.push(v ? f(tx.voto, { voto: `<strong style="color:${cVoto[v]}">${etVoto[v]}</strong>` }) : `<span class="muted">${tx.noEraEnVotacion}</span>`); }
    lineas.push(f(tx.patrimonio, { pr: d.pr ?? tx.sinDatos, v: d.v ?? tx.sinDatos }));
    lineas.push(f(tx.vehiculos, { co: d.co ?? '—', r: eur.format(d.r) }));
    tipCuerpo.innerHTML = lineas.join('<br>');
    tipVer.href = `${prefijo()}/diputado/${d.s}`;
    tip.hidden = false;
    circulos.forEach((o) => o.classList.toggle('activo', o === c));
    // En el móvil, la ficha completa se pide ya: así «Ver ficha completa» abre al momento
    if (tactil()) { tip.classList.add('hoja'); tip.style.left = ''; tip.style.top = ''; precargar(tipVer.href); return; }
    tip.classList.remove('hoja');
    const caja = tip.parentElement!.getBoundingClientRect();
    const b = c.getBoundingClientRect();
    const px = x ?? b.left + b.width / 2, py = y ?? b.top;
    const ancho = tip.offsetWidth, alto = tip.offsetHeight;
    tip.style.left = `${Math.min(Math.max(0, px - caja.left + 14), caja.width - ancho)}px`;
    tip.style.top = `${Math.max(0, py - caja.top - alto - 14)}px`;
  }
  function ocultar() { tip.hidden = true; activo = null; circulos.forEach((o) => o.classList.remove('activo')); }

  circulos.forEach((c) => {
    c.addEventListener('pointerenter', (e) => { if (!tactil()) mostrar(c, e.clientX, e.clientY); });
    c.addEventListener('pointermove', (e) => { if (!tactil()) mostrar(c, e.clientX, e.clientY); });
    c.addEventListener('focus', () => mostrar(c));
  });
  // En pantallas táctiles, el toque abre la ficha rápida; el botón lleva a la ficha completa
  document.querySelectorAll<SVGAElement>('.hemi svg a').forEach((a) => {
    a.addEventListener('click', (e) => { if (tactil()) { e.preventDefault(); mostrar(a.querySelector('circle')!); } });
  });
  document.querySelector('.hemi svg')!.addEventListener('pointerleave', () => { if (!tactil()) ocultar(); });
  tip.querySelector('.cerrar')!.addEventListener('click', ocultar);
  deslizarParaCerrar(tip, { cerrar: ocultar, medio: '(pointer: coarse)' });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') ocultar(); });
  // En pantallas estrechas no hay etiquetas: se recorta el margen para que el hemiciclo se vea más grande
  const svg = document.querySelector('.hemi svg') as SVGSVGElement;
  const vbCompleto = svg.getAttribute('viewBox')!;
  const estrecho = matchMedia('(max-width: 640px)');
  const ajustarVista = () => svg.setAttribute('viewBox', estrecho.matches ? svg.dataset.vbMovil! : vbCompleto);
  ajustarVista(); estrecho.addEventListener('change', () => { ajustarVista(); ajustarCentro(); });
  // Un toque cerca de un escaño (aunque no justo encima) también lo selecciona
  svg.addEventListener('click', (e) => {
    if (!tactil() || (e.target as Element).closest('a')) return;
    let mejor: SVGCircleElement | null = null, dist = 28;
    circulos.forEach((c) => { const b = c.getBoundingClientRect(); const d = Math.hypot(b.left + b.width / 2 - e.clientX, b.top + b.height / 2 - e.clientY); if (d < dist) { dist = d; mejor = c; } });
    if (mejor) mostrar(mejor);
  });
  // El botón se marca al momento y el repintado de los 350 escaños va en el siguiente fotograma, para que el toque responda ya
  botones.forEach((b) => b.addEventListener('click', () => {
    botones.forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
    requestAnimationFrame(() => setTimeout(() => pintar(b.dataset.modo!), 0));
  }));
  /** Pinta una votación; si no es clave, primero descarga su voto escaño a escaño. */
  async function verVotacion(m: string) {
    const id = m.slice(5);
    if (!raw.votos[id]) {
      seccion.setAttribute('aria-busy', 'true');
      const ok = await cargarVotacion(id);
      seccion.removeAttribute('aria-busy');
      if (!ok) { desc.textContent = tx.errorCarga; return; }
    }
    pintar(m);
  }
  selVoto?.addEventListener('change', () => {
    if (selVoto.value === 'ir:votaciones') { location.href = `${prefijo()}/votaciones`; return; }
    if (selVoto.value) verVotacion(selVoto.value);
  });
  const validos = [...botones.map((b) => b.dataset.modo!), ...(selVoto ? [...selVoto.options].map((o) => o.value).filter((x) => x.startsWith('voto:')) : [])];
  let inicial = 'propiedades';
  try { const g = localStorage.getItem('hemi-modo'); if (g && validos.includes(g)) inicial = g; } catch {}

  /** Votación pedida desde la página de votaciones (?votacion=id). Las que no son clave se descargan al pedirlas. */
  async function cargarVotacion(id: string): Promise<boolean> {
    try {
      const r = await fetch(`${raw.base}/datos/votos/${encodeURIComponent(id)}.json`);
      if (!r.ok) return false;
      const v = await r.json() as (typeof raw.votaciones)[number] & { votos: Record<string, Voto> };
      raw.votos[id] = v.votos;
      raw.votaciones.push(v);
      if (selVoto && ![...selVoto.options].some((o) => o.value === `voto:${id}`)) {
        const corto = v.titulo.length > 70 ? `${v.titulo.slice(0, 68).trimEnd()}…` : v.titulo;
        selVoto.add(new Option(`${fmtFechaCorta(v.fecha)} · ${corto}`, `voto:${id}`), 1);
      }
      return true;
    } catch { return false; }
  }
  const pedida = new URLSearchParams(location.search).get('votacion');
  const objetivo = pedida ? `voto:${pedida}` : inicial;
  if (!objetivo.startsWith('voto:') || raw.votos[objetivo.slice(5)]) pintar(objetivo);
  else { pintar('propiedades'); verVotacion(objetivo); }
</script>

