---
/**
 * Botón redondo con el icono de compartir. Abre la ventana emergente de compartir (DialogoCompartir),
 * que tiene que estar una vez en la página y define el icono.
 * Para no repetir datos en listas largas, el botón de un diputado solo lleva su slug, su nombre y el texto;
 * las rutas de las imágenes y el enlace se montan en el navegador.
 */
import type { Diputado } from '../lib/types';
import { slug, url } from '../lib/data';
import { compartir, rutaTarjeta } from '../lib/tarjetas';
import { idiomaDeUrl, f } from '../i18n';
import textosCompartir from '../i18n/textos/compartir';
/** Datos de una tarjeta cualquiera (provincia, estadística…): rutas de las imágenes y enlace ya con el idioma. */
export interface TarjetaCompartir { historia: string; horizontal: string; nombre: string; enlace: string; texto: string; titulo: string; etiqueta: string }
/** Un diputado (`d`), el resumen de todo el Congreso (`resumen`, para la portada) u otra tarjeta (`tarjeta`). */
interface Props { d?: Diputado; resumen?: boolean; tarjeta?: TarjetaCompartir; class?: string }
const { d, resumen = false, tarjeta, class: clase } = Astro.props;
const lang = idiomaDeUrl(Astro.url.pathname);
const t = textosCompartir[lang].ui;
const etiqueta = tarjeta?.etiqueta ?? (d ? f(t.compartirFicha, { nombre: d.nombreCompleto }) : t.compartirWeb);
// El resumen lleva sus datos completos (es un solo botón); el de un diputado, solo el slug
// (las imágenes y el enlace del idioma de la página los monta DialogoCompartir en el navegador)
const datosResumen = resumen ? {
  'data-historia': url(rutaTarjeta.resumen('historia', lang)), 'data-horizontal': url(rutaTarjeta.resumen('horizontal', lang)),
  'data-nombre': 'congreso-abierto', 'data-enlace': compartir.resumen(lang).enlace, 'data-ct': compartir.resumen(lang).texto, 'data-titulo': t.tituloWeb,
} : tarjeta ? {
  'data-historia': url(tarjeta.historia), 'data-horizontal': url(tarjeta.horizontal),
  'data-nombre': tarjeta.nombre, 'data-enlace': tarjeta.enlace, 'data-ct': tarjeta.texto, 'data-titulo': tarjeta.titulo,
} : {};
---
<button class:list={['boton-compartir', clase]} type="button" data-compartir={d ? slug(d) : tarjeta ? tarjeta.nombre : 'resumen'} data-cn={d?.nombreCompleto} data-ct={d ? compartir.diputado(d, lang).texto : undefined} {...datosResumen} aria-label={etiqueta} title={etiqueta} aria-haspopup="dialog"><svg width="19" height="19" aria-hidden="true"><use href="#i-compartir" /></svg></button>

<style>
  .boton-compartir {
    display: inline-grid; place-items: center; width: 40px; height: 40px; padding: 0; border-radius: 50%;
    border: 1px solid var(--border); background: var(--surface); color: var(--text); cursor: pointer;
    transition: border-color .15s, color .15s, background .15s, transform .15s;
  }
  .boton-compartir:hover { border-color: var(--accent); color: var(--accent-text); background: var(--accent-soft); }
  .boton-compartir:active { transform: scale(.94); }
  .boton-compartir:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
</style>
