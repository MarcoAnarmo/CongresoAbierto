---
/**
 * Botón redondo con el icono de compartir. Abre la ventana emergente de compartir (DialogoCompartir),
 * que tiene que estar una vez en la página y define el icono.
 * Para no repetir datos en listas largas, el botón de un diputado solo lleva su slug, su nombre y el texto;
 * las rutas de las imágenes y el enlace se montan en el navegador.
 */
import type { Diputado } from '../lib/types';
import { slug, url } from '../lib/data';
import { compartir, rutaTarjeta } from '../lib/tarjetas';
/** Un diputado (`d`) o el resumen de todo el Congreso (`resumen`, para la portada). */
interface Props { d?: Diputado; resumen?: boolean; class?: string }
const { d, resumen = false, class: clase } = Astro.props;
const etiqueta = d ? `Compartir la ficha de ${d.nombreCompleto}` : 'Compartir Congreso Abierto';
// El resumen lleva sus datos completos (es un solo botón); el de un diputado, solo el slug
const datosResumen = resumen ? {
  'data-historia': url(rutaTarjeta.resumen('historia')), 'data-horizontal': url(rutaTarjeta.resumen('horizontal')),
  'data-nombre': 'congreso-abierto', 'data-enlace': compartir.resumen().enlace, 'data-ct': compartir.resumen().texto, 'data-titulo': 'Comparte Congreso Abierto',
} : {};
---
<button class:list={['boton-compartir', clase]} type="button" data-compartir={d ? slug(d) : 'resumen'} data-cn={d?.nombreCompleto} data-ct={d ? compartir.diputado(d).texto : undefined} {...datosResumen} aria-label={etiqueta} title={etiqueta} aria-haspopup="dialog"><svg width="19" height="19" aria-hidden="true"><use href="#i-compartir" /></svg></button>

<style>
  .boton-compartir {
    display: inline-grid; place-items: center; width: 40px; height: 40px; padding: 0; border-radius: 50%;
    border: 1px solid var(--border); background: var(--surface); color: var(--text); cursor: pointer;
    transition: border-color .15s, color .15s, background .15s, transform .15s;
  }
  .boton-compartir:hover { border-color: var(--accent); color: var(--accent-text); background: var(--accent-soft); }
  .boton-compartir:active { transform: scale(.94); }
  .boton-compartir:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
</style>
