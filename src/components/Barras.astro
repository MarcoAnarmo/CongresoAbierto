---
/**
 * Barras horizontales para estadísticas: etiqueta arriba, barra y cifra. HTML y CSS, sin librerías ni JavaScript,
 * para que se lea bien en el móvil, la encuentren los buscadores y la lean los lectores de pantalla.
 * El ancho de cada barra es su valor respecto al máximo (o a `max`).
 */
export interface Barra { etiqueta: string; valor: number; texto: string; color?: string; href?: string; punto?: string }
interface Props { items: Barra[]; max?: number; etiqueta?: string }
const { items, max = Math.max(1, ...items.map((x) => x.valor)), etiqueta } = Astro.props;
const ancho = (v: number) => `${Math.max(v > 0 ? 1.5 : 0, Math.round((1000 * v) / max) / 10)}%`;
---
<ul class="barras" role="list" aria-label={etiqueta}>
  {items.map((x) => (
    <li>
      <span class="b-cab">
        {x.href
          ? <a href={x.href} class="b-et">{x.punto && <span class="dot" style={`background:${x.punto}`}></span>}{x.etiqueta}</a>
          : <span class="b-et">{x.punto && <span class="dot" style={`background:${x.punto}`}></span>}{x.etiqueta}</span>}
        <span class="b-n">{x.texto}</span>
      </span>
      <span class="b-pista" aria-hidden="true"><span class="b-barra" style={`width:${ancho(x.valor)};${x.color ? `background:${x.color}` : ''}`}></span></span>
    </li>
  ))}
</ul>

<style>
  .barras { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .b-cab { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; font-size: .92rem; line-height: 1.3; }
  .b-et { min-width: 0; overflow-wrap: anywhere; }
  .b-et .dot { width: 9px; height: 9px; margin: -2px 6px 0 0; }
  .b-n { flex: none; font-weight: 700; font-variant-numeric: tabular-nums; }
  .b-pista { display: block; height: 10px; margin-top: 4px; border-radius: 999px; background: var(--chip); overflow: hidden; }
  .b-barra { display: block; height: 100%; border-radius: 999px; background: var(--accent); }
</style>
