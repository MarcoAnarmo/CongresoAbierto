---
import '../styles/global.css';
import { url, REPO, enlaceSugerencia, enlaceError, enlaceHojaDeRuta } from '../lib/data';
import type { NombreIcono } from '../lib/iconos';
import Icono from '../components/Icono.astro';
import { IDIOMAS, NOMBRE_IDIOMA, LOCALE, OG_LOCALE, DEFECTO, idiomaDeUrl, enlace, sinIdioma, prefijo, f } from '../i18n';
import comun from '../i18n/textos/comun';

interface Props { title: string; description?: string; /** Ruta de la tarjeta horizontal para la vista previa en redes (Open Graph), sin idioma. */ imagen?: string; }
const lang = idiomaDeUrl(Astro.url.pathname);
const t = comun[lang];
const { title, description = t.marca.descripcion, imagen: imagenProp } = Astro.props;
// Ruta de la página sin el idioma: /ca/diputados → /diputados
const ruta = sinIdioma(Astro.url.pathname);
const u = (p: string) => enlace(p, lang);
// Tarjeta para la vista previa de enlaces: la que pase la página o, si no, la de su sección (en el idioma de la página)
const seccion = ruta.split('/').filter(Boolean)[0] ?? '';
const imagenRuta = imagenProp ?? (['diputados', 'votaciones', 'metodologia', 'colabora', 'tarjetas'].includes(seccion) ? `/tarjetas/horizontal/pagina/${seccion}.png` : '/tarjetas/horizontal/resumen.png');
const imagen = enlace(imagenRuta, lang);
const tituloCompleto = title === 'Congreso Abierto' ? title : `${title} · Congreso Abierto`;
const absoluta = (p: string) => new URL(p, Astro.site).href;
const path = ruta.replace(/\/$/, '') || '/';
const nav: { href: string; label: string; corto?: string; icono: NombreIcono }[] = [
  { href: '/', label: t.nav.hemiciclo, icono: 'hemiciclo' },
  { href: '/diputados', label: t.nav.diputados, icono: 'fichas' },
  { href: '/votaciones', label: t.nav.votaciones, corto: t.nav.votacionesCorto, icono: 'votaciones' },
  { href: '/metodologia', label: t.nav.metodologia, corto: t.nav.metodologiaCorto, icono: 'metodo' },
  { href: '/colabora', label: t.nav.colabora, icono: 'colabora' },
];
const activo = (href: string) => (href === '/' ? path === '/' || path === '' : path.startsWith(href) || (href === '/diputados' && path.startsWith('/diputado/')));
// Misma página en cada idioma (hreflang y selector)
const versiones = IDIOMAS.map((l) => ({ lang: l, href: enlace(ruta, l) }));
const es404 = Astro.url.pathname.includes('404');
const fuentes = f(t.pie.fuentes, {
  congreso: `<a href="https://www.congreso.es/es/datos-abiertos">${t.pie.congreso}</a>`,
  boe: '<a href="https://www.boe.es">BOE</a>',
});
---
<!doctype html>
<html lang={lang} data-locale={LOCALE[lang]} data-prefijo={`${url("")}${prefijo(lang)}`} data-base={url("")}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>
      // Aplica el tema guardado antes de pintar la página (claro por defecto)
      (function () {
        var t = null, raiz = document.documentElement;
        // Con JavaScript, la ficha de cada diputado se ve como resumen en cajitas (salvo que se haya elegido verla entera)
        raiz.classList.add('js');
        try { if (localStorage.getItem('fichaCompleta') === '1') raiz.classList.add('ficha-completa'); } catch (e) {}
        try { t = localStorage.getItem('tema'); } catch (e) {}
        if (t === 'oscuro') {
          document.documentElement.setAttribute('data-theme', 'dark');
          document.querySelector('meta[name="theme-color"]').setAttribute('content', '#2a2e35');
        }
      })();
    </script>
    {!es404 && (
      <script is:inline define:vars={{ actual: lang, rutas: Object.fromEntries(versiones.map((v) => [v.lang, v.href])) }}>
        // Idioma automático: la primera vez se abre la web en el idioma del navegador o del móvil (castellano, català/valencià,
        // euskara, galego o inglés; cualquier otro, inglés). Si la persona elige otro idioma en el selector, se respeta siempre.
        (function () {
          var elegido = null;
          try { elegido = localStorage.getItem('idioma'); } catch (e) {}
          if (!elegido) {
            if (/bot|crawl|spider|slurp|facebookexternalhit|whatsapp|telegram|preview|lighthouse/i.test(navigator.userAgent)) return;
            var prefs = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || 'es'];
            for (var i = 0; i < prefs.length && !elegido; i++) {
              var c = String(prefs[i]).toLowerCase().split('-')[0];
              if (c === 'va') c = 'ca';
              if (rutas[c]) elegido = c;
            }
            elegido = elegido || 'en';
          }
          if (elegido !== actual && rutas[elegido]) location.replace(rutas[elegido] + location.search + location.hash);
        })();
      </script>
    )}
    <link rel="canonical" href={absoluta(enlace(ruta, lang))} />
    {versiones.map((v) => <link rel="alternate" hreflang={v.lang} href={absoluta(v.href)} />)}
    <link rel="alternate" hreflang="x-default" href={absoluta(enlace(ruta, DEFECTO))} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Congreso Abierto" />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    {IDIOMAS.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={OG_LOCALE[l]} />)}
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={absoluta(enlace(ruta, lang))} />
    <meta property="og:image" content={`${absoluta(imagen)}?v=2`} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={f(t.marca.ogAlt, { titulo: title })} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg?v=5')} />
    <link rel="icon" type="image/png" sizes="32x32" href={url('/favicon-32.png?v=5')} />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png?v=5')} />
  </head>
  <body>
    <a class="saltar" href="#contenido">{t.marca.saltar}</a>
    <header class="site">
      <div class="wrap bar">
        <a class="brand" href={u('/')} aria-label={t.marca.inicio}>
          <svg class="logo" viewBox="1 15 62 30" fill="none" stroke="#16181d" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" width="74" height="36" aria-hidden="true">
            <g transform="translate(32 46) scale(.94) translate(-32 -46)" stroke-width="1.1">
              <circle cx="20.9" cy="41.4" r="2.2" fill="#ffd36e"/>
              <circle cx="27.4" cy="34.9" r="2.2" fill="#ffd36e"/>
              <circle cx="36.6" cy="34.9" r="2.2" fill="#ffd36e"/>
              <circle cx="43.1" cy="41.4" r="2.2" fill="#ffd36e"/>
              <circle cx="14.6" cy="41.5" r="2.2" fill="#f7a04b"/>
              <circle cx="16.5" cy="36.8" r="2.2" fill="#f7a04b"/>
              <circle cx="22.8" cy="30.5" r="2.2" fill="#f7a04b"/>
              <circle cx="27.5" cy="28.6" r="2.2" fill="#f7a04b"/>
              <circle cx="36.5" cy="28.6" r="2.2" fill="#f7a04b"/>
              <circle cx="41.2" cy="30.5" r="2.2" fill="#f7a04b"/>
              <circle cx="47.5" cy="36.8" r="2.2" fill="#f7a04b"/>
              <circle cx="49.4" cy="41.5" r="2.2" fill="#f7a04b"/>
              <circle cx="8.4" cy="41.5" r="2.2" fill="#f7a04b"/>
              <circle cx="9.8" cy="36.8" r="2.2" fill="#f7a04b"/>
              <circle cx="12.2" cy="32.5" r="2.2" fill="#f7a04b"/>
              <circle cx="18.5" cy="26.2" r="2.2" fill="#f7a04b"/>
              <circle cx="22.8" cy="23.8" r="2.2" fill="#f7a04b"/>
              <circle cx="27.5" cy="22.4" r="2.2" fill="#f7a04b"/>
              <circle cx="36.5" cy="22.4" r="2.2" fill="#f7a04b"/>
              <circle cx="41.2" cy="23.8" r="2.2" fill="#f7a04b"/>
              <circle cx="45.5" cy="26.2" r="2.2" fill="#f7a04b"/>
              <circle cx="51.8" cy="32.5" r="2.2" fill="#f7a04b"/>
              <circle cx="54.2" cy="36.8" r="2.2" fill="#f7a04b"/>
              <circle cx="55.6" cy="41.5" r="2.2" fill="#f7a04b"/>
              <circle cx="2.3" cy="41.5" r="2.2" fill="#e2852f"/>
              <circle cx="3.4" cy="36.8" r="2.2" fill="#e2852f"/>
              <circle cx="5.3" cy="32.3" r="2.2" fill="#e2852f"/>
              <circle cx="7.9" cy="28.2" r="2.2" fill="#e2852f"/>
              <circle cx="14.2" cy="21.9" r="2.2" fill="#e2852f"/>
              <circle cx="18.3" cy="19.3" r="2.2" fill="#e2852f"/>
              <circle cx="22.8" cy="17.4" r="2.2" fill="#e2852f"/>
              <circle cx="27.5" cy="16.3" r="2.2" fill="#e2852f"/>
              <circle cx="36.5" cy="16.3" r="2.2" fill="#e2852f"/>
              <circle cx="41.2" cy="17.4" r="2.2" fill="#e2852f"/>
              <circle cx="45.7" cy="19.3" r="2.2" fill="#e2852f"/>
              <circle cx="49.8" cy="21.9" r="2.2" fill="#e2852f"/>
              <circle cx="56.1" cy="28.2" r="2.2" fill="#e2852f"/>
              <circle cx="58.7" cy="32.3" r="2.2" fill="#e2852f"/>
              <circle cx="60.6" cy="36.8" r="2.2" fill="#e2852f"/>
              <circle cx="61.7" cy="41.5" r="2.2" fill="#e2852f"/>
            </g>
          </svg>
          <span>Congreso Abierto</span>
        </a>
        <nav aria-label={t.marca.navPrincipal}>
          {nav.map((n) => <a class="subraya" href={u(n.href)} aria-current={activo(n.href) ? 'page' : undefined}>{n.corto ? <><span class="l-largo">{n.label}</span><span class="l-corto" aria-hidden="true">{n.corto}</span></> : n.label}</a>)}
        </nav>
        <details class="idioma" id="selector-idioma">
          <summary class="idioma-boton" aria-label={t.idioma.boton} title={t.idioma.titulo}>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z" /></svg>
            <span>{lang.toUpperCase()}</span>
          </summary>
          <ul class="idioma-menu" role="list">
            {versiones.map((v) => <li><a href={v.href} hreflang={v.lang} lang={v.lang} data-idioma={v.lang} aria-current={v.lang === lang ? 'true' : undefined}>{NOMBRE_IDIOMA[v.lang]}</a></li>)}
          </ul>
        </details>
        <button class="tema" type="button" id="boton-tema" aria-pressed="false" aria-label={t.tema.oscuro} title={t.tema.oscuro} data-oscuro={t.tema.oscuro} data-claro={t.tema.claro}>
          <svg class="i-luna" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" /></svg>
          <svg class="i-sol" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4.2" /><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6" /></svg>
        </button>
      </div>
    </header>
    <!-- Móvil: el menú va abajo, fijo y al alcance del pulgar -->
    <nav class="nav-movil" aria-label={t.marca.navPrincipal}>
      {nav.map((n) => <a href={u(n.href)} aria-current={activo(n.href) ? 'page' : undefined}><span class="nm-ico"><Icono n={n.icono} tam={22} /></span><span>{n.corto ?? n.label}</span></a>)}
    </nav>
    <script is:inline>
      (function () {
        var b = document.getElementById('boton-tema'), raiz = document.documentElement, meta = document.querySelector('meta[name="theme-color"]');
        function pintar() {
          var oscuro = raiz.getAttribute('data-theme') === 'dark', txt = oscuro ? b.dataset.claro : b.dataset.oscuro;
          b.setAttribute('aria-pressed', String(oscuro)); b.setAttribute('aria-label', txt); b.title = txt;
          meta.setAttribute('content', oscuro ? '#2a2e35' : '#ffffff');
        }
        b.addEventListener('click', function () {
          var oscuro = raiz.getAttribute('data-theme') !== 'dark';
          if (oscuro) raiz.setAttribute('data-theme', 'dark'); else raiz.removeAttribute('data-theme');
          try { localStorage.setItem('tema', oscuro ? 'oscuro' : 'claro'); } catch (e) {}
          pintar();
        });
        pintar();
      })();
    </script>
    <script is:inline>
      (function () {
        var h = document.querySelector('header.site');
        function fijar() { document.documentElement.style.setProperty('--alto-cabecera', h.offsetHeight + 'px'); }
        fijar(); addEventListener('resize', fijar);
        var a = h.querySelector('nav a[aria-current="page"]'), n = a && a.parentElement;
        if (a && n.scrollWidth > n.clientWidth) n.scrollLeft = a.offsetLeft + a.offsetWidth - n.clientWidth + 16;
      })();
    </script>
    <div class="desplazable" id="desplazable" tabindex="-1">
    <main class="wrap" id="contenido">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap pie-rejilla">
        <div class="pie-marca">
          <a class="pie-logo" href={u('/')} aria-label={t.marca.inicio}>
            <span class="pie-placa"><img src={url('/logo.svg')} alt="" width="62" height="30" /></span>
            <span>Congreso Abierto</span>
          </a>
          <p class="pie-lema">{t.marca.lema}</p>
          <p class="pie-sub">{t.marca.subtitulo}</p>
        </div>
        <div class="pie-col">
          <h2 class="pie-t">{t.pie.explora}</h2>
          <ul>{nav.map((n) => <li><a href={u(n.href)}>{n.label}</a></li>)}</ul>
        </div>
        <div class="pie-col">
          <h2 class="pie-t">{t.pie.participa}</h2>
          <ul>
            <li><a href={u('/tarjetas')}>{t.pie.tarjetas}</a></li>
            <li><a href={u('/colabora')}>{t.pie.colabora}</a></li>
            <li><a href={enlaceHojaDeRuta} rel="noopener">{t.pie.hojaDeRuta}</a></li>
            <li><a class="con-icono" href={REPO} rel="noopener"><svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m8 7-5 5 5 5M16 7l5 5-5 5" /></svg>{t.pie.codigo}</a></li>
            <li><a href={enlaceSugerencia} rel="noopener">{t.pie.sugerencia}</a></li>
            <li><a href={enlaceError()} rel="noopener">{t.pie.error}</a></li>
            <li><a href="mailto:ayuda@congresoabierto.org">ayuda@congresoabierto.org</a></li>
          </ul>
        </div>
      </div>
      <div class="wrap pie-base">
        <p set:html={fuentes} />
        <p class="pie-idiomas"><span>{t.pie.idiomas}:</span> {versiones.map((v) => <a href={v.href} hreflang={v.lang} lang={v.lang} data-idioma={v.lang} aria-current={v.lang === lang ? 'true' : undefined}>{NOMBRE_IDIOMA[v.lang]}</a>)}</p>
        {t.idioma.datosEnCastellano && <p>{t.idioma.datosEnCastellano}</p>}
        <p>{t.pie.independiente}</p>
      </div>
    </footer>
    </div>
    <script is:inline>
      // Selector de idioma: recuerda la elección y conserva la búsqueda o la votación abierta (?…#…)
      (function () {
        document.querySelectorAll('a[data-idioma]').forEach(function (a) {
          a.addEventListener('click', function () {
            try { localStorage.setItem('idioma', a.dataset.idioma); } catch (e) {}
            a.href = a.getAttribute('href') + location.search + location.hash;
          });
        });
        var d = document.getElementById('selector-idioma');
        document.addEventListener('click', function (e) { if (d.open && !d.contains(e.target)) d.open = false; });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && d.open) { d.open = false; d.querySelector('summary').focus(); } });
      })();
    </script>
    <script is:inline>
      (function () { var d = document.getElementById('desplazable'); if (matchMedia('(min-width: 721px)').matches && !location.hash) d.focus({ preventScroll: true }); })();
    </script>
  </body>
</html>

<style>
  .saltar { position: absolute; left: -9999px; top: 8px; z-index: 50; background: var(--text); color: var(--bg); padding: 8px 12px; border-radius: 8px; }
  .saltar:focus { left: 8px; }
  header.site { border-bottom: 1px solid var(--border); background: var(--surface); position: sticky; top: 0; z-index: 20; padding-top: env(safe-area-inset-top); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 8px 16px; min-height: 56px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; font-weight: 800; font-size: 1.05rem; text-decoration: none; letter-spacing: -0.02em; white-space: nowrap; min-height: 44px; }
  nav { display: flex; gap: 2px; margin-left: auto; }
  .tema { display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; flex: none; border: 1px solid var(--border); border-radius: 999px; background: var(--surface); color: var(--muted); cursor: pointer; transition: color .15s, border-color .15s, background-color .15s; }
  .tema:hover { color: var(--accent-text); border-color: var(--accent); }
  .logo { flex: none; width: 84px; height: 44px; padding: 4px 5px; border-radius: 10px; transition: background-color .15s; }
  /* En modo oscuro el logo va sobre una placa clara, como un icono de app, para que se lea igual que en claro */
  :global(:root[data-theme='dark']) .logo { background: #fff3e6; }
  .tema .i-sol { display: none; }
  /* Selector de idioma: botón redondo con el código y un menú pequeño */
  .idioma { position: relative; flex: none; }
  .idioma-boton { display: inline-flex; align-items: center; justify-content: center; gap: 4px; height: 40px; padding: 0 10px; border: 1px solid var(--border); border-radius: 999px; background: var(--surface); color: var(--muted); font-size: .8rem; font-weight: 700; letter-spacing: .03em; cursor: pointer; list-style: none; transition: color .15s, border-color .15s; -webkit-tap-highlight-color: transparent; }
  .idioma-boton::-webkit-details-marker { display: none; }
  .idioma-boton:hover, .idioma[open] .idioma-boton { color: var(--accent-text); border-color: var(--accent); }
  .idioma-menu { position: absolute; right: 0; top: calc(100% + 6px); z-index: 40; min-width: 160px; margin: 0; padding: 6px; list-style: none; background: var(--surface); border: 1px solid var(--border); border-radius: 12px; box-shadow: 0 8px 28px rgb(0 0 0 / .16); }
  .idioma-menu a { display: block; padding: 10px 12px; border-radius: 8px; color: var(--text); text-decoration: none; background-image: none; }
  .idioma-menu a:hover { background: var(--chip); }
  .idioma-menu a[aria-current='true'] { font-weight: 700; color: var(--accent-text); background: var(--accent-soft); }
  .pie-idiomas { display: flex; flex-wrap: wrap; gap: 4px 12px; }
  .pie-idiomas a[aria-current='true'] { color: var(--text); font-weight: 650; text-decoration: none; }
  :global(:root[data-theme='dark']) .tema .i-sol { display: block; }
  :global(:root[data-theme='dark']) .tema .i-luna { display: none; }
  nav a { padding: 10px 12px; font-size: .95rem; color: var(--muted); white-space: nowrap; transition: color .15s; }
  nav a[aria-current='page'] { color: var(--text); font-weight: 650; background: none; box-shadow: none; border-radius: 0; }
  main { padding-top: 24px; padding-bottom: 40px; min-height: 70vh; }
  /* Pie: sigue el tema (claro u oscuro), con la marca y una línea naranja arriba */
  .site-footer { position: relative; background: var(--surface); color: var(--text); border-top: 1px solid var(--border); padding: 44px 0 calc(22px + env(safe-area-inset-bottom)); margin-top: 24px; }
  .site-footer::before { content: ''; position: absolute; inset: -1px 0 auto 0; height: 4px; background: var(--accent); }
  .site-footer a { color: var(--text); text-decoration: none; background-image: none; transition: color .15s; }
  .site-footer a:hover { color: var(--accent-text); }
  .site-footer a:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; border-radius: 4px; }
  .pie-rejilla { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr) minmax(0, 1.2fr); gap: 32px 40px; }
  .pie-logo { display: inline-flex; align-items: center; gap: 12px; font-weight: 800; font-size: 1.25rem; letter-spacing: -0.02em; }
  .pie-placa { display: inline-flex; padding: 6px 8px; border-radius: 12px; background: var(--accent-soft); }
  :global(:root[data-theme='dark']) .pie-placa { background: #fff3e6; }
  .pie-placa img { display: block; width: 62px; height: 30px; }
  .pie-lema { margin: 18px 0 4px; font-size: clamp(1.3rem, 3vw, 1.6rem); font-weight: 800; letter-spacing: -0.02em; line-height: 1.15; color: var(--accent); }
  .pie-sub { margin: 0; color: var(--muted); max-width: 40ch; }
  .pie-t { margin: 6px 0 12px; font-size: .74rem; text-transform: uppercase; letter-spacing: .12em; color: var(--muted); font-weight: 700; }
  .pie-col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 9px; font-size: .95rem; }
