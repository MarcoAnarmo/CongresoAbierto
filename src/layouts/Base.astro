---
import '../styles/global.css';
import { url, REPO, enlaceSugerencia, enlaceError } from '../lib/data';

interface Props { title: string; description?: string; }
const { title, description = 'Conoce a quien te representa. Transparencia y acceso fácil a datos oficiales del Congreso: quiénes son los 350 diputados, qué declaran y cómo votan.' } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav: { href: string; label: string; corto?: string }[] = [
  { href: '/', label: 'Hemiciclo' },
  { href: '/diputados', label: 'Diputados' },
  { href: '/votaciones', label: 'Votaciones', corto: 'Votos' },
  { href: '/metodologia', label: 'Metodología', corto: 'Método' },
  { href: '/colabora', label: 'Colabora' },
];
const activo = (href: string) => (href === '/' ? path === '/' || path === '' : path.startsWith(href) || (href === '/diputados' && path.startsWith('/diputado/')));
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>
      // Aplica el tema guardado antes de pintar la página (claro por defecto)
      (function () {
        var t = null;
        try { t = localStorage.getItem('tema'); } catch (e) {}
        if (t === 'oscuro') {
          document.documentElement.setAttribute('data-theme', 'dark');
          document.querySelector('meta[name="theme-color"]').setAttribute('content', '#1b1d22');
        }
      })();
    </script>
    <title>{title === 'Congreso Abierto' ? title : `${title} · Congreso Abierto`}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg?v=5')} />
    <link rel="icon" type="image/png" sizes="32x32" href={url('/favicon-32.png?v=5')} />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png?v=5')} />
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <header class="site">
      <div class="wrap bar">
        <a class="brand" href={url('/')} aria-label="Congreso Abierto, inicio">
          <svg class="logo" viewBox="1 15 62 30" fill="none" stroke="#16181d" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" width="74" height="36" aria-hidden="true">
            <g transform="translate(32 46) scale(.94) translate(-32 -46)" stroke-width="1.1">
              <circle cx="20.9" cy="41.4" r="2.2" fill="#ffd36e"/>
              <circle cx="27.4" cy="34.9" r="2.2" fill="#ffd36e"/>
              <circle cx="36.6" cy="34.9" r="2.2" fill="#ffd36e"/>
              <circle cx="43.1" cy="41.4" r="2.2" fill="#ffd36e"/>
              <circle cx="14.6" cy="41.5" r="2.2" fill="#f7a04b"/>
              <circle cx="16.5" cy="36.8" r="2.2" fill="#f7a04b"/>
              <circle cx="22.8" cy="30.5" r="2.2" fill="#f7a04b"/>
              <circle cx="27.5" cy="28.6" r="2.2" fill="#f7a04b"/>
              <circle cx="36.5" cy="28.6" r="2.2" fill="#f7a04b"/>
              <circle cx="41.2" cy="30.5" r="2.2" fill="#f7a04b"/>
              <circle cx="47.5" cy="36.8" r="2.2" fill="#f7a04b"/>
              <circle cx="49.4" cy="41.5" r="2.2" fill="#f7a04b"/>
              <circle cx="8.4" cy="41.5" r="2.2" fill="#f7a04b"/>
              <circle cx="9.8" cy="36.8" r="2.2" fill="#f7a04b"/>
              <circle cx="12.2" cy="32.5" r="2.2" fill="#f7a04b"/>
              <circle cx="18.5" cy="26.2" r="2.2" fill="#f7a04b"/>
              <circle cx="22.8" cy="23.8" r="2.2" fill="#f7a04b"/>
              <circle cx="27.5" cy="22.4" r="2.2" fill="#f7a04b"/>
              <circle cx="36.5" cy="22.4" r="2.2" fill="#f7a04b"/>
              <circle cx="41.2" cy="23.8" r="2.2" fill="#f7a04b"/>
              <circle cx="45.5" cy="26.2" r="2.2" fill="#f7a04b"/>
              <circle cx="51.8" cy="32.5" r="2.2" fill="#f7a04b"/>
              <circle cx="54.2" cy="36.8" r="2.2" fill="#f7a04b"/>
              <circle cx="55.6" cy="41.5" r="2.2" fill="#f7a04b"/>
              <circle cx="2.3" cy="41.5" r="2.2" fill="#e2852f"/>
              <circle cx="3.4" cy="36.8" r="2.2" fill="#e2852f"/>
              <circle cx="5.3" cy="32.3" r="2.2" fill="#e2852f"/>
              <circle cx="7.9" cy="28.2" r="2.2" fill="#e2852f"/>
              <circle cx="14.2" cy="21.9" r="2.2" fill="#e2852f"/>
              <circle cx="18.3" cy="19.3" r="2.2" fill="#e2852f"/>
              <circle cx="22.8" cy="17.4" r="2.2" fill="#e2852f"/>
              <circle cx="27.5" cy="16.3" r="2.2" fill="#e2852f"/>
              <circle cx="36.5" cy="16.3" r="2.2" fill="#e2852f"/>
              <circle cx="41.2" cy="17.4" r="2.2" fill="#e2852f"/>
              <circle cx="45.7" cy="19.3" r="2.2" fill="#e2852f"/>
              <circle cx="49.8" cy="21.9" r="2.2" fill="#e2852f"/>
              <circle cx="56.1" cy="28.2" r="2.2" fill="#e2852f"/>
              <circle cx="58.7" cy="32.3" r="2.2" fill="#e2852f"/>
              <circle cx="60.6" cy="36.8" r="2.2" fill="#e2852f"/>
              <circle cx="61.7" cy="41.5" r="2.2" fill="#e2852f"/>
            </g>
          </svg>
          <span>Congreso Abierto</span>
        </a>
        <nav aria-label="Principal">
          {nav.map((n) => <a class="subraya" href={url(n.href)} aria-current={activo(n.href) ? 'page' : undefined}>{n.corto ? <><span class="l-largo">{n.label}</span><span class="l-corto" aria-hidden="true">{n.corto}</span></> : n.label}</a>)}
        </nav>
        <button class="tema" type="button" id="boton-tema" aria-pressed="false" aria-label="Activar modo oscuro" title="Activar modo oscuro">
          <svg class="i-luna" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" /></svg>
          <svg class="i-sol" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4.2" /><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6" /></svg>
        </button>
      </div>
    </header>
    <script is:inline>
      (function () {
        var b = document.getElementById('boton-tema'), raiz = document.documentElement, meta = document.querySelector('meta[name="theme-color"]');
        function pintar() {
          var oscuro = raiz.getAttribute('data-theme') === 'dark', txt = oscuro ? 'Activar modo claro' : 'Activar modo oscuro';
          b.setAttribute('aria-pressed', String(oscuro)); b.setAttribute('aria-label', txt); b.title = txt;
          meta.setAttribute('content', oscuro ? '#1b1d22' : '#ffffff');
        }
        b.addEventListener('click', function () {
          var oscuro = raiz.getAttribute('data-theme') !== 'dark';
          if (oscuro) raiz.setAttribute('data-theme', 'dark'); else raiz.removeAttribute('data-theme');
          try { localStorage.setItem('tema', oscuro ? 'oscuro' : 'claro'); } catch (e) {}
          pintar();
        });
        pintar();
      })();
    </script>
    <script is:inline>
      (function () {
        var h = document.querySelector('header.site');
        function fijar() { document.documentElement.style.setProperty('--alto-cabecera', h.offsetHeight + 'px'); }
        fijar(); addEventListener('resize', fijar);
        var a = h.querySelector('nav a[aria-current="page"]'), n = a && a.parentElement;
        if (a && n.scrollWidth > n.clientWidth) n.scrollLeft = a.offsetLeft + a.offsetWidth - n.clientWidth + 16;
      })();
    </script>
    <div class="desplazable" id="desplazable" tabindex="-1">
    <main class="wrap" id="contenido">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap pie-rejilla">
        <div class="pie-marca">
          <a class="pie-logo" href={url('/')} aria-label="Congreso Abierto, inicio">
            <span class="pie-placa"><img src={url('/logo.svg')} alt="" width="62" height="30" /></span>
            <span>Congreso Abierto</span>
          </a>
          <p class="pie-lema">Conoce a quien te representa.</p>
          <p class="pie-sub">Transparencia y acceso fácil a datos oficiales del Congreso.</p>
        </div>
        <div class="pie-col">
          <h2 class="pie-t">Explora</h2>
          <ul>{nav.map((n) => <li><a href={url(n.href)}>{n.label}</a></li>)}</ul>
        </div>
        <div class="pie-col">
          <h2 class="pie-t">Participa</h2>
          <ul>
            <li><a href={url('/colabora')}>¿Querrías colaborar?</a></li>
            <li><a class="con-icono" href={REPO} rel="noopener"><svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m8 7-5 5 5 5M16 7l5 5-5 5" /></svg>Código en GitHub</a></li>
            <li><a href={enlaceSugerencia} rel="noopener">Hacer una sugerencia</a></li>
            <li><a href={enlaceError()} rel="noopener">Avisar de un error</a></li>
            <li><a href="mailto:congresoabierto.help@gmail.com">congresoabierto.help@gmail.com</a></li>
          </ul>
        </div>
      </div>
      <div class="wrap pie-base">
        <p>Solo datos oficiales del <a href="https://www.congreso.es/es/datos-abiertos">Congreso de los Diputados</a> y del <a href="https://www.boe.es">BOE</a>, sin interpretaciones. Cada dato enlaza a su documento original.</p>
        <p>Proyecto independiente · Código abierto (MIT)</p>
      </div>
    </footer>
    </div>
    <script is:inline>
      (function () { var d = document.getElementById('desplazable'); if (matchMedia('(min-width: 721px)').matches && !location.hash) d.focus({ preventScroll: true }); })();
    </script>
  </body>
</html>

<style>
  .saltar { position: absolute; left: -9999px; top: 8px; z-index: 50; background: var(--text); color: var(--bg); padding: 8px 12px; border-radius: 8px; }
  .saltar:focus { left: 8px; }
  header.site { border-bottom: 1px solid var(--border); background: var(--surface); position: sticky; top: 0; z-index: 20; padding-top: env(safe-area-inset-top); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 8px 16px; min-height: 56px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; font-weight: 800; font-size: 1.05rem; text-decoration: none; letter-spacing: -0.02em; white-space: nowrap; min-height: 44px; }
  nav { display: flex; gap: 2px; margin-left: auto; }
  .tema { display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; flex: none; border: 1px solid var(--border); border-radius: 999px; background: var(--surface); color: var(--muted); cursor: pointer; transition: color .15s, border-color .15s, background-color .15s; }
  .tema:hover { color: var(--accent-text); border-color: var(--accent); }
  .logo { flex: none; width: 84px; height: 44px; padding: 4px 5px; border-radius: 10px; transition: background-color .15s; }
  /* En modo oscuro el logo va sobre una placa clara, como un icono de app, para que se lea igual que en claro */
  :global(:root[data-theme='dark']) .logo { background: #fff3e6; }
  .tema .i-sol { display: none; }
  :global(:root[data-theme='dark']) .tema .i-sol { display: block; }
  :global(:root[data-theme='dark']) .tema .i-luna { display: none; }
  nav a { padding: 10px 12px; font-size: .95rem; color: var(--muted); white-space: nowrap; transition: color .15s; }
  nav a[aria-current='page'] { color: var(--text); font-weight: 650; background: none; box-shadow: none; border-radius: 0; }
  main { padding-top: 24px; padding-bottom: 40px; min-height: 70vh; }
  /* Pie: banda oscura en ambos temas, con la marca y una línea naranja arriba */
  .site-footer {
    --pie-bg: #15171c; --pie-texto: #eceae4; --pie-suave: #a9aeb7; --pie-borde: #2c2f37;
    position: relative; background: radial-gradient(120% 140% at 0% 0%, #22252c 0%, var(--pie-bg) 55%); color: var(--pie-texto);
    padding: 44px 0 calc(22px + env(safe-area-inset-bottom)); margin-top: 24px;
  }
  :global(:root[data-theme='dark']) .site-footer { --pie-bg: #0b0c0e; --pie-borde: #24262c; border-top: 1px solid var(--pie-borde); }
  .site-footer::before { content: ''; position: absolute; inset: 0 0 auto 0; height: 4px; background: linear-gradient(90deg, #ffd36e, #f7a04b 35%, #f26a1b 70%, #c2410c); }
  .site-footer a { color: var(--pie-texto); text-decoration: none; background-image: none; transition: color .15s; }
  .site-footer a:hover { color: #fdba74; }
  .site-footer a:focus-visible { outline: 3px solid #fb8a3c; outline-offset: 2px; border-radius: 4px; }
  .pie-rejilla { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr) minmax(0, 1.2fr); gap: 32px 40px; }
  .pie-logo { display: inline-flex; align-items: center; gap: 12px; font-weight: 800; font-size: 1.25rem; letter-spacing: -0.02em; }
  .pie-placa { display: inline-flex; padding: 6px 8px; border-radius: 12px; background: #fff3e6; box-shadow: 0 6px 20px rgba(242, 106, 27, .25); }
  .pie-placa img { display: block; width: 62px; height: 30px; }
  .pie-lema { margin: 18px 0 4px; font-size: clamp(1.3rem, 3vw, 1.6rem); font-weight: 800; letter-spacing: -0.02em; line-height: 1.15;
    background: linear-gradient(90deg, #ffd36e, #fb8a3c); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .pie-sub { margin: 0; color: var(--pie-suave); max-width: 40ch; }
  .pie-t { margin: 6px 0 12px; font-size: .74rem; text-transform: uppercase; letter-spacing: .12em; color: var(--pie-suave); font-weight: 700; }
  .pie-col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 9px; font-size: .95rem; }
  .pie-col li a { overflow-wrap: anywhere; }
  .con-icono { display: inline-flex; align-items: center; gap: 6px; }
  .pie-base { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 6px 24px; margin-top: 36px; padding-top: 18px; border-top: 1px solid var(--pie-borde); font-size: .82rem; color: var(--pie-suave); }
  .pie-base p { margin: 0; }
  .pie-base a { color: var(--pie-suave); text-decoration: underline; text-decoration-color: rgba(251, 138, 60, .6); text-underline-offset: 3px; }
  @media (max-width: 760px) {
    .pie-rejilla { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .pie-marca { grid-column: 1 / -1; }
  }
  @media (max-width: 420px) { .pie-rejilla { grid-template-columns: minmax(0, 1fr); gap: 26px; } }

  /* Móvil: marca arriba y menú en una fila desplazable de pestañas */
  @media (max-width: 720px) {
    .bar { display: grid; grid-template-columns: 1fr auto; grid-template-areas: 'marca tema' 'menu menu'; align-items: center; gap: 0; min-height: 0; padding-top: 6px; }
    .brand { grid-area: marca; justify-content: flex-start; }
    .tema { grid-area: tema; }
    nav { grid-area: menu; }
    nav { overflow-x: auto; scrollbar-width: none; margin: 0 -16px; padding: 0 12px 4px; }
    nav::-webkit-scrollbar { display: none; }
    nav a { padding: 10px 12px; font-size: .93rem; --sub-y: 2px; }
    main { padding-top: 16px; }
  }
  .l-corto { display: none; }
  @media (max-width: 530px) { .l-largo { display: none; } .l-corto { display: inline; } nav { justify-content: space-between; } nav a { padding: 10px 4px; --sub-x: 4px; } }
  @media (max-width: 374px) { nav { padding: 0 5px 4px; } nav a { padding: 10px 4px; font-size: .84rem; --sub-x: 4px; } }
  @media (max-width: 340px) { nav a { padding: 10px 2px; font-size: .8rem; --sub-x: 2px; } }
</style>
