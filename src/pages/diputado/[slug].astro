---
import Base from '../../layouts/Base.astro';
import { diputados, votaciones, votacionesPleno, colorGrupo, fmtEur2, fmtEur, fmtNum, fmtFecha, url, slug, enlaceError, candidaturaDistinta } from '../../lib/data';
import type { Diputado } from '../../lib/types';
import type { NombreIcono } from '../../lib/iconos';
import BotonCompartir from '../../components/BotonCompartir.astro';
import DialogoCompartir from '../../components/DialogoCompartir.astro';
import { rutaTarjeta, rotulo } from '../../lib/tarjetas';
import TablaPrestamos from '../../components/TablaPrestamos.astro';
import AvisoDudoso from '../../components/AvisoDudoso.astro';
import Icono from '../../components/Icono.astro';

export function getStaticPaths() {
  return diputados.map((d) => ({ params: { slug: slug(d) }, props: { d } }));
}
const { d } = Astro.props as { d: Diputado };
const p = d.patrimonio;
const m = d.retribucion.mensual;
const totalMensual = m.asignacion + m.complementoMesa + m.gastosRepresentacion + m.gastosLibreDisposicion + m.indemnizacion;
const pctTxt = (n: number | null) => (n === null ? '—' : `${fmtNum(n)} %`);
const fem = d.genero === 'F';
const votosDip = votaciones.map((v) => ({ v, voto: v.votos[String(d.codParlamentario)] ?? null }));
const colorVoto: Record<string, string> = { 'Sí': 'var(--si)', 'No': 'var(--no)', 'Abstención': 'var(--abs)', 'No vota': 'var(--novota)' };
const sinEscano = fem ? 'No era diputada' : 'No era diputado';
const pf = d.perfil;
const dd = d.deudas;
const fechaEvento = (f: string) => (f.length === 4 ? f : new Date(f + 'T12:00:00').toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' }));
const etEvento: Record<string, string> = { legislatura: 'Congreso', cargo: 'Cargo', trayectoria: 'Trayectoria', bienes: 'Bienes', intereses: 'Intereses' };
const RUCT = 'https://www.educacion.gob.es/ruct/consultauniversidades?actual=universidades';
const sinDeclaracion = p.estado === 'sin-declaracion';

// Votos sobre vivienda: cuántos de cada tipo (texto para la cajita y para lectores de pantalla)
const tiposVoto = [
  { k: 'Sí', t: 'sí' }, { k: 'No', t: 'no' }, { k: 'Abstención', t: 'abstención' }, { k: 'No vota', t: 'no votó' }, { k: null, t: sinEscano.toLowerCase() },
];
const cuentaVotos = tiposVoto.map((x) => ({ ...x, n: votosDip.filter((y) => y.voto === x.k).length })).filter((x) => x.n > 0);
const resumenVotos = cuentaVotos.map((x) => `${x.n} ${x.t}`).join(' · ');

const avisoDeudas = !!(dd?.principal?.aviso || dd?.anteriores.some((a) => a.aviso));
const nLeg = pf?.legislaturas.length ?? 0;
const etTipo: Record<string, string> = { publica: 'Universidad pública', privada: 'Universidad privada', ambas: 'Universidad pública y privada', 'sin-centro': 'No indica el centro de estudios' };
const viviendas = p.inmuebles.filter((i) => i.esVivienda).length;
const otras = p.inmuebles.length - viviendas;

// Documentos oficiales de la ficha
const documentos = [
  ...p.fuentes.map((f) => ({ t: f.parcial ? 'Modificación de la declaración de bienes' : 'Declaración de bienes y rentas', fecha: f.fecha, url: f.url })),
  ...(pf?.declaracionesIntereses ?? []).map((x) => ({ t: 'Declaración de intereses económicos', fecha: x.fecha, url: x.url })),
  ...(pf?.declaracionActividades ? [{ t: 'Declaración de actividades', fecha: null, url: pf.declaracionActividades }] : []),
];

// Deudas: lo que se resume en su cajita
const prestamos = dd?.principal?.prestamos ?? [];
const deuda = !dd
  ? { valor: '—', sub: 'sin datos de deudas' }
  : dd.sinDeudas || !dd.principal
    ? { valor: 'Ninguna', sub: 'no declara deudas ni préstamos' }
    : prestamos.length
      ? { valor: fmtEur(dd.principal.totalPendiente), sub: `${dd.principal.totalIncompleto ? 'al menos, ' : ''}pendientes en ${prestamos.length} ${prestamos.length === 1 ? 'préstamo' : 'préstamos'}` }
      : { valor: 'Sí', sub: 'otras deudas u obligaciones' };

// Rentas, cuentas, acciones y sociedades (páginas 1 a 3 de la declaración de bienes)
const fz = d.finanzas;
const alMenos = (t: { totalIncompleto: boolean } | null | undefined) => (t?.totalIncompleto ? 'al menos ' : '');
const TIPO_RENTA: Record<string, string> = { salariales: 'Sueldos, honorarios y otras retribuciones', dividendos: 'Dividendos y participación en beneficios', intereses: 'Intereses y rendimientos de cuentas y activos', otras: 'Otras rentas o percepciones' };
const tiposRenta = fz?.rentas ? Object.keys(TIPO_RENTA).filter((k) => fz.rentas!.filas.some((f) => f.tipo === k)) : [];
const inversiones = [fz?.valores, fz?.sociedades, fz?.otrosBienes].filter((x) => !!x);
const totalInversiones = inversiones.reduce((a, t) => a + t!.total, 0);
const filasInversiones = inversiones.reduce((a, t) => a + t!.filas.length, 0);
const fechaDecl = (t: { fecha: string | null; parcial: boolean }) => `${t.parcial ? 'modificación de su declaración' : 'declaración'} del ${fmtFecha(t.fecha)}`;
const rentas = fz?.rentas;
const tRentas = !fz ? { valor: '—', sub: 'sin declaración publicada' }
  : !rentas ? { valor: 'Ninguna', sub: 'no declara rentas' }
  : rentas.filas.some((f) => f.euros !== null) ? { valor: fmtEur(rentas.total), sub: `${alMenos(rentas)}en el año anterior a su declaración` }
  : { valor: rentas.irpf ? 'IRPF' : '—', sub: rentas.irpf ? `pagó ${rentas.irpfEuros !== null ? fmtEur(rentas.irpfEuros) : rentas.irpf} de IRPF; no detalla rentas` : 'no detalla importes' };
const tCuentas = !fz ? { valor: '—', sub: 'sin declaración publicada' }
  : !fz.depositos ? { valor: '0', sub: 'no declara saldo en cuentas' }
  : { valor: fmtEur(fz.depositos.total), sub: `${alMenos(fz.depositos)}en cuentas y depósitos` };
const tInv = !fz ? { valor: '—', sub: 'sin declaración publicada' }
  : !filasInversiones ? { valor: 'Ninguno', sub: 'no declara acciones, fondos ni otros bienes' }
  : { valor: fmtEur(totalInversiones), sub: `${inversiones.some((t) => t!.totalIncompleto) ? 'al menos ' : ''}en acciones, fondos, seguros y otros` };

// Registro de actividades y declaraciones de intereses económicos
const act = d.actividades;
const inter = d.intereses;
const nTrab = inter?.trabajos.length ?? 0;
// Sus votos en todas las votaciones del Pleno
const pa = d.participacion;
const votoEmitido = pa ? pa.si + pa.no + pa.abstencion : 0;
const pctDe = (n: number, t: number) => (t ? `${fmtNum(Math.round((1000 * n) / t) / 10)} %` : '—');
const porId = new Map(votacionesPleno.map((v) => [v.id, v]));
const distintas = (pa?.distintoGrupoIds ?? []).map((id) => porId.get(id)).filter((v) => !!v).slice(0, 12);

/** Cada cajita del resumen abre su sección (en el móvil, como hoja desde abajo; en el ordenador, en una ventana). */
type Tesela = { grupo?: string; id: string; icono: NombreIcono; titulo: string; corto?: string; prefijo?: string; valor: string; sub: string; acento?: string; texto?: boolean; aviso?: boolean; destacada?: boolean; votos?: boolean };
const teselas: Tesela[] = [
  {
    grupo: 'Dinero y bienes', id: 'propiedades', icono: 'propiedades', titulo: 'Propiedades', destacada: true, aviso: p.revisar,
    valor: sinDeclaracion ? '—' : String(p.propiedades ?? '—'),
    sub: sinDeclaracion || p.viviendas === null ? 'sin declaración publicada' : 'de ellas, ',
    acento: sinDeclaracion || p.viviendas === null ? undefined : `${p.viviendas} ${p.viviendas === 1 ? 'vivienda' : 'viviendas'}`,
  },
  { id: 'rentas', icono: 'rentas', titulo: 'Rentas declaradas', corto: 'Rentas', valor: tRentas.valor, sub: tRentas.sub, aviso: fz?.avisos.includes('rentas') },
  { id: 'cuentas', icono: 'cuenta', titulo: 'Cuentas', valor: tCuentas.valor, sub: tCuentas.sub, aviso: fz?.avisos.includes('depositos') },
  { id: 'inversiones', icono: 'acciones', titulo: 'Acciones y fondos', corto: 'Inversiones', valor: tInv.valor, sub: tInv.sub, aviso: fz?.avisos.some((a) => a !== 'rentas' && a !== 'depositos') },
  { id: 'deudas', icono: 'deuda', titulo: 'Deudas', valor: deuda.valor, sub: deuda.sub, aviso: avisoDeudas },
  {
    id: 'vehiculos', icono: 'vehiculo', titulo: 'Vehículos',
    valor: sinDeclaracion ? '—' : String(p.vehiculos ?? '—'),
    sub: sinDeclaracion ? 'sin declaración publicada' : p.vehiculos === 0 ? 'no declara vehículos' : p.vehiculos === 1 ? 'vehículo declarado' : 'vehículos declarados',
  },
  { id: 'retribucion', icono: 'sueldo', titulo: 'Retribución', valor: fmtEur(d.retribucion.totalMensual), sub: 'al mes del Congreso' },
  ...(pa ? [{
    grupo: 'En el Congreso', id: 'participacion', icono: 'votaciones' as const, titulo: 'Sus votos en el Pleno', corto: 'Votos en el Pleno',
    valor: fmtNum(votoEmitido), sub: `de ${fmtNum(pa.enEscano)} votaciones con escaño · `,
    acento: pa.distintoGrupo ? `${fmtNum(pa.distintoGrupo)} distinto de su grupo` : 'siempre con su grupo',
  }] : []),
  ...(votosDip.length ? [{ id: 'votaciones', icono: 'voto' as const, titulo: 'Votos sobre vivienda', corto: 'Votos', prefijo: 'sobre vivienda: ', valor: '', sub: resumenVotos, votos: true }] : []),
  {
    id: 'actividades', icono: 'actividades', titulo: 'Cargos y actividades', corto: 'Actividades',
    valor: !act ? '—' : act.pendiente ? '…' : String(act.total),
    sub: !act ? 'sin registro publicado' : act.pendiente ? 'pendiente de aprobar por el Pleno' : act.total === 1 ? 'cargo o actividad compatible' : 'cargos y actividades compatibles',
  },
  {
    id: 'trabajos', icono: 'trabajos', titulo: 'Trabajos anteriores', corto: 'Antes',
    valor: !inter ? '—' : String(nTrab), sub: !inter ? 'sin declaración publicada' : nTrab ? `${nTrab === 1 ? 'trabajo' : 'trabajos'} en los 5 años antes de su escaño` : 'no declara trabajos anteriores',
    aviso: !!inter?.avisos.length,
  },
  {
    grupo: 'Perfil', id: 'formacion', icono: 'formacion', titulo: 'Formación', texto: !!pf?.formacion.length,
    valor: pf?.formacion[0]?.texto ?? '—',
    sub: pf?.formacion.length ? (etTipo[pf.tipoFormacion] ?? 'Formación según su ficha') : 'su ficha no detalla estudios',
  },
  { id: 'trayectoria', icono: 'trayectoria', titulo: 'Trayectoria', valor: String(nLeg || '—'), sub: nLeg === 1 ? 'legislatura en el Congreso' : nLeg ? 'legislaturas en el Congreso' : 'sin datos en su ficha' },
  { id: 'documentos', icono: 'documento', titulo: 'Documentos', valor: String(documentos.length), sub: documentos.length === 1 ? 'documento oficial (PDF)' : 'documentos oficiales (PDF)' },
];
const iconoDe = Object.fromEntries(teselas.map((t) => [t.id, t.icono])) as Record<string, NombreIcono>;
const LINEA_CORTA = 6;
---
<Base title={d.nombreCompleto} imagen={rutaTarjeta.diputado(d, 'horizontal')} description={`${d.nombreCompleto} (${d.partido}, ${d.circunscripcion}): rentas, cuentas, acciones, propiedades y deudas declaradas, trabajos anteriores, actividades y cómo vota.`}>
  <p class="volver-p"><a class="volver" href={url('/diputados')}>← Diputados</a></p>
  <div class="cabecera">
    <BotonCompartir class="compartir-ficha" d={d} />
    <div class="foto" style={`--g:${colorGrupo(d.grupoCorto)}`}><img src={d.fotoUrl} alt={`Foto oficial de ${d.nombreCompleto}`} width="132" height="168" loading="lazy" referrerpolicy="no-referrer" /></div>
    <div class="cab-texto">
      <h1>{d.nombreCompleto}</h1>
      <p class="cab-grupo">
        <span class="pill"><span class="dot" style={`background:${colorGrupo(d.grupoCorto)}`}></span>{d.grupo.replace('GP ', 'Grupo ')}</span>
        <span class="muted">{fem ? 'Diputada' : 'Diputado'} por {d.circunscripcion}<span class="solo-escritorio"> desde {fmtFecha(d.fechaAlta)}</span></span>
      </p>
      <p class="small muted cab-datos">
        {candidaturaDistinta(d) && <>Candidatura: {d.partido} · </>}
        {pf?.anioNacimiento && <>{fem ? 'Nacida' : 'Nacido'} en {pf.anioNacimiento} · </>}
        {pf?.legislaturasTexto || `${fem ? 'Diputada' : 'Diputado'} de la XV Legislatura`}
      </p>
      {d.cargos.length > 0 && <p class="small solo-escritorio">{d.cargos.join(' · ')}</p>}
      <p class="small solo-escritorio"><a href={d.fichaUrl} rel="noopener">Ficha oficial en congreso.es ↗</a> · <a href={enlaceError(d.nombreCompleto)} rel="noopener">Avisar de un error en esta ficha</a></p>
    </div>
  </div>

  {p.revisar && <p class="warn aviso-general">Algún dato de esta ficha tiene una lectura dudosa en el PDF o un cambio comunicado que no identifica el bien. Está marcado con «Lectura no confirmada». Compruébalo en el PDF oficial y, si ves un error, <a href={url('/metodologia#errores')}>avísanos</a>.</p>}

  <nav class="mosaico" aria-label={`Resumen de la ficha de ${d.nombreCompleto}`}>
    {teselas.map((t) => (<>
      {t.grupo && <h2 class="m-grupo">{t.grupo}</h2>}
      <a class:list={['tesela', { destacada: t.destacada }]} href={`#${t.id}`} data-detalle={t.id} aria-haspopup="dialog">
        <span class="t-cab"><span class="t-ico"><Icono n={t.icono} /></span><span class="t-tit">{t.corto ? <><span class="tt-largo">{t.titulo}</span><span class="tt-corto">{t.corto}</span></> : t.titulo}</span><Icono n="derecha" tam={18} class="t-ir" /></span>
        {t.votos
          ? <span class="t-v t-puntos" role="img" aria-label={resumenVotos}>{votosDip.map(({ v, voto }) => <span class="pv" style={`background:${voto ? colorVoto[voto] : 'transparent'}`} data-vacio={voto ? undefined : ''} title={`${rotulo(v).mini}: ${voto ?? sinEscano}`}></span>)}</span>
          : <span class:list={['t-v', { texto: t.texto }]}>{t.valor}</span>}
        <span class="t-sub" aria-hidden={t.votos ? 'true' : undefined}>{t.prefijo && <span class="tt-corto">{t.prefijo}</span>}{t.sub}{t.acento && <span class="t-acento">{t.acento}</span>}</span>
        {t.aviso && <span class="t-aviso"><Icono n="aviso" tam={14} />Lectura no confirmada</span>}
      </a>
    </>))}
  </nav>
  <p class="ver-todo-p"><button class="ver-todo" type="button" id="ver-todo" aria-controls="secciones" aria-expanded="false">Ver toda la ficha en una página</button></p>

  <div class="secciones" id="secciones">

  <section class="seccion" id="propiedades" aria-labelledby="h-propiedades">
    <h2 id="h-propiedades"><span class="s-ico"><Icono n="propiedades" /></span>Propiedades declaradas</h2>
    <div class="s-cuerpo">
      {sinDeclaracion ? <p class="muted">No hay declaración de bienes publicada todavía.</p> : (
        <>
          {p.estado === 'verificado' && <p class="small muted">✓ Datos copiados literalmente del PDF oficial y revisados dos veces contra el original.</p>}
          {p.estado === 'transcrito' && !p.revisar && <p class="small muted">Transcripción del PDF oficial pendiente de una segunda revisión.</p>}
          {p.revisar && <AvisoDudoso texto="Algún bien tiene una lectura dudosa en el PDF o un cambio comunicado que no identifica el bien." url={p.fuentes[0]?.url} nombre={d.nombreCompleto} />}
          <p class="small muted">
            {p.combinada
              ? <>Su última declaración ({fmtFecha(p.declaracionFecha)}) solo comunica cambios, así que se muestra junto a su declaración completa anterior. Se listan todos los bienes que figuran en ellas, salvo los que una declaración posterior da expresamente por vendidos o dados de baja.</>
              : <>Según su declaración de bienes del {fmtFecha(p.declaracionFecha)}.</>}
          </p>
          {p.inmuebles.length === 0 ? <p>No declara inmuebles a su nombre.</p> : (
            <>
              {viviendas > 0 && otras > 0 && (
                <div class="segmentado filtro-bienes" role="group" aria-label="Qué propiedades mostrar">
                  <button class="btn" type="button" data-b="" aria-pressed="true">Todas ({p.inmuebles.length})</button>
                  <button class="btn" type="button" data-b="viv" aria-pressed="false">Viviendas ({viviendas})</button>
                  <button class="btn" type="button" data-b="otra" aria-pressed="false">Otras ({otras})</button>
                </div>
              )}
              <ul class="bienes">
                {p.inmuebles.map((i) => (
                  <li class:list={['bien', { viv: i.esVivienda }]} data-b={i.esVivienda ? 'viv' : 'otra'}>
                    <span class="b-l1">
                      <span class="b-nombre">{i.descripcion}{i.esVivienda && <span class="pill tag">vivienda</span>}</span>
                      <span class="b-pct" title="Porcentaje declarado"><span class="sr-only">Porcentaje declarado: </span>{pctTxt(i.porcentaje)}</span>
                    </span>
                    <span class="b-l2">{[i.provincia ?? 'Situación no indicada', i.naturaleza === 'urbana' ? 'Urbano' : 'Rústico', i.anioAdquisicion && `adquirido en ${i.anioAdquisicion}`, [i.derecho, i.titulo].filter(Boolean).join(' · ')].filter(Boolean).join(' · ')}</span>
                  </li>
                ))}
              </ul>
            </>
          )}
          {p.inmueblesSociedad.length > 0 && (
            <>
              <h3>Inmuebles de sociedades en las que participa</h3>
              <ul class="lineas">{p.inmueblesSociedad.map((i) => <li>{i.descripcion}{i.provincia && ` · ${i.provincia}`}{i.derecho && ` · ${i.derecho}`}</li>)}</ul>
              <p class="small muted">No se suman a su número de viviendas porque pertenecen a la sociedad, no a la persona.</p>
            </>
          )}
          {p.notas.length > 0 && (
            <details>
              <summary class="small">Cambios comunicados y notas ({p.notas.length})</summary>
              <ul class="small muted">{p.notas.map((n) => <li>{n}</li>)}</ul>
            </details>
          )}
          <p class="fuente">
            <Icono n="info" tam={16} />
            <span>{p.fuentes.map((f, i) => <>{i > 0 && ' · '}<a href={f.url} rel="noopener">{f.parcial ? 'Modificación' : 'Declaración'} del {fmtFecha(f.fecha)} (PDF) ↗</a></>)} · <a href={url('/metodologia#propiedades')}>Cómo se cuentan</a></span>
          </p>
        </>
      )}
    </div>
  </section>

  <section class="seccion" id="rentas" aria-labelledby="h-rentas">
    <h2 id="h-rentas"><span class="s-ico"><Icono n="rentas" /></span>Rentas declaradas</h2>
    <div class="s-cuerpo">
      {!fz ? <p class="muted">No hay declaración de bienes publicada todavía.</p> : !rentas ? <p>No declara rentas ni IRPF en sus declaraciones de bienes.</p> : (
        <>
          <p class="small muted">Rentas del año anterior a su {fechaDecl(rentas)}, tal y como las escribe. El sueldo del Congreso no se declara aquí: se publica aparte (ver <a href="#retribucion">Retribución</a>).</p>
          {fz.avisos.includes('rentas') && <AvisoDudoso texto="Alguna cifra de sus rentas no se lee con seguridad en el PDF (marcada con «?»)." url={rentas.url} nombre={d.nombreCompleto} />}
          {rentas.filas.some((f) => f.euros !== null) && (
            <p class="s-cifra"><strong>{rentas.totalIncompleto && <span class="small">al menos </span>}{fmtEur(rentas.total)}</strong><span>suma de las rentas que declara</span></p>
          )}
          {tiposRenta.map((k) => (
            <>
              <h3>{TIPO_RENTA[k]}</h3>
              <ul class="importes">{rentas.filas.filter((f) => f.tipo === k).map((f) => <li><span>{f.texto || <span class="muted">Sin concepto</span>}</span><span class="imp">{f.importe || <span class="muted">sin importe</span>}</span></li>)}</ul>
            </>
          ))}
          {rentas.filas.length === 0 && <p>No detalla rentas en la tabla.</p>}
          {rentas.irpf && <p class="irpf"><span>IRPF pagado el año anterior (cuota líquida)</span><strong>{rentas.irpf}{rentas.irpfEuros !== null && !/€/.test(rentas.irpf) && ' €'}</strong></p>}
          {rentas.totalIncompleto && <p class="small muted">Algún importe está en blanco o no se puede leer como número y no se suma.</p>}
        </>
      )}
      <p class="fuente"><Icono n="info" tam={16} /><span>{rentas && <><a href={rentas.url} rel="noopener">Página 1 de su {fechaDecl(rentas)} (PDF) ↗</a> · </>}<a href={url('/metodologia#rentas')}>Cómo se obtiene</a></span></p>
    </div>
  </section>

  <section class="seccion" id="cuentas" aria-labelledby="h-cuentas">
    <h2 id="h-cuentas"><span class="s-ico"><Icono n="cuenta" /></span>Cuentas y depósitos</h2>
    <div class="s-cuerpo">
      {!fz ? <p class="muted">No hay declaración de bienes publicada todavía.</p> : !fz.depositos ? <p>No declara saldo en cuentas ni depósitos.</p> : (
        <>
          <p class="small muted">Saldo de todos sus depósitos según su {fechaDecl(fz.depositos)}. Los números de cuenta no se publican.</p>
          <p class="s-cifra"><strong>{fz.depositos.totalIncompleto && <span class="small">al menos </span>}{fmtEur(fz.depositos.total)}</strong><span>en cuentas corrientes, de ahorro y otras imposiciones</span></p>
          <ul class="importes">{fz.depositos.filas.map((f) => <li><span>{f.texto || <span class="muted">Sin descripción</span>}</span><span class="imp">{f.importe || <span class="muted">sin saldo</span>}</span></li>)}</ul>
          {fz.depositos.totalIncompleto && <p class="small muted">Algún saldo está en blanco o no se puede leer como número y no se suma.</p>}
        </>
      )}
      <p class="fuente"><Icono n="info" tam={16} /><span>{fz?.depositos && <><a href={fz.depositos.url} rel="noopener">Página 2 de su {fechaDecl(fz.depositos)} (PDF) ↗</a> · </>}<a href={url('/metodologia#rentas')}>Cómo se obtiene</a></span></p>
    </div>
  </section>

  <section class="seccion" id="inversiones" aria-labelledby="h-inversiones">
    <h2 id="h-inversiones"><span class="s-ico"><Icono n="acciones" /></span>Acciones, fondos y sociedades</h2>
    <div class="s-cuerpo">
      {!fz ? <p class="muted">No hay declaración de bienes publicada todavía.</p> : !filasInversiones ? <p>No declara acciones, participaciones, fondos, sociedades ni otros bienes o derechos.</p> : (
        <>
          <p class="s-cifra"><strong>{inversiones.some((t) => t!.totalIncompleto) && <span class="small">al menos </span>}{fmtEur(totalInversiones)}</strong><span>valor que declara (suma de las tablas oficiales)</span></p>
          {fz.valores && (
            <>
              <h3>Deuda pública, acciones y participaciones</h3>
              <p class="small muted">Según su {fechaDecl(fz.valores)}.</p>
              <ul class="importes">{fz.valores.filas.map((f) => <li><span>{f.texto || <span class="muted">Sin descripción</span>}</span><span class="imp">{f.importe || <span class="muted">sin valor</span>}</span></li>)}</ul>
            </>
          )}
          {fz.sociedades && (
            <>
              <h3>Sociedades participadas en más de un 5 % por sus sociedades</h3>
              <p class="small muted">Según su {fechaDecl(fz.sociedades)}.</p>
              <ul class="importes">{fz.sociedades.filas.map((f) => <li><span>{f.texto || <span class="muted">Sin descripción</span>}</span><span class="imp">{f.importe || <span class="muted">sin valor</span>}</span></li>)}</ul>
            </>
          )}
          {fz.otrosBienes && (
            <>
              <h3>Otros bienes y derechos (seguros, planes de pensiones…)</h3>
              <p class="small muted">Según su {fechaDecl(fz.otrosBienes)}.</p>
              <ul class="importes">{fz.otrosBienes.filas.map((f) => <li><span>{f.texto || <span class="muted">Sin descripción</span>}</span><span class="imp">{f.importe || <span class="muted">sin valor</span>}</span></li>)}</ul>
            </>
          )}
          {p.inmueblesSociedad.length > 0 && <p class="small muted">Los inmuebles de sus sociedades están en <a href="#propiedades">Propiedades</a>.</p>}
        </>
      )}
      <p class="fuente"><Icono n="info" tam={16} /><span>Apartado «Otros bienes o derechos» (página 3) de su declaración de bienes · <a href={url('/metodologia#rentas')}>Cómo se obtiene</a></span></p>
    </div>
  </section>

  <section class="seccion" id="vehiculos" aria-labelledby="h-vehiculos">
    <h2 id="h-vehiculos"><span class="s-ico"><Icono n="vehiculo" /></span>Vehículos</h2>
    <div class="s-cuerpo">
      {sinDeclaracion ? <p class="muted">No hay declaración de bienes publicada todavía.</p>
        : p.listaVehiculos.length === 0 ? <p>No declara vehículos.</p>
        : <ul class="lista-simple">{p.listaVehiculos.map((v) => <li><span>{v.descripcion}</span>{v.anioAdquisicion && <span class="muted small">adquirido en {v.anioAdquisicion}</span>}</li>)}</ul>}
      {!sinDeclaracion && <p class="fuente"><Icono n="info" tam={16} /><span>Según su declaración de bienes del {fmtFecha(p.declaracionFecha)}. Las matrículas no se publican.</span></p>}
    </div>
  </section>

  <section class="seccion" id="deudas" aria-labelledby="h-deudas">
    <h2 id="h-deudas"><span class="s-ico"><Icono n="deuda" /></span>Deudas y préstamos</h2>
    <div class="s-cuerpo">
      {!dd ? <p class="muted">No hay datos de deudas para esta ficha.</p> : dd.sinDeudas || !dd.principal ? (
        <p>No declara deudas ni préstamos en su declaración de bienes{p.declaracionFecha && ` del ${fmtFecha(p.declaracionFecha)}`}.</p>
      ) : (
        <>
          <p class="small muted">
            Según su {dd.principal.parcial ? 'modificación de la declaración de bienes' : 'declaración de bienes'} del {fmtFecha(dd.principal.fecha)}.
            Los importes se copian tal y como los escribe el diputado.
          </p>
          {dd.principal.aviso && <AvisoDudoso texto={dd.principal.aviso} url={dd.principal.url} nombre={d.nombreCompleto} />}
          {dd.principal.prestamos.length > 0 && (
            <>
              <p class="s-cifra">
                <strong>{dd.principal.totalIncompleto && <span class="small">al menos </span>}{fmtEur(dd.principal.totalPendiente)}</strong>
                <span>de saldo pendiente en {dd.principal.prestamos.length} {dd.principal.prestamos.length === 1 ? 'préstamo' : 'préstamos'} (suma de la tabla oficial)</span>
              </p>
              {dd.principal.totalIncompleto && <p class="small muted">Algún saldo está en blanco o no se puede leer en el original y no se suma.</p>}
              <TablaPrestamos prestamos={dd.principal.prestamos} />
            </>
          )}
          {dd.principal.otras && <p><strong>Otras deudas y obligaciones:</strong> {dd.principal.otras}</p>}
          {dd.principal.nota && <p class="small muted">Observación del diputado: «{dd.principal.nota}»</p>}
          {dd.anteriores.length > 0 && (
            <details>
              <summary class="small">Deudas en declaraciones anteriores que siguen vigentes ({dd.anteriores.length})</summary>
              <p class="small muted">Pueden repetir préstamos de la declaración más reciente: no se suman.</p>
              {dd.anteriores.map((a) => (
                <div class="anterior">
                  <p class="small"><a href={a.url} rel="noopener">{a.parcial ? 'Modificación' : 'Declaración'} del {fmtFecha(a.fecha)} (PDF) ↗</a></p>
                  {a.aviso && <AvisoDudoso texto={a.aviso} url={a.url} nombre={d.nombreCompleto} />}
                  {a.prestamos.length > 0 && <TablaPrestamos prestamos={a.prestamos} />}
                  {a.otras && <p class="small"><strong>Otras deudas y obligaciones:</strong> {a.otras}</p>}
                  {a.nota && <p class="small muted">Observación: «{a.nota}»</p>}
                </div>
              ))}
            </details>
          )}
        </>
      )}
      <p class="fuente"><Icono n="info" tam={16} /><span>Apartado «Deudas y obligaciones patrimoniales» de su declaración oficial · <a href={url('/metodologia#deudas')}>Cómo se obtiene</a></span></p>
    </div>
  </section>

  <section class="seccion" id="retribucion" aria-labelledby="h-retribucion">
    <h2 id="h-retribucion"><span class="s-ico"><Icono n="sueldo" /></span>Retribución del Congreso</h2>
    <div class="s-cuerpo">
      <p class="s-cifra"><strong>{fmtEur2(totalMensual)}</strong><span>al mes (importes oficiales 2026)</span></p>
      <div class="table-scroll card" style="padding:0">
        <table>
          <caption class="sr-only">Desglose de la retribución mensual</caption>
          <tbody>
            <tr><td>Asignación constitucional</td><td class="num">{fmtEur2(m.asignacion)}</td></tr>
            {m.complementoMesa > 0 && <tr><td>Complemento por cargo en la Mesa</td><td class="num">{fmtEur2(m.complementoMesa)}</td></tr>}
            {m.gastosRepresentacion > 0 && <tr><td>Gastos de representación</td><td class="num">{fmtEur2(m.gastosRepresentacion)}</td></tr>}
            {m.gastosLibreDisposicion > 0 && <tr><td>Gastos de libre disposición</td><td class="num">{fmtEur2(m.gastosLibreDisposicion)}</td></tr>}
            <tr><td>Indemnización por gastos (exenta de IRPF){d.circunscripcion === 'Madrid' && ' · electos por Madrid'}</td><td class="num">{fmtEur2(m.indemnizacion)}</td></tr>
            <tr><th>Total mensual</th><th class="num">{fmtEur2(totalMensual)}</th></tr>
          </tbody>
        </table>
      </div>
      <p class="small muted">
        {d.retribucion.cargosRetribuidos.length ? `Incluye complementos por: ${d.retribucion.cargosRetribuidos.join(', ')}. ` : 'Sin complementos por cargo. '}
        No incluye otros ingresos (por ejemplo, el sueldo de miembro del Gobierno) ni gastos de transporte, que el Congreso paga directamente.
      </p>
      <p class="fuente"><Icono n="info" tam={16} /><span><a href={url('/metodologia#retribuciones')}>Cómo se calcula</a></span></p>
    </div>
  </section>

  {pa && (
    <section class="seccion" id="participacion" aria-labelledby="h-participacion">
      <h2 id="h-participacion"><span class="s-ico"><Icono n="votaciones" /></span>Sus votos en el Pleno</h2>
      <div class="s-cuerpo">
        <p class="small muted">Todas las votaciones del Pleno de la XV Legislatura con voto nominal publicado, desde que {fem ? 'es diputada' : 'es diputado'} ({fmtFecha(pa.desde)} – {fmtFecha(pa.hasta)}).</p>
        <p class="s-cifra"><strong>{fmtNum(votoEmitido)}</strong><span>votos de {fmtNum(pa.enEscano)} votaciones en las que tenía escaño ({pctDe(votoEmitido, pa.enEscano)})</span></p>
        <span class="barra" aria-hidden="true"><span class="b-si" style={`width:${pctDe(pa.si, pa.enEscano).replace(',', '.').replace(' ', '')}`}></span><span class="b-no" style={`width:${pctDe(pa.no, pa.enEscano).replace(',', '.').replace(' ', '')}`}></span><span class="b-abs" style={`width:${pctDe(pa.abstencion, pa.enEscano).replace(',', '.').replace(' ', '')}`}></span><span class="b-nv" style={`width:${pctDe(pa.noVota, pa.enEscano).replace(',', '.').replace(' ', '')}`}></span></span>
        <p class="leyenda-votos small">
          <span class="pill"><span class="dot" style="background:var(--si)"></span>{fmtNum(pa.si)} sí</span>
          <span class="pill"><span class="dot" style="background:var(--no)"></span>{fmtNum(pa.no)} no</span>
          <span class="pill"><span class="dot" style="background:var(--abs)"></span>{fmtNum(pa.abstencion)} abstención</span>
          <span class="pill"><span class="dot" style="background:var(--novota)"></span>{fmtNum(pa.noVota)} no votó</span>
        </p>
        <h3>Votos distintos de su grupo</h3>
        {d.grupoCorto === 'Mixto'
          ? <p class="small">En el Grupo Mixto conviven varios partidos, así que no se cuenta como voto distinto del grupo.</p>
          : pa.distintoGrupo === 0
            ? <p>Siempre votó lo mismo que la mayoría de su grupo (o no votó).</p>
            : (
              <>
                <p><strong>{fmtNum(pa.distintoGrupo)}</strong> {pa.distintoGrupo === 1 ? 'vez votó' : 'veces votó'} sí, no o abstención distinto de la mayoría de su grupo en esa votación{distintas.length < pa.distintoGrupo ? `. Las ${distintas.length} más recientes:` : ':'}</p>
                <ul class="votos">
                  {distintas.map((v) => (
                    <li><a class="v-fila" href={url(`/votaciones?v=${encodeURIComponent(v!.id)}`)}>
                      <span class="pill voto" style={`border-color:${colorVoto[v!.votos[String(d.codParlamentario)]] ?? 'var(--border)'}`}><span class="dot" style={`background:${colorVoto[v!.votos[String(d.codParlamentario)]] ?? 'transparent'}`}></span>{v!.votos[String(d.codParlamentario)]}</span>
                      <span class="v-texto"><strong class="v-oficial-t">{v!.titulo}</strong><span class="muted small">{fmtFecha(v!.fecha)} · {v!.resultado}{v!.detalle && ` · ${v!.detalle}`}</span></span>
                      <span class="v-ir" aria-hidden="true"><Icono n="derecha" tam={18} /></span>
                    </a></li>
                  ))}
                </ul>
              </>
            )}
        <p class="fuente"><Icono n="info" tam={16} /><span>Votos nominales de los datos abiertos del Congreso. El grupo de cada votación es el que publica el Congreso para esa fecha; las votaciones secretas no cuentan · <a href={url('/metodologia#participacion')}>Cómo se calcula</a> · <a href={url('/votaciones')}>Todas las votaciones</a></span></p>
      </div>
    </section>
  )}

  {votosDip.length > 0 && (
    <section class="seccion" id="votaciones" aria-labelledby="h-votaciones">
      <h2 id="h-votaciones"><span class="s-ico"><Icono n="voto" /></span>Votaciones sobre vivienda</h2>
      <div class="s-cuerpo">
        <p class="leyenda-votos small">
          {cuentaVotos.map((x) => <span class="pill"><span class="dot" style={x.k ? `background:${colorVoto[x.k]}` : 'border:2px solid var(--novota)'}></span>{x.n} {x.t}</span>)}
        </p>
        <ul class="votos">
          {votosDip.map(({ v, voto }) => (
            <li><a class="v-fila" href={url(`/votaciones?v=${encodeURIComponent(v.id)}`)} aria-label={`${rotulo(v).corto}: ${voto ?? sinEscano}. Ver la votación con el voto de cada grupo y sus documentos`}>
              <span class="pill voto" style={`border-color:${voto ? colorVoto[voto] : 'var(--border)'}`}><span class="dot" style={voto ? `background:${colorVoto[voto]}` : 'border:2px solid var(--novota)'}></span>{voto ?? sinEscano}</span>
              <span class="v-texto">
                <strong>{rotulo(v).corto}</strong>
                <span class="muted small">{rotulo(v).quien} · {fmtFecha(v.fecha)} · {v.resultado}</span>
                <span class="small v-oficial">{v.titulo}</span>
              </span>
              <span class="v-ir" aria-hidden="true"><Icono n="derecha" tam={18} /></span>
            </a></li>
          ))}
        </ul>
        <p class="fuente"><Icono n="info" tam={16} /><span>Votos nominales publicados en los datos abiertos del Congreso. Toca una votación para ver cómo votó cada grupo y sus documentos oficiales · <a href={url('/votaciones')}>Todas las votaciones</a></span></p>
      </div>
    </section>
  )}

  <section class="seccion" id="actividades" aria-labelledby="h-actividades">
    <h2 id="h-actividades"><span class="s-ico"><Icono n="actividades" /></span>Cargos y actividades compatibles</h2>
    <div class="s-cuerpo">
      {!act ? <p class="muted">No hay registro de actividades publicado.</p> : act.pendiente ? (
        <p>El Pleno del Congreso aún no ha resuelto sobre la compatibilidad de sus actividades, así que el Congreso no publica todavía su contenido.</p>
      ) : act.total === 0 ? <p>No declara cargos ni actividades además de su escaño.</p> : (
        <>
          <p class="small muted">Lo que {fem ? 'la diputada' : 'el diputado'} ha declarado y el Pleno ha considerado compatible con el escaño, copiado literalmente del Registro de Intereses.</p>
          {act.secciones.map((sc) => (
            <>
              <h3>{sc.titulo}</h3>
              <ul class="lineas">{sc.items.map((i) => <li>{i.texto}{i.fechaAcuerdo && <span class="muted small"> · acuerdo del Pleno del {fmtFecha(i.fechaAcuerdo)}</span>}</li>)}</ul>
            </>
          ))}
        </>
      )}
      <p class="fuente"><Icono n="info" tam={16} /><span>{act && <><a href={act.url} rel="noopener">Registro de Intereses - Actividades (PDF) ↗</a> · </>}<a href={url('/metodologia#actividades')}>Cómo se obtiene</a></span></p>
    </div>
  </section>

  <section class="seccion" id="trabajos" aria-labelledby="h-trabajos">
    <h2 id="h-trabajos"><span class="s-ico"><Icono n="trabajos" /></span>Trabajos anteriores e intereses</h2>
    <div class="s-cuerpo">
      {!inter ? <p class="muted">No hay declaración de intereses económicos publicada.</p> : (
        <>
          {inter.avisos.map((a) => <AvisoDudoso texto={a} url={inter.declaraciones[0]?.url} nombre={d.nombreCompleto} />)}
          <h3>Actividades en los cinco años anteriores a su escaño</h3>
          {nTrab === 0 ? <p>No declara actividades en ese periodo.</p> : (
            <>
              <p class="small muted">Según su declaración de intereses económicos del {fmtFecha(inter.trabajosFuente!.fecha)}: las que pueden condicionar su actividad política o le dieron ingresos.</p>
              <ul class="trabajos">{inter.trabajos.map((t) => (
                <li>
                  <span class="tr-l1"><strong>{t.empleador || t.descripcion}</strong>{t.sector && <span class="pill tag">{t.sector}</span>}</span>
                  <span class="tr-l2">{[t.periodo, t.empleador && t.descripcion].filter(Boolean).join(' · ')}</span>
                </li>
              ))}</ul>
            </>
          )}
          <h3>Donaciones y obsequios recibidos</h3>
          {inter.donaciones.length === 0 ? <p class="small">No declara donaciones, obsequios ni beneficios no remunerados.</p>
            : <ul class="lineas">{inter.donaciones.map((x) => <li>{x.benefactor && <strong>{x.benefactor}: </strong>}{x.descripcion}</li>)}</ul>}
          <h3>Fundaciones y asociaciones a las que contribuye</h3>
          {inter.contribuciones.length === 0 ? <p class="small">No declara contribuciones.</p>
            : <ul class="lineas">{inter.contribuciones.map((x) => <li>{x.destinatario && <strong>{x.destinatario}: </strong>}{x.descripcion}</li>)}</ul>}
          {inter.otros.length > 0 && (
            <>
              <h3>Otros intereses y observaciones</h3>
              <ul class="lineas">{inter.otros.map((o) => <li>{o}</li>)}</ul>
            </>
          )}
        </>
      )}
      <p class="fuente"><Icono n="info" tam={16} /><span>{inter && inter.declaraciones.map((x, i) => <>{i > 0 && ' · '}<a href={x.url} rel="noopener">{x.tipo === 'modificacion' ? 'Modificación' : 'Declaración'} del {fmtFecha(x.fecha)} (PDF) ↗</a></>)}{inter && ' · '}<a href={url('/metodologia#intereses')}>Cómo se obtiene</a></span></p>
    </div>
  </section>

  <section class="seccion" id="formacion" aria-labelledby="h-formacion">
    <h2 id="h-formacion"><span class="s-ico"><Icono n="formacion" /></span>Formación</h2>
    <div class="s-cuerpo">
      {!pf || pf.formacion.length === 0 ? <p class="muted">Su ficha oficial no detalla estudios.</p> : (
        <ul class="lineas">
          {pf.formacion.map((f) => (
            <li>
              {f.texto}
              {f.centros.map((c) => <a class={`pill tipo ${c.tipo === 'pública' ? 'publica' : 'privada'}`} href={RUCT} rel="noopener" title={`${c.nombre}: universidad ${c.tipo} según el registro oficial de universidades (RUCT)`}>{c.nombre} · {c.tipo}</a>)}
              {f.otroCentro && <span class="pill tipo otro" title="El centro no figura en el registro oficial de universidades españolas (RUCT)">Centro no incluido en el RUCT</span>}
            </li>
          ))}
        </ul>
      )}
      {pf && pf.formacion.length > 0 && pf.tipoFormacion === 'sin-centro' && <p class="small muted">La ficha no indica en qué centro estudió.</p>}
      <p class="fuente"><Icono n="info" tam={16} /><span>Texto literal de su <a href={d.fichaUrl} rel="noopener">ficha personal en congreso.es ↗</a>, que redacta cada diputado. Pública o privada según el <a href={RUCT} rel="noopener">registro oficial de universidades (RUCT) ↗</a> · <a href={url('/metodologia#perfil')}>Cómo se obtiene</a></span></p>
    </div>
  </section>

  <section class="seccion" id="trayectoria" aria-labelledby="h-trayectoria">
    <h2 id="h-trayectoria"><span class="s-ico"><Icono n="trayectoria" /></span>Trayectoria</h2>
    <div class="s-cuerpo">
      <p class="small muted">{fem ? 'Diputada' : 'Diputado'} por {d.circunscripcion} desde el {fmtFecha(d.fechaAlta)}{pf?.legislaturasTexto && ` · ${pf.legislaturasTexto}`}.</p>
      {d.cargos.length > 0 && (
        <>
          <h3>Cargos en el Congreso</h3>
          <ul class="lineas">{d.cargos.map((c) => <li>{c}</li>)}</ul>
        </>
      )}
      <h3>Antes del Congreso</h3>
      {!pf || pf.trayectoria.length === 0 ? <p class="muted small">Su ficha oficial no detalla trayectoria.</p> : <ul class="lineas">{pf.trayectoria.map((t) => <li>{t}</li>)}</ul>}
      {pf && pf.eventos.length > 0 && (
        <>
          <h3>Línea de tiempo</h3>
          <div class="segmentado filtros-tiempo" role="group" aria-label="Qué mostrar en la línea de tiempo">
            <button class="btn" type="button" data-t="" aria-pressed="true">Todo</button>
            <button class="btn" type="button" data-t="congreso" aria-pressed="false">Congreso</button>
            <button class="btn" type="button" data-t="trayectoria" aria-pressed="false">Trayectoria</button>
            <button class="btn" type="button" data-t="declaraciones" aria-pressed="false">Declaraciones</button>
          </div>
          <ol class="linea" data-corta={LINEA_CORTA}>
            {pf.eventos.map((e) => (
              <li class={`ev ev-${e.tipo}`} data-grupo={e.tipo === 'legislatura' || e.tipo === 'cargo' ? 'congreso' : e.tipo === 'trayectoria' ? 'trayectoria' : 'declaraciones'}>
                <time datetime={e.fecha}>{fechaEvento(e.fecha)}</time>
                <span class="riel" aria-hidden="true"></span>
                <div class="cuerpo">
                  <span class="etq">{etEvento[e.tipo]}</span>
                  {e.url ? <a href={e.url} rel="noopener">{e.texto} (PDF) ↗</a> : <span>{e.texto}</span>}
                  {e.detalle && <p class="small muted">{e.detalle}</p>}
                </div>
              </li>
            ))}
          </ol>
          <button class="btn mas-linea" type="button" hidden>Ver todas las fechas</button>
          <p class="fuente"><Icono n="info" tam={16} /><span>Fechas de su ficha oficial (legislaturas, cargos actuales y años que cita en su trayectoria) y de sus declaraciones en esta legislatura. Las cifras de cada declaración de bienes son las de ese documento; las modificaciones solo comunican cambios.</span></p>
        </>
      )}
    </div>
  </section>

  <section class="seccion" id="documentos" aria-labelledby="h-documentos">
    <h2 id="h-documentos"><span class="s-ico"><Icono n="documento" /></span>Documentos oficiales</h2>
    <div class="s-cuerpo">
      <ul class="lista-docs">
        <li><a href={d.fichaUrl} rel="noopener"><Icono n="documento" tam={18} /><span>Ficha personal en congreso.es ↗</span></a></li>
        {documentos.map((x) => <li><a href={x.url} rel="noopener"><Icono n="documento" tam={18} /><span>{x.t}{x.fecha && <span class="muted"> · {fmtFecha(x.fecha)}</span>} (PDF) ↗</span></a></li>)}
      </ul>
      <p class="fuente"><Icono n="aviso" tam={16} /><span>¿Ves algo que no coincide con el original? <a href={enlaceError(d.nombreCompleto)} rel="noopener">Avisar de un error en esta ficha</a></span></p>
    </div>
  </section>

  </div>

  <dialog class="dlg-detalle" id="dlg-detalle" aria-labelledby="dlg-detalle-t">
    <div class="d-cab">
      {Object.entries(iconoDe).map(([id, n]) => <span class="d-ico" data-para={id} hidden><Icono n={n} /></span>)}
      <h2 id="dlg-detalle-t"></h2>
      <button class="d-cerrar" type="button" aria-label="Cerrar"><Icono n="cerrar" /></button>
    </div>
    <div class="d-cuerpo" tabindex="-1" autofocus></div>
  </dialog>
  <DialogoCompartir />
</Base>

<style>
  .volver-p { margin: 0 0 .4rem; }
  /* Cabecera: la foto lleva un marco del color de su grupo, como en las tarjetas para compartir */
