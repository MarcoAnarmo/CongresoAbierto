---
import Base from '../../layouts/Base.astro';
import { diputados, votaciones, colorGrupo, fmtEur2, fmtEur, fmtNum, fmtFecha, url, slug, enlaceError } from '../../lib/data';
import type { Diputado } from '../../lib/types';
import TablaPrestamos from '../../components/TablaPrestamos.astro';
import AvisoDudoso from '../../components/AvisoDudoso.astro';

export function getStaticPaths() {
  return diputados.map((d) => ({ params: { slug: slug(d) }, props: { d } }));
}
const { d } = Astro.props as { d: Diputado };
const p = d.patrimonio;
const m = d.retribucion.mensual;
const totalMensual = m.asignacion + m.complementoMesa + m.gastosRepresentacion + m.gastosLibreDisposicion + m.indemnizacion;
const pctTxt = (n: number | null) => (n === null ? '—' : `${fmtNum(n)} %`);
const votosDip = votaciones.map((v) => ({ v, voto: v.votos[String(d.codParlamentario)] ?? null }));
const colorVoto: Record<string, string> = { 'Sí': 'var(--si)', 'No': 'var(--no)', 'Abstención': 'var(--abs)', 'No vota': 'var(--novota)' };
const pf = d.perfil;
const dd = d.deudas;
const fechaEvento = (f: string) => (f.length === 4 ? f : new Date(f + 'T12:00:00').toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' }));
const etEvento: Record<string, string> = { legislatura: 'Congreso', cargo: 'Cargo', trayectoria: 'Trayectoria', bienes: 'Bienes', intereses: 'Intereses' };
const RUCT = 'https://www.educacion.gob.es/ruct/consultauniversidades?actual=universidades';
---
<Base title={d.nombreCompleto} description={`${d.nombreCompleto} (${d.partido}, ${d.circunscripcion}): retribución, viviendas y vehículos declarados y votaciones clave.`}>
  <p><a class="volver" href={url('/diputados')}>← Diputados</a></p>
  <div class="cabecera">
    <img src={d.fotoUrl} alt={`Foto oficial de ${d.nombreCompleto}`} width="110" height="140" loading="lazy" referrerpolicy="no-referrer" />
    <div>
      <h1>{d.nombreCompleto}</h1>
      <p>
        <span class="pill"><span class="dot" style={`background:${colorGrupo(d.grupoCorto)}`}></span>{d.grupo.replace('GP ', 'Grupo ')}</span>
        <span class="muted"> · Candidatura: {d.partido} · {d.genero === 'F' ? 'Diputada' : 'Diputado'} por {d.circunscripcion} desde {fmtFecha(d.fechaAlta)}</span>
      </p>
      {pf && (
        <p class="small muted">
          {pf.anioNacimiento && <>{d.genero === 'F' ? 'Nacida' : 'Nacido'} en {pf.anioNacimiento} · </>}
          {pf.legislaturasTexto || `${d.genero === 'F' ? 'Diputada' : 'Diputado'} de la XV Legislatura`}
        </p>
      )}
      {d.cargos.length > 0 && <p class="small">{d.cargos.join(' · ')}</p>}
      <p class="small"><a href={d.fichaUrl} rel="noopener">Ficha oficial en congreso.es ↗</a> · <a href={enlaceError(d.nombreCompleto)} rel="noopener">Avisar de un error en esta ficha</a></p>
    </div>
  </div>

  <div class="grid-stats resumen-ficha">
    <div class="card stat destacada"><div class="v">{p.propiedades ?? '—'}</div><div class="l">propiedades a su nombre (viviendas, garajes, locales, fincas…)</div></div>
    <div class="card stat"><div class="v">{p.viviendas ?? '—'}</div><div class="l">de ellas son viviendas</div></div>
    <div class="card stat"><div class="v">{p.vehiculos ?? '—'}</div><div class="l">vehículos declarados</div></div>
    <div class="card stat"><div class="v">{fmtEur(d.retribucion.totalMensual)}</div><div class="l">al mes del Congreso (importes oficiales 2026)</div></div>
  </div>

  {pf && (
    <section class="perfil" aria-labelledby="h-perfil">
      <h2 id="h-perfil" class="sr-only">Formación y trayectoria</h2>
      <div class="card bloque">
        <h3>Formación</h3>
        {pf.formacion.length === 0 ? <p class="muted small">Su ficha oficial no detalla estudios.</p> : (
          <ul class="lineas">
            {pf.formacion.map((f) => (
              <li>
                {f.texto}
                {f.centros.map((c) => <a class={`pill tipo ${c.tipo === 'pública' ? 'publica' : 'privada'}`} href={RUCT} rel="noopener" title={`${c.nombre}: universidad ${c.tipo} según el registro oficial de universidades (RUCT)`}>{c.nombre} · {c.tipo}</a>)}
                {f.otroCentro && <span class="pill tipo otro" title="El centro no figura en el registro oficial de universidades españolas (RUCT)">Centro no incluido en el RUCT</span>}
              </li>
            ))}
          </ul>
        )}
        {pf.formacion.length > 0 && pf.tipoFormacion === 'sin-centro' && <p class="small muted">La ficha no indica en qué centro estudió.</p>}
      </div>
      <div class="card bloque">
        <h3>Trayectoria</h3>
        {pf.trayectoria.length === 0 ? <p class="muted small">Su ficha oficial no detalla trayectoria.</p> : (
          <ul class="lineas">{pf.trayectoria.map((t) => <li>{t}</li>)}</ul>
        )}
      </div>
      <p class="small muted nota-perfil">
        Texto literal de su <a href={d.fichaUrl} rel="noopener">ficha personal en congreso.es ↗</a>, que redacta cada diputado.
        El tipo de universidad (pública o privada) es el del <a href={RUCT} rel="noopener">registro oficial de universidades (RUCT) ↗</a>.{' '}
        <a href={url('/metodologia#perfil')}>Cómo se obtiene</a>.
      </p>
    </section>
  )}

  {pf && pf.eventos.length > 0 && (
    <section aria-labelledby="h-tiempo">
      <h2 id="h-tiempo">Línea de tiempo</h2>
      <div class="segmentado filtros-tiempo" role="group" aria-label="Qué mostrar en la línea de tiempo">
        <button class="btn" type="button" data-t="" aria-pressed="true">Todo</button>
        <button class="btn" type="button" data-t="congreso" aria-pressed="false">Congreso</button>
        <button class="btn" type="button" data-t="trayectoria" aria-pressed="false">Trayectoria</button>
        <button class="btn" type="button" data-t="declaraciones" aria-pressed="false">Declaraciones</button>
      </div>
      <ol class="linea">
        {pf.eventos.map((e) => (
          <li class={`ev ev-${e.tipo}`} data-grupo={e.tipo === 'legislatura' || e.tipo === 'cargo' ? 'congreso' : e.tipo === 'trayectoria' ? 'trayectoria' : 'declaraciones'}>
            <time datetime={e.fecha}>{fechaEvento(e.fecha)}</time>
            <div>
              <span class="etq">{etEvento[e.tipo]}</span>
              {e.url ? <a href={e.url} rel="noopener">{e.texto} (PDF) ↗</a> : <span>{e.texto}</span>}
              {e.detalle && <p class="small muted">{e.detalle}</p>}
            </div>
          </li>
        ))}
      </ol>
      <p class="small muted">
        Fechas de su ficha oficial (legislaturas, cargos actuales y años que cita en su trayectoria) y de sus declaraciones en esta legislatura.
        Las cifras de cada declaración de bienes son las de ese documento; las modificaciones solo comunican cambios.
      </p>
    </section>
  )}


  {p.estado === 'verificado' && <p class="small muted">✓ Datos copiados literalmente del PDF oficial y revisados dos veces contra el original.</p>}
  {p.estado === 'transcrito' && !p.revisar && <p class="small muted">Transcripción del PDF oficial pendiente de una segunda revisión.</p>}
  {p.revisar && <p class="warn">Algún dato de esta ficha tiene una lectura dudosa en el PDF o un cambio comunicado que no identifica el bien. Compruébalo en el PDF oficial (enlazado abajo) y, si ves un error, <a href={url('/metodologia#errores')}>avísanos</a>.</p>}

  <h2>Propiedades declaradas</h2>
  {p.estado === 'sin-declaracion' ? <p class="muted">No hay declaración de bienes publicada todavía.</p> : (
    <>
      <p class="small muted">
        {p.combinada
          ? <>Su última declaración ({fmtFecha(p.declaracionFecha)}) solo comunica cambios, así que se muestra junto a su declaración completa anterior. Se listan todos los bienes que figuran en ellas, salvo los que una declaración posterior da expresamente por vendidos o dados de baja.</>
          : <>Según su declaración de bienes del {fmtFecha(p.declaracionFecha)}.</>}
      </p>
      {p.inmuebles.length === 0 ? <p>No declara inmuebles a su nombre.</p> : (
        <div class="card tabla-bienes" style="padding:0">
          <table>
            <thead><tr><th scope="col">Bien</th><th scope="col">Tipo</th><th scope="col">Situación</th><th scope="col" class="num">Año</th><th scope="col">Derecho y título</th><th scope="col" class="num">% declarado</th></tr></thead>
            <tbody>
              {p.inmuebles.map((i) => (
                <tr class={i.esVivienda ? 'viv' : ''}>
                  <td class="bien">{i.descripcion}{i.esVivienda && <span class="pill tag">vivienda</span>}</td>
                  <td class="small" data-label="Tipo">{i.naturaleza === 'urbana' ? 'Urbano' : 'Rústico'}</td>
                  <td data-label="Situación">{i.provincia ?? '—'}</td>
                  <td class="num" data-label="Año">{i.anioAdquisicion ?? '—'}</td>
                  <td class="small" data-label="Derecho">{[i.derecho, i.titulo].filter(Boolean).join(' · ') || '—'}</td>
                  <td class="num" data-label="% declarado">{pctTxt(i.porcentaje)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
      {p.inmueblesSociedad.length > 0 && (
        <>
          <h3>Inmuebles de sociedades en las que participa</h3>
          <ul>{p.inmueblesSociedad.map((i) => <li>{i.descripcion}{i.provincia && ` · ${i.provincia}`}{i.derecho && ` · ${i.derecho}`}</li>)}</ul>
          <p class="small muted">No se suman a su número de viviendas porque pertenecen a la sociedad, no a la persona.</p>
        </>
      )}

      <h2>Vehículos</h2>
      {p.listaVehiculos.length === 0 ? <p>No declara vehículos.</p> : (
        <ul>{p.listaVehiculos.map((v) => <li>{v.descripcion}{v.anioAdquisicion && <span class="muted"> · adquirido en {v.anioAdquisicion}</span>}</li>)}</ul>
      )}

      {p.notas.length > 0 && (
        <details>
          <summary class="small">Cambios comunicados y notas ({p.notas.length})</summary>
          <ul class="small muted">{p.notas.map((n) => <li>{n}</li>)}</ul>
        </details>
      )}
      <p class="small">Documentos oficiales: {p.fuentes.map((f, i) => <>{i > 0 && ' · '}<a href={f.url} rel="noopener">{f.parcial ? 'modificación' : 'declaración'} de bienes del {fmtFecha(f.fecha)} (PDF) ↗</a></>)}
        {pf?.declaracionesIntereses.map((x) => <> · <a href={x.url} rel="noopener">intereses económicos{x.fecha && ` del ${fmtFecha(x.fecha)}`} (PDF) ↗</a></>)}
        {pf?.declaracionActividades && <> · <a href={pf.declaracionActividades} rel="noopener">declaración de actividades (PDF) ↗</a></>}
      </p>
    </>
  )}

  {dd && (
    <section aria-labelledby="h-deudas">
      <h2 id="h-deudas">Deudas y préstamos</h2>
      {dd.sinDeudas || !dd.principal ? (
        <p>No declara deudas ni préstamos en su declaración de bienes{p.declaracionFecha && ` del ${fmtFecha(p.declaracionFecha)}`}.</p>
      ) : (
        <>
          <p class="small muted">
            Según su {dd.principal.parcial ? 'modificación de la declaración de bienes' : 'declaración de bienes'} del {fmtFecha(dd.principal.fecha)}.
            Los importes se copian tal y como los escribe el diputado.
          </p>
          {dd.principal.aviso && <AvisoDudoso texto={dd.principal.aviso} url={dd.principal.url} nombre={d.nombreCompleto} />}
          {dd.principal.prestamos.length > 0 && (
            <>
              <div class="card stat deuda-total">
                <div class="v">{dd.principal.totalIncompleto && <span class="small">al menos </span>}{fmtEur(dd.principal.totalPendiente)}</div>
                <div class="l">de saldo pendiente en {dd.principal.prestamos.length} {dd.principal.prestamos.length === 1 ? 'préstamo' : 'préstamos'} (suma de la tabla oficial)</div>
                {dd.principal.totalIncompleto && <div class="l">Algún saldo está en blanco o no se puede leer en el original y no se suma.</div>}
              </div>
              <TablaPrestamos prestamos={dd.principal.prestamos} />
            </>
          )}
          {dd.principal.otras && <p><strong>Otras deudas y obligaciones:</strong> {dd.principal.otras}</p>}
          {dd.principal.nota && <p class="small muted">Observación del diputado: «{dd.principal.nota}»</p>}
          {dd.anteriores.length > 0 && (
            <details>
              <summary class="small">Deudas en declaraciones anteriores que siguen vigentes ({dd.anteriores.length})</summary>
              <p class="small muted">Pueden repetir préstamos de la declaración más reciente: no se suman.</p>
              {dd.anteriores.map((a) => (
                <div class="anterior">
                  <p class="small"><a href={a.url} rel="noopener">{a.parcial ? 'Modificación' : 'Declaración'} del {fmtFecha(a.fecha)} (PDF) ↗</a></p>
                  {a.aviso && <AvisoDudoso texto={a.aviso} url={a.url} nombre={d.nombreCompleto} />}
                  {a.prestamos.length > 0 && <TablaPrestamos prestamos={a.prestamos} />}
                  {a.otras && <p class="small"><strong>Otras deudas y obligaciones:</strong> {a.otras}</p>}
                  {a.nota && <p class="small muted">Observación: «{a.nota}»</p>}
                </div>
              ))}
            </details>
          )}
        </>
      )}
      <p class="small muted">Apartado «Deudas y obligaciones patrimoniales» de su declaración oficial. <a href={url('/metodologia#deudas')}>Cómo se obtiene</a>.</p>
    </section>
  )}

  <h2>Retribución del Congreso</h2>
  <div class="table-scroll card" style="padding:0">
    <table>
      <tbody>
        <tr><td>Asignación constitucional</td><td class="num">{fmtEur2(m.asignacion)}/mes</td></tr>
        {m.complementoMesa > 0 && <tr><td>Complemento por cargo en la Mesa</td><td class="num">{fmtEur2(m.complementoMesa)}/mes</td></tr>}
        {m.gastosRepresentacion > 0 && <tr><td>Gastos de representación</td><td class="num">{fmtEur2(m.gastosRepresentacion)}/mes</td></tr>}
        {m.gastosLibreDisposicion > 0 && <tr><td>Gastos de libre disposición</td><td class="num">{fmtEur2(m.gastosLibreDisposicion)}/mes</td></tr>}
        <tr><td>Indemnización por gastos (exenta de IRPF){d.circunscripcion === 'Madrid' && ' · electos por Madrid'}</td><td class="num">{fmtEur2(m.indemnizacion)}/mes</td></tr>
        <tr><th>Total mensual</th><th class="num">{fmtEur2(totalMensual)}</th></tr>
      </tbody>
    </table>
  </div>
  <p class="small muted">
    {d.retribucion.cargosRetribuidos.length ? `Incluye complementos por: ${d.retribucion.cargosRetribuidos.join(', ')}. ` : 'Sin complementos por cargo. '}
    No incluye otros ingresos (por ejemplo, el sueldo de miembro del Gobierno) ni gastos de transporte, que el Congreso paga directamente.{' '}
    <a href={url('/metodologia#retribuciones')}>Cómo se calcula</a>.
  </p>

  {votosDip.length > 0 && (
    <>
      <h2>Votaciones sobre vivienda</h2>
      <ul class="votos">
        {votosDip.map(({ v, voto }) => (
          <li>
            <span class="pill voto" style={`border-color:${colorVoto[voto ?? 'No vota']}`}><span class="dot" style={`background:${colorVoto[voto ?? 'No vota']}`}></span>{voto ?? 'Sin dato'}</span>
            <span><strong>{v.titulo}</strong> <span class="muted small">· {v.tipo} {fmtFecha(v.fecha)} · {v.resultado} · <a href={v.fuenteUrl} rel="noopener">fuente</a></span></span>
          </li>
        ))}
      </ul>
    </>
  )}
</Base>

<style>
  .cabecera { display: flex; gap: 16px; align-items: flex-start; flex-wrap: wrap; }
  .cabecera img { border-radius: 8px; object-fit: cover; background: var(--border); }
  .cabecera > div { flex: 1 1 260px; }
  tr.viv td:first-child { font-weight: 600; }
  @media (max-width: 640px) {
    .tabla-bienes thead { display: none; }
    .tabla-bienes tr { display: block; padding: 12px 16px; border-bottom: 1px solid var(--border); }
    .tabla-bienes tr:last-child { border-bottom: 0; }
    .tabla-bienes td { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; border: 0; padding: 3px 0; text-align: right; font-size: .9rem; }
    .tabla-bienes td.bien { display: block; text-align: left; font-size: 1rem; padding-bottom: 4px; }
    .tabla-bienes td[data-label]::before { content: attr(data-label); color: var(--muted); text-align: left; font-size: .8rem; flex: none; }
  }
  .tag { margin-left: 6px; font-size: .7rem; padding: 0 6px; }
  .votos { list-style: none; padding: 0; display: grid; gap: 8px; }
  .votos li { display: grid; grid-template-columns: 120px 1fr; gap: 10px; align-items: baseline; }
  .votos .voto { justify-self: start; }
  .ok-box { background: color-mix(in srgb, var(--si) 10%, transparent); border-left: 3px solid var(--si); padding: 10px 12px; border-radius: 6px; font-size: .9rem; }
  details { margin-top: 1rem; }
  .resumen-ficha { margin-top: 1.2rem; }
  .deuda-total { display: inline-block; margin: 4px 0 12px; min-width: 260px; }
  .anterior { margin-top: 12px; }
  .perfil { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 12px; margin: 1.4rem 0 .5rem; }
  .perfil .nota-perfil { grid-column: 1 / -1; margin: 0; }
  @media (max-width: 760px) { .perfil { grid-template-columns: minmax(0, 1fr); } }
  .bloque h3 { margin: 0 0 8px; font-size: 1.05rem; }
  .lineas { margin: 0; padding-left: 1.1rem; display: grid; gap: 6px; font-size: .95rem; line-height: 1.45; }
  /* Puede ser largo («Universidad Nacional de Educación a Distancia · pública»): que parta línea en vez de salirse */
  .tipo { display: inline-block; max-width: 100%; white-space: normal; line-height: 1.4; border-radius: 12px; margin: 3px 6px 0 0; font-size: .72rem; padding: 1px 8px; text-decoration: none; vertical-align: 1px; }
  .lineas li > .tipo:first-of-type { margin-left: 4px; }
  .tipo.publica { border-color: color-mix(in srgb, var(--si) 55%, var(--border)); }
  .tipo.privada { border-color: color-mix(in srgb, var(--accent) 60%, var(--border)); }
  .tipo.otro { border-style: dashed; color: var(--muted); }
  /* Siempre en una sola línea; si no cabe, se desliza en horizontal y el fondo gris solo ocupa los botones */
  .filtros-tiempo { margin: 4px 0 14px; flex-wrap: nowrap; max-width: 100%; overflow-x: auto; scrollbar-width: none; }
  .filtros-tiempo::-webkit-scrollbar { display: none; }
  .filtros-tiempo .btn { flex: none; white-space: nowrap; }
  @media (max-width: 520px) { .filtros-tiempo .btn { padding: 6px 8px; font-size: .84rem; } }
  @media (max-width: 370px) { .filtros-tiempo .btn { padding: 6px 6px; font-size: .8rem; } }
  .linea { list-style: none; margin: 0; padding: 0 0 0 4px; border-left: 2px solid var(--border); display: grid; gap: 2px; }
  .linea li[hidden] { display: none; }
  .ev { display: grid; grid-template-columns: 112px minmax(0, 1fr); gap: 4px 14px; padding: 8px 0 8px 18px; position: relative; }
  .ev::before { content: ''; position: absolute; left: -9px; top: 13px; width: 12px; height: 12px; border-radius: 50%; background: var(--surface); border: 3px solid var(--muted); box-sizing: border-box; }
  .ev-legislatura::before, .ev-cargo::before { border-color: var(--accent); }
  .ev-trayectoria::before { border-color: var(--text); }
  .ev-bienes::before, .ev-intereses::before { border-color: var(--si); }
  .ev time { font-variant-numeric: tabular-nums; color: var(--muted); font-size: .88rem; padding-top: 1px; }
  .ev .etq { display: inline-block; font-size: .7rem; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); margin-right: 8px; }
  .ev p { margin: 2px 0 0; }
  @media (max-width: 520px) { .ev { grid-template-columns: minmax(0, 1fr); } }
</style>

<script>
  const chipsT = [...document.querySelectorAll<HTMLButtonElement>('.filtros-tiempo [data-t]')];
  const evs = [...document.querySelectorAll<HTMLLIElement>('.linea .ev')];
  chipsT.forEach((c) => c.addEventListener('click', () => {
    chipsT.forEach((x) => x.setAttribute('aria-pressed', String(x === c)));
    evs.forEach((e) => { e.hidden = !!c.dataset.t && e.dataset.grupo !== c.dataset.t; });
  }));
</script>
