---
import Base from '../layouts/Base.astro';
import { votacionesPleno, pendientes, diputados, grupos, fmtFecha, url, TEMAS, temasDe } from '../lib/data';

/** Clasificación por el tipo de punto del orden del día (campo oficial «titulo» de la votación). */
const claseTipo = (t: string) => (/Decretos-leyes/.test(t) ? 'rdl' : /no de Ley/i.test(t) ? 'pnl' : /Proposici[oó]n(es)? de Ley/i.test(t) ? 'pl' : /Mociones/.test(t) ? 'mocion' : /Dict[aá]menes de Comisiones sobre iniciativas legislativas|totalidad de iniciativas legislativas|Enmiendas del Senado|Avocaci|lectura [uú]nica/i.test(t) ? 'leg' : /Convenios internacionales/.test(t) ? 'int' : 'otro');
const nombreTipo: Record<string, string> = { rdl: 'Decreto-ley', pnl: 'Proposición no de ley', pl: 'Proposición de ley', mocion: 'Moción', leg: 'Tramitación de leyes', int: 'Convenio internacional' };
const favorable = (r: string) => (/Aprobada|Convalidado/.test(r) ? 'si' : 'no');
const busca = (...xs: (string | undefined)[]) => xs.filter(Boolean).join(' ').toLowerCase();
/** Etiqueta corta oficial sin la fecha final: «RDL 8/2026 · alquiler (28/04/2026)» → «RDL 8/2026 · alquiler». */
const corto = (tema: string) => tema.replace(/\s*\(\d{2}\/\d{2}\/\d{4}\)\s*$/, '');
const etDoc: Record<string, string> = { boe: 'BOE', bocg: 'BOCG', ds: 'Diario', votacion: 'Votación' };

const nombreTema = Object.fromEntries(TEMAS.map((t) => [t.id, t.nombre]));
const cuentaTema = Object.fromEntries(TEMAS.map((t) => [t.id, votacionesPleno.filter((v) => temasDe(v).includes(t.id)).length]));
const lista = votacionesPleno.map((v) => ({
  v,
  porGrupo: grupos.map((g) => {
    const ds = diputados.filter((d) => d.grupoCorto === g.corto);
    const c = { 'Sí': 0, 'No': 0, 'Abstención': 0, 'No vota': 0 } as Record<string, number>;
    ds.forEach((d) => { const x = v.votos[String(d.codParlamentario)]; if (x) c[x]++; });
    return { g, c, total: c['Sí'] + c['No'] + c['Abstención'] + c['No vota'] };
  }).filter((x) => x.total > 0),
}));
const pct = (n: number, t: number) => `${((100 * n) / t).toFixed(2)}%`;
const fechas = [...new Set([...votacionesPleno.map((v) => v.fecha), ...pendientes.map((p) => p.fecha)])];
---
<Base title="Votaciones" description="Votaciones del Pleno del Congreso por tema y fecha, con el resultado y el voto de cada grupo según los datos abiertos oficiales.">
  <h1>Votaciones del Pleno</h1>
  <p class="muted lead">
    Qué se votó en el Pleno del Congreso y cuál fue el resultado. Elige un mes o un día en el calendario, o filtra por tema; cada votación se despliega para ver el texto oficial, el voto por grupo y los documentos.
    Los temas se asignan por palabras del título oficial (<a href={url('/metodologia#temas')}>cómo</a>).
  </p>

  <div class="arriba">
    <section class="card calendario" aria-labelledby="cal-mes">
      <div class="cal-cab">
        <button class="btn icono" type="button" id="cal-ant" aria-label="Mes anterior con votaciones">‹</button>
        <h2 id="cal-mes" aria-live="polite"></h2>
        <button class="btn icono" type="button" id="cal-sig" aria-label="Mes siguiente con votaciones">›</button>
      </div>
      <div class="cal-sem" aria-hidden="true"><span>L</span><span>M</span><span>X</span><span>J</span><span>V</span><span>S</span><span>D</span></div>
      <div class="cal-dias" id="cal-dias" role="grid" aria-labelledby="cal-mes"></div>
      <p class="small muted cal-ley"><span><i class="punto si"></i> aprobadas o convalidados</span><span><i class="punto no"></i> rechazadas o derogados</span><span><i class="punto pend"></i> voto pendiente</span><span>El número indica cuántas votaciones hubo ese día.</span></p>
    </section>

    <div class="filtros" role="search" aria-label="Filtrar votaciones">
      <label class="sr-only" for="v-texto">Buscar en las votaciones</label>
      <input type="search" id="v-texto" placeholder="Buscar: alquiler, SOCIMI, ocupación…" autocomplete="off" />
      <div class="chips temas-chips" role="group" aria-label="Tema">
        <button class="chip" type="button" data-f="tema" data-v="" aria-pressed="true">Todos los temas</button>
        {TEMAS.filter((t) => cuentaTema[t.id] > 0).map((t) => <button class="chip" type="button" data-f="tema" data-v={t.id} aria-pressed="false">{t.nombre} <span class="n-chip">{cuentaTema[t.id]}</span></button>)}
      </div>
      <details class="mas-filtros">
        <summary>Más filtros</summary>
        <div class="chips" role="group" aria-label="Tipo de iniciativa">
          <button class="chip" type="button" data-f="tipo" data-v="" aria-pressed="true">Todos los tipos</button>
          <button class="chip" type="button" data-f="tipo" data-v="rdl" aria-pressed="false">Decretos-leyes</button>
          <button class="chip" type="button" data-f="tipo" data-v="pl" aria-pressed="false">Proposiciones de ley</button>
          <button class="chip" type="button" data-f="tipo" data-v="pnl" aria-pressed="false">No de ley</button>
          <button class="chip" type="button" data-f="tipo" data-v="mocion" aria-pressed="false">Mociones</button>
          <button class="chip" type="button" data-f="tipo" data-v="leg" aria-pressed="false">Tramitación de leyes</button>
          <button class="chip" type="button" data-f="tipo" data-v="int" aria-pressed="false">Convenios internacionales</button>
          <button class="chip" type="button" data-f="tipo" data-v="otro" aria-pressed="false">Otros</button>
        </div>
        <div class="chips" role="group" aria-label="Resultado">
          <button class="chip" type="button" data-f="res" data-v="" aria-pressed="true">Cualquier resultado</button>
          <button class="chip" type="button" data-f="res" data-v="si" aria-pressed="false">Aprobadas o convalidados</button>
          <button class="chip" type="button" data-f="res" data-v="no" aria-pressed="false">Rechazadas o derogados</button>
        </div>
        <div class="chips" role="group" aria-label="Votaciones clave">
          <button class="chip" type="button" data-f="clave" data-v="" aria-pressed="true">Todas</button>
          <button class="chip" type="button" data-f="clave" data-v="si" aria-pressed="false">Solo votaciones clave</button>
        </div>
      </details>
      <p class="small muted cuenta"><span id="v-cuenta" aria-live="polite"></span> <button type="button" class="enlace" id="v-todas" hidden>Ver todo el mes</button></p>
    </div>
  </div>

  <div class="lista">
    {pendientes.map((p) => (
      <article class="card votacion pendiente" data-fecha={p.fecha} data-tema="vivienda" data-tipo="rdl" data-res="pend" data-clave="si" data-busca={busca(p.titulo, p.estado, ...(p.contenidos ?? []).flatMap((c) => c.items))}>
        <p class="meta small"><time datetime={p.fecha}>{fmtFecha(p.fecha)}</time><span class="etq">Decreto-ley</span></p>
        <h2>{p.titulo}</h2>
        <p class="resultado"><span class="insignia pend">Voto nominal pendiente</span></p>
        <p class="small">{p.estado}</p>
        {(p.contenidos ?? []).map((c) => (
          <details class="pliegue">
            <summary>{c.etiqueta}</summary>
            <ul>{c.items.map((i) => <li>{i}</li>)}</ul>
            <p class="small muted">Fuente: <a href={c.fuente.url} rel="noopener">{c.fuente.titulo} ↗</a></p>
          </details>
        ))}
        <details class="pliegue">
          <summary>Documentos oficiales</summary>
          <ul class="docs">{p.fuentes.map((f) => <li><a href={f.url} rel="noopener">{f.titulo} ↗</a></li>)}</ul>
        </details>
      </article>
    ))}

    {lista.map(({ v, porGrupo }) => {
      const t = v.totales; const total = t.si + t.no + t.abstencion + t.noVota; const tipo = claseTipo(v.tipo);
      return (
        <article class="card votacion" data-fecha={v.fecha} data-tema={temasDe(v).join(' ')} data-tipo={tipo} data-res={favorable(v.resultado)} data-clave={v.automatica ? '' : 'si'} data-busca={busca(v.titulo, v.tema, v.tipo, v.detalle, v.resultado, ...temasDe(v).map((t) => nombreTema[t]), ...(v.contenido?.items ?? []))}>
          <p class="meta small"><time datetime={v.fecha}>{fmtFecha(v.fecha)}</time><span class="etq">{nombreTipo[tipo] ?? v.tipo.replace(/\.$/, '')}</span>{!v.automatica && <span class="etq clave">Votación clave</span>}</p>
          {v.automatica ? <h2 class="largo">{v.titulo}</h2> : <h2>{corto(v.tema)}</h2>}
          {v.detalle && <p class="detalle small">{v.detalle}</p>}
          <p class="temas small">{temasDe(v).map((t) => <span>{nombreTema[t] ?? t}</span>)}</p>
          <p class="resultado">
            <span class={`insignia ${favorable(v.resultado)}`}>{v.resultado}</span>
            <span class="small"><strong>{t.si}</strong> sí · <strong>{t.no}</strong> no · <strong>{t.abstencion}</strong> abst. · {t.noVota} no vota</span>
          </p>
          <div class="barra" role="img" aria-label={`Sí ${t.si}, No ${t.no}, Abstención ${t.abstencion}, No vota ${t.noVota}`}>
            <span class="b-si" style={`width:${pct(t.si, total)}`}></span><span class="b-no" style={`width:${pct(t.no, total)}`}></span><span class="b-abs" style={`width:${pct(t.abstencion, total)}`}></span><span class="b-nv" style={`width:${pct(t.noVota, total)}`}></span>
          </div>

          <details class="pliegue">
            <summary>Qué se votó</summary>
            <p class="titulo-oficial">{v.titulo}</p>
            <p class="small muted">{v.tipo} Sesión {v.sesion}, votación {v.numeroVotacion}{v.expediente && <> · Expediente <a href={v.expedienteUrl} rel="noopener">{v.expediente} ↗</a></>}</p>
            {v.contenido && (
              <div class="contenido">
                <p class="docs-t">{v.contenido.etiqueta}</p>
                <ul>{v.contenido.items.map((i) => <li>{i}</li>)}</ul>
                <p class="small muted">Fuente: <a href={v.contenido.fuente.url} rel="noopener">{v.contenido.fuente.titulo} ↗</a></p>
              </div>
            )}
          </details>

          <details class="pliegue">
            <summary>Voto por grupo</summary>
            <ul class="grupos" data-g={porGrupo.map(({ g, c }) => [g.corto, c['Sí'], c['No'], c['Abstención'], c['No vota']].join(',')).join(';')}></ul>
            <p class="small muted">Composición actual de cada grupo. <a href={url(`/?votacion=${encodeURIComponent(v.id)}#hemiciclo`)}>Ver esta votación escaño a escaño en el hemiciclo</a>.</p>
          </details>

          <details class="pliegue">
            <summary>Documentos oficiales</summary>
            <ul class="docs">
              {v.documentos.map((d) => <li><span class={`tipo t-${d.tipo ?? 'otro'}`}>{etDoc[d.tipo ?? ''] ?? 'Doc.'}</span><a href={d.url} rel="noopener">{d.titulo} ↗</a></li>)}
              <li><span class="tipo t-json">Datos</span><a href={v.fuenteUrl} rel="noopener">Voto de cada diputado (JSON, datos abiertos) ↗</a></li>
            </ul>
          </details>
        </article>
      );
    })}
  </div>

  <p class="vacio muted" id="v-vacio" hidden>Ninguna votación coincide con el filtro.</p>

  <details class="card glosario">
    <summary>Glosario de procedimiento</summary>
    <ul class="small">
      <li><strong>Convalidación o derogación de Reales Decretos-leyes:</strong> el Congreso decide si un decreto-ley del Gobierno sigue en vigor (convalidación) o queda derogado (art. 86 de la Constitución).</li>
      <li><strong>Toma en consideración de Proposiciones de Ley:</strong> el Pleno decide si una propuesta de ley presentada por grupos parlamentarios empieza a tramitarse (art. 126 del Reglamento del Congreso).</li>
      <li><strong>Proposiciones no de Ley:</strong> propuestas sin rango de ley en las que la Cámara fija posición o insta al Gobierno (arts. 193 a 195 del Reglamento del Congreso).</li>
    </ul>
  </details>
  <p class="small muted">Los votos son los publicados en los <a href="https://www.congreso.es/es/opendata/votaciones">datos abiertos del Congreso</a>; los textos, los oficiales del BOE y del BOCG.</p>
</Base>

<script type="application/json" id="v-fechas" set:html={JSON.stringify(fechas)} />
<script type="application/json" id="v-colores" set:html={JSON.stringify(Object.fromEntries(grupos.map((g) => [g.corto, g.color])))} />

<script>
  const cards = [...document.querySelectorAll<HTMLElement>('article.votacion')];
  const texto = document.getElementById('v-texto') as HTMLInputElement;
  const cuenta = document.getElementById('v-cuenta')!;
  const todas = document.getElementById('v-todas') as HTMLButtonElement;
  const vacio = document.getElementById('v-vacio')!;
  const estado: Record<string, string> = { tema: '', tipo: '', res: '', clave: '', dia: '' };
  const norm = (x: string) => x.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
  const fechaLarga = (iso: string) => new Date(iso + 'T12:00:00').toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });

  const busqueda = () => norm(texto.value.trim());
  /** Filtros de tema, tipo, resultado y texto (sin fecha). */
  function porFiltros() {
    const q = busqueda();
    return cards.filter((c) =>
      (!estado.tema || (c.dataset.tema ?? '').split(' ').includes(estado.tema)) &&
      (!estado.tipo || c.dataset.tipo === estado.tipo) &&
      (!estado.res || c.dataset.res === estado.res) &&
      (!estado.clave || c.dataset.clave === estado.clave) &&
      (!q || norm(c.dataset.busca ?? '').includes(q)));
  }
  // Sin búsqueda de texto, la lista muestra el mes del calendario (o el día elegido); con búsqueda, todos los meses
  function visibles() {
    const base = porFiltros();
    if (estado.dia) return base.filter((c) => c.dataset.fecha === estado.dia);
    if (busqueda()) return base;
    return base.filter((c) => (c.dataset.fecha ?? '').startsWith(mes));
  }
  const nombreMes = (m: string) => new Date(+m.slice(0, 4), +m.slice(5, 7) - 1, 1).toLocaleDateString('es-ES', { month: 'long', year: 'numeric' });
  function aplicar() {
    const ok = new Set(visibles());
    cards.forEach((c) => { c.hidden = !ok.has(c); });
    const n = ok.size; const v = n === 1 ? 'votación' : 'votaciones';
    cuenta.textContent = estado.dia ? `${n} ${v} el ${fechaLarga(estado.dia)}` : busqueda() ? `${n} ${v} en todos los meses` : `${n} ${v} en ${nombreMes(mes)}`;
    todas.hidden = !estado.dia;
    vacio.hidden = n > 0;
    pintarCalendario();
  }

  // Calendario: solo se navega entre meses que tienen votaciones
  const fechas = JSON.parse(document.getElementById('v-fechas')!.textContent!) as string[];
  const meses = [...new Set(fechas.map((f) => f.slice(0, 7)))].sort();
  let mes = meses[meses.length - 1];
  const tituloMes = document.getElementById('cal-mes')!;
  const dias = document.getElementById('cal-dias')!;
  const ant = document.getElementById('cal-ant') as HTMLButtonElement;
  const sig = document.getElementById('cal-sig') as HTMLButtonElement;

  function pintarCalendario() {
    const [a, m] = mes.split('-').map(Number);
    const nombre = new Date(a, m - 1, 1).toLocaleDateString('es-ES', { month: 'long', year: 'numeric' });
    tituloMes.textContent = nombre.charAt(0).toUpperCase() + nombre.slice(1);
    const enFiltro = porFiltros();
    const primero = (new Date(a, m - 1, 1).getDay() + 6) % 7;
    const n = new Date(a, m, 0).getDate();
    let html = '<span></span>'.repeat(primero);
    for (let d = 1; d <= n; d++) {
      const iso = `${mes}-${String(d).padStart(2, '0')}`;
      const delDia = enFiltro.filter((c) => c.dataset.fecha === iso);
      if (!delDia.length) { html += `<span class="dia">${d}</span>`; continue; }
      // Mini barra: proporción de votaciones aprobadas (verde), rechazadas (rojo) y pendientes (gris)
      const n = (r: string) => delDia.filter((c) => c.dataset.res === r).length;
      const puntos = delDia.length === 1 ? `<i class="punto ${delDia[0].dataset.res}"></i>`
        : `<span class="mini">${['si', 'no', 'pend'].map((r) => n(r) ? `<i class="${r}" style="flex:${n(r)}"></i>` : '').join('')}</span><span class="cnt">${delDia.length}</span>`;
      html += `<button type="button" class="dia con" data-dia="${iso}" aria-pressed="${estado.dia === iso}" aria-label="${fechaLarga(iso)}: ${delDia.length} ${delDia.length === 1 ? 'votación' : 'votaciones'}">${d}<span class="puntos">${puntos}</span></button>`;
    }
    dias.innerHTML = html;
    const i = meses.indexOf(mes);
    ant.disabled = i <= 0; sig.disabled = i >= meses.length - 1;
  }
  dias.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-dia]');
    if (!b) return;
    estado.dia = estado.dia === b.dataset.dia ? '' : b.dataset.dia!;
    aplicar();
  });
  ant.addEventListener('click', () => { const i = meses.indexOf(mes); if (i > 0) { mes = meses[i - 1]; estado.dia = ''; aplicar(); } });
  sig.addEventListener('click', () => { const i = meses.indexOf(mes); if (i < meses.length - 1) { mes = meses[i + 1]; estado.dia = ''; aplicar(); } });
  todas.addEventListener('click', () => { estado.dia = ''; aplicar(); });

  document.querySelectorAll<HTMLButtonElement>('.chip').forEach((b) => b.addEventListener('click', () => {
    estado[b.dataset.f!] = b.dataset.v!;
    document.querySelectorAll<HTMLButtonElement>(`.chip[data-f="${b.dataset.f}"]`).forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
    aplicar();
  }));
  texto.addEventListener('input', aplicar);

  // El voto por grupo se dibuja al abrir el desplegable (así la página pesa mucho menos)
  const colores = JSON.parse(document.getElementById('v-colores')!.textContent!) as Record<string, string>;
  const pct = (n: number, t: number) => `${((100 * n) / t).toFixed(2)}%`;
  document.querySelectorAll<HTMLUListElement>('ul.grupos[data-g]').forEach((ul) => {
    ul.closest('details')!.addEventListener('toggle', () => {
      if (ul.childElementCount) return;
      ul.innerHTML = ul.dataset.g!.split(';').map((f) => {
        const [g, ...xs] = f.split(','); const [si, no, ab, nv] = xs.map(Number); const t = si + no + ab + nv;
        const txt = [si && `${si} sí`, no && `${no} no`, ab && `${ab} abst.`, nv && `${nv} no vota`].filter(Boolean).join(' · ');
        return `<li><span class="g"><span class="dot" style="background:${colores[g]}"></span>${g}</span>`
          + `<span class="barra fina" role="img" aria-label="${g}: ${txt}"><span class="b-si" style="width:${pct(si, t)}"></span><span class="b-no" style="width:${pct(no, t)}"></span><span class="b-abs" style="width:${pct(ab, t)}"></span><span class="b-nv" style="width:${pct(nv, t)}"></span></span>`
          + `<span class="n small">${txt}</span></li>`;
      }).join('');
    });
  });
  aplicar();
</script>

<style>
  .lead { max-width: 62ch; }
  .arriba { display: grid; grid-template-columns: minmax(0, 340px) minmax(0, 1fr); gap: 20px; align-items: start; margin: 18px 0 8px; }
  @media (max-width: 760px) { .arriba { grid-template-columns: minmax(0, 1fr); } }

  .calendario { padding: 12px 14px; }
  .cal-cab { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .cal-cab h2 { margin: 0; font-size: 1.05rem; }
  .btn.icono { min-height: 40px; width: 40px; padding: 0; font-size: 1.3rem; line-height: 1; }
  .btn.icono:disabled { opacity: .35; cursor: default; }
  .cal-sem, .cal-dias { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 3px; text-align: center; }
  .cal-sem { margin: 10px 0 4px; font-size: .72rem; color: var(--muted); font-weight: 650; }
  .cal-dias :global(.dia) { aspect-ratio: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; font-size: .85rem; color: var(--muted); border-radius: 8px; }
  .cal-dias :global(button.dia) { border: 1px solid var(--border); background: var(--surface); color: var(--text); font-weight: 650; cursor: pointer; padding: 0; gap: 2px; }
  .cal-dias :global(button.dia:hover) { border-color: var(--accent); }
  .cal-dias :global(button.dia[aria-pressed='true']) { background: var(--accent-soft); border-color: var(--accent); color: var(--accent-text); box-shadow: 0 0 0 2px var(--accent); }
  .cal-dias :global(.puntos) { display: flex; flex-direction: column; align-items: center; gap: 1px; width: 70%; }
  .cal-dias :global(.mini) { display: flex; width: 100%; height: 5px; border-radius: 3px; overflow: hidden; }
  .cal-dias :global(.mini i.si) { background: var(--si); } .cal-dias :global(.mini i.no) { background: var(--no); } .cal-dias :global(.mini i.pend) { background: var(--novota); }
  .cal-dias :global(.cnt) { font-size: .62rem; font-weight: 600; color: var(--muted); line-height: 1; }
  .cal-ley { margin: 10px 0 0; display: flex; flex-wrap: wrap; align-items: center; gap: 2px 12px; }
  .cal-ley span { white-space: nowrap; }
  @media (max-width: 760px) { .cal-dias :global(.dia) { aspect-ratio: auto; height: 38px; } }
  :global(.punto) { display: inline-block; width: 7px; height: 7px; border-radius: 50%; }
  :global(.punto.si) { background: var(--si); } :global(.punto.no) { background: var(--no); } :global(.punto.pend) { background: var(--novota); }

  .filtros { display: grid; gap: 10px; align-content: start; }
  .filtros input { width: 100%; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .chip { border: 1px solid var(--border); background: var(--surface); border-radius: 999px; padding: 6px 14px; min-height: 38px; cursor: pointer; font-size: .9rem; color: var(--muted); transition: border-color .15s, color .15s, background-color .15s; }
  .chip:hover { border-color: var(--accent); color: var(--accent-text); }
