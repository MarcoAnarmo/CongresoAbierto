---
import Base from '../../layouts/Base.astro';
import BotonesTarjeta from '../../components/BotonesTarjeta.astro';
import { diputados, votaciones, url, slug, fmtFecha } from '../../lib/data';
import { rutaTarjeta, circunscripciones, temaCorto } from '../../lib/tarjetas';

const vots = [...votaciones].sort((a, b) => b.fecha.localeCompare(a.fecha));
const dips = [...diputados].sort((a, b) => a.apellidos.localeCompare(b.apellidos, 'es'));
---
<Base title="Tarjetas para compartir" imagen={rutaTarjeta.pagina('tarjetas')} description="Tarjetas con datos oficiales de diputados, votaciones y provincias, en formato vertical para historias y horizontal para enlaces.">
  <h1>Tarjetas para compartir</h1>
  <p class="lead">
    Imágenes con datos oficiales, listas para historias de Instagram, estados de WhatsApp o cualquier red.
    Se descargan en vertical (1080 × 1920); debajo de cada una tienes también la versión horizontal.
  </p>

  <h2>El Congreso en cifras</h2>
  <div class="rejilla">
    <figure class="tarjeta">
      <img src={url(rutaTarjeta.resumen('historia'))} alt="Tarjeta con las cifras de propiedades y viviendas declaradas por los 350 diputados" width="270" height="480" loading="lazy" />
      <figcaption><BotonesTarjeta historia={rutaTarjeta.resumen('historia')} horizontal={rutaTarjeta.resumen('horizontal')} nombre="congreso-abierto-resumen" /></figcaption>
    </figure>
  </div>

  <h2>Votaciones</h2>
  <div class="rejilla">
    {vots.map((v) => (
      <figure class="tarjeta">
        <img src={url(rutaTarjeta.votacion(v, 'historia'))} alt={`Tarjeta de la votación ${temaCorto(v.tema)} del ${fmtFecha(v.fecha)}: ${v.resultado}`} width="270" height="480" loading="lazy" />
        <figcaption>
          <p class="small"><strong>{temaCorto(v.tema)}</strong><br /><span class="muted">{fmtFecha(v.fecha)}</span></p>
          <BotonesTarjeta historia={rutaTarjeta.votacion(v, 'historia')} horizontal={rutaTarjeta.votacion(v, 'horizontal')} nombre={`congreso-abierto-${v.id}`} />
        </figcaption>
      </figure>
    ))}
  </div>

  <h2>Tu provincia</h2>
  <label class="sr-only" for="t-prov">Elige una provincia</label>
  <select id="t-prov" class="selector" data-grupo="prov">
    {circunscripciones.map((c) => <option value={c.id} selected={c.id === 'madrid'}>{c.legible}</option>)}
  </select>
  <div class="rejilla">
    {circunscripciones.map((c) => (
      <figure class="tarjeta" data-prov={c.id} hidden={c.id !== 'madrid'}>
        <img src={url(rutaTarjeta.provincia(c.id, 'historia'))} alt={`Tarjeta de los diputados elegidos por ${c.legible}`} width="270" height="480" loading="lazy" />
        <figcaption><BotonesTarjeta historia={rutaTarjeta.provincia(c.id, 'historia')} horizontal={rutaTarjeta.provincia(c.id, 'horizontal')} nombre={`congreso-abierto-${c.id}`} /></figcaption>
      </figure>
    ))}
  </div>

  <h2>Un diputado o diputada</h2>
  <p class="small muted">También la tienes en la <a href={url('/ranking')}>ficha de cada diputado</a>.</p>
  <label class="sr-only" for="t-dip">Elige un diputado</label>
  <select id="t-dip" class="selector" data-grupo="dip">
    <option value="">Elige un diputado…</option>
    {dips.map((d) => <option value={slug(d)}>{d.apellidos}, {d.nombre} ({d.grupoCorto})</option>)}
  </select>
  <div class="rejilla">
    {dips.map((d) => (
      <figure class="tarjeta" data-dip={slug(d)} hidden>
        <img src={url(rutaTarjeta.diputado(d, 'historia'))} alt={`Tarjeta de ${d.nombreCompleto}`} width="270" height="480" loading="lazy" />
        <figcaption><BotonesTarjeta historia={rutaTarjeta.diputado(d, 'historia')} horizontal={rutaTarjeta.diputado(d, 'horizontal')} nombre={`congreso-abierto-${slug(d)}`} /></figcaption>
      </figure>
    ))}
  </div>
</Base>

<script>
  document.querySelectorAll<HTMLSelectElement>('select.selector').forEach((sel) => {
    const g = sel.dataset.grupo!;
    sel.addEventListener('change', () => {
      document.querySelectorAll<HTMLElement>(`figure[data-${g}]`).forEach((f) => { f.hidden = f.dataset[g] !== sel.value; });
    });
  });
</script>

<style>
  .lead { max-width: 62ch; }
  .rejilla { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 20px; margin-top: 14px; }
  .tarjeta { margin: 0; display: flex; flex-direction: column; gap: 10px; }
  .tarjeta[hidden] { display: none; }
  .tarjeta img { width: 100%; max-width: 300px; height: auto; aspect-ratio: 9 / 16; border-radius: 14px; border: 1px solid var(--border); background: var(--chip); }
  .tarjeta figcaption p { margin: 0 0 6px; }
  .selector { width: 100%; max-width: 360px; }
</style>
