---
import Base from '../../layouts/Base.astro';
import Hemiciclo from '../../components/Hemiciclo.astro';
import { antesDeElecciones } from '../../lib/data';
import BotonCompartir from '../../components/BotonCompartir.astro';
import DialogoCompartir from '../../components/DialogoCompartir.astro';
import { rutasIdioma, idiomaDe } from '../../i18n';
import comun from '../../i18n/textos/comun';
import portada from '../../i18n/textos/portada';

export const getStaticPaths = rutasIdioma;
const lang = idiomaDe(Astro.params.lang);
const c = comun[lang];
const t = portada[lang];
---
<Base title="Congreso Abierto">
  <div class="portada-cab">
    {antesDeElecciones() && <p class="elecciones"><span class="e-punto" aria-hidden="true"></span><span class="e-largo">{c.elecciones.texto}</span><span class="e-corto">{c.elecciones.etiqueta}</span><span class="e-mini">{c.elecciones.mini}</span></p>}
    <BotonCompartir resumen class="compartir-portada" />
  </div>
  <h1>{c.marca.lema}</h1>
  <p class="lema">{c.marca.subtitulo}</p>
  <script is:inline>
    // Móvil: lema y subtítulo en una sola línea cada uno; el tamaño de letra se ajusta al ancho real de la pantalla
    // (depende de la fuente del sistema). Si haría falta una letra demasiado pequeña, se parte en dos líneas equilibradas.
    (function () {
      var piezas = [[document.querySelector('main h1'), 30, 18], [document.querySelector('main .lema'), 17, 13]];
      // No basta con una regla de tres: la fuente del sistema (San Francisco en Apple) cambia el espaciado
      // entre letras según el tamaño. Se reduce y se vuelve a medir hasta que el texto cabe de verdad.
      // Ancho real del texto (con decimales); scrollWidth redondea y nunca es menor que el ancho de la caja
      function sobra(el) { var r = document.createRange(); r.selectNodeContents(el); return r.getBoundingClientRect().width > el.clientWidth - 1; }
      function ajustar() {
        var movil = matchMedia('(max-width: 720px)').matches;
        piezas.forEach(function (p) {
          var el = p[0], max = p[1], min = p[2];
          el.style.fontSize = ''; el.style.whiteSpace = '';
          if (!movil) return;
          el.style.whiteSpace = 'nowrap';
          var f = max, n = 0;
          el.style.fontSize = f + 'px';
          while (sobra(el) && f > min && n++ < 40) {
            f = Math.max(min, Math.min(f - 0.25, Math.floor((f * (el.clientWidth - 1) / el.scrollWidth) * 4) / 4));
            el.style.fontSize = f + 'px';
          }
          if (sobra(el)) { el.style.fontSize = ''; el.style.whiteSpace = ''; }
        });
      }
      ajustar();
      addEventListener('resize', ajustar);
      if (document.fonts) { document.fonts.ready.then(ajustar); document.fonts.addEventListener('loadingdone', ajustar); }
    })();
  </script>
  <p class="lead largo">{t.leadLargo}</p>
  <!-- Móvil: texto corto para que el hemiciclo se vea entero nada más entrar -->
  <p class="lead corto">{t.leadCorto}</p>

  <Hemiciclo />
  <DialogoCompartir />
</Base>

<script>
  import { prefijo } from '../../i18n/cliente';
  // El mapa por provincias está ahora en Diputados: los enlaces antiguos a /#mapa siguen funcionando
  if (location.hash === '#mapa') location.replace(`${prefijo()}/diputados?vista=mapa`);
</script>

<style>
  .lead { max-width: 92ch; }
  .lema { margin: -.2rem 0 .5rem; font-size: clamp(1.05rem, 2.8vw, 1.25rem); font-weight: 650; color: var(--accent-text); }
  .lead.corto { display: none; }
  /* Fila de arriba: etiqueta de las elecciones a la izquierda y el botón de compartir en la esquina derecha */
  .portada-cab { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 40px; margin: 0 0 .5rem; }
  .portada-cab .elecciones { margin: 0; min-width: 0; max-width: 100%; overflow: hidden; }
  .portada-cab .elecciones span:not(.e-punto) { overflow: hidden; text-overflow: ellipsis; }
  .portada-cab :global(.compartir-portada) { margin-left: auto; flex: none; }
  .elecciones { display: inline-flex; align-items: center; gap: 8px; margin: 0 0 .7rem; padding: 4px 12px; border-radius: 999px; background: var(--accent-soft); color: var(--accent-text); font-size: .85rem; font-weight: 650; }
  .e-corto, .e-mini { display: none; }
  .e-punto { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); flex: none; }
  @media (max-width: 720px) {
    .lead.largo { display: none; }
    .lead.corto { display: block; margin: .5rem 0 .9rem; font-size: .95rem; line-height: 1.5; text-wrap: pretty; }
    /* El tamaño exacto lo ajusta el script de arriba para que cada uno quepa en una línea */
    h1 { margin: 0 0 .2rem; letter-spacing: -.025em; text-wrap: balance; }
    .lema { margin: 0; font-size: .95rem; line-height: 1.35; text-wrap: balance; }
    .elecciones { font-size: .8rem; white-space: nowrap; }
    .portada-cab { margin-bottom: .35rem; min-height: 36px; }
    @media (max-width: 370px) { .e-corto { display: none !important; } .e-mini { display: inline; } }
    .portada-cab :global(.compartir-portada) { width: 36px; height: 36px; }
    .portada-cab :global(.compartir-portada svg) { width: 17px; height: 17px; }
    .e-largo { display: none; }
    .e-corto { display: inline; }
  }
</style>
