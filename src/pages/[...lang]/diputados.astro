---
import Base from '../../layouts/Base.astro';
import { diputados, resumen, grupos, colorGrupo, slug, etiquetaPartido, meta } from '../../lib/data';
import MapaProvincias from '../../components/MapaProvincias.astro';
import type { Diputado } from '../../lib/types';
import BotonCompartir from '../../components/BotonCompartir.astro';
import DialogoCompartir from '../../components/DialogoCompartir.astro';
import HojaFiltros from '../../components/HojaFiltros.astro';
import Icono from '../../components/Icono.astro';
import { rutasIdioma, idiomaDe, enlace, formatos, f, pl } from '../../i18n';
import textos from '../../i18n/textos/diputados';
import comun from '../../i18n/textos/comun';
import { sinTildes as quitarTildes } from '../../lib/texto';
import { TIPOS_ENTIDAD, RELACIONES, claveEntidad } from '../../lib/vinculos';
import { resumenInversiones } from '../../lib/inversiones';

export const getStaticPaths = rutasIdioma;
const lang = idiomaDe(Astro.params.lang);
const t = textos[lang];
const palabras = comun[lang].palabras;
const { num: fmtNum, fecha: fmtFecha, comparar } = formatos(lang);
const u = (p: string) => enlace(p, lang);

const filas = [...diputados].sort((a, b) =>
  (b.patrimonio.propiedades ?? -1) - (a.patrimonio.propiedades ?? -1) ||
  (b.patrimonio.viviendas ?? -1) - (a.patrimonio.viviendas ?? -1) ||
  comparar(a.apellidos, b.apellidos));
const porGrupo = [...resumen].sort((a, b) => b.propiedades - a.propiedades || b.viviendas - a.viviendas);
const max = Math.max(...porGrupo.map((g) => g.propiedades));
const provincias = [...new Set(diputados.map((d) => d.circunscripcion))].sort(comparar);
// Cifras de todo el Congreso (vista «Por grupo»)
const conDatos = diputados.filter((d) => d.patrimonio.viviendas !== null);
const totalProp = conDatos.reduce((a, d) => a + (d.patrimonio.propiedades ?? 0), 0);
const totalViv = conDatos.reduce((a, d) => a + (d.patrimonio.viviendas ?? 0), 0);
const pct = (n: number) => f(t.grupos.pct, { n: Math.round((100 * n) / conDatos.length) });
const conVivienda = conDatos.filter((d) => (d.patrimonio.viviendas ?? 0) > 0).length;
const tresOMas = conDatos.filter((d) => (d.patrimonio.viviendas ?? 0) >= 3).length;
const alfabetico = [...diputados].sort((a, b) => comparar(a.apellidos, b.apellidos));
const etTipo = t.tipo;
const formacionCorta = (d: Diputado) => d.perfil?.formacion[0]?.texto ?? null;
const nLeg = (d: Diputado) => d.perfil?.legislaturas.length ?? 0;
const conAviso = (d: Diputado) => !!(d.deudas?.principal?.aviso || d.deudas?.anteriores.some((x) => x.aviso));
// Texto en el que se busca: nombre, provincia, partido, grupo (corto y oficial), cargos, formación y trayectoria, sin tildes
// (son datos oficiales: se busca en castellano en todos los idiomas)
const sinTildes = (s: string) => quitarTildes(s).toLowerCase();
const busca = (d: Diputado) => sinTildes([d.nombreCompleto, d.circunscripcion, d.partido, d.grupoCorto, grupos.find((g) => g.corto === d.grupoCorto)?.nombre ?? '', ...d.cargos, ...(d.perfil?.formacion.map((x) => x.texto) ?? []), ...(d.perfil?.trayectoria ?? [])].join(' '));
/**
 * Empresas y entidades de cada diputado para filtrar y ordenar (data-vc): un código por entidad y relación,
 * «entidad.tipo.relación.remuneración» (índices de TIPOS_ENTIDAD y RELACIONES; remuneración s/n/d/c o x si el documento no lo dice).
 * Las sociedades del BORME que ya están en sus documentos cuentan como la misma entidad.
 */
const REM: Record<string, string> = { si: 's', no: 'n', dietas: 'd', complemento: 'c' };
const ES_PUBLICA = /\b(municipal|municipals|municipales|provincial|sme|estatal|mixta|insular|metropolita|publica|publics)\b/i;
function codigosVinculos(d: Diputado): string {
  const v = d.vinculos;
  if (!v) return '';
  const idx = new Map<string, number>();
  const cods = new Set<string>();
  v.entidades.forEach((e, i) => {
    idx.set(claveEntidad(e.nombre), i);
    for (const a of e.apariciones) cods.add(`${i}.${TIPOS_ENTIDAD.indexOf(e.tipo)}.${RELACIONES.indexOf(a.relacion)}.${(a.remuneracion && REM[a.remuneracion]) || 'x'}`);
  });
  v.borme.forEach((b, j) => {
    const i = idx.get(claveEntidad(b.nombre)) ?? v.entidades.length + j;
    const tipo = b.confirmacion === 'cargo-publico' || ES_PUBLICA.test(quitarTildes(b.nombre)) ? 'publica' : 'empresa';
    cods.add(`${i}.${TIPOS_ENTIDAD.indexOf(tipo)}.${RELACIONES.indexOf('borme')}.x`);
  });
  return [...cods].join(' ');
}
const tv = comun[lang].vinculos;
/**
 * Acciones y fondos (tabla «Deuda pública, obligaciones, acciones y participaciones» de la declaración de bienes):
 * total de la tabla (data-itot), euros de las filas que mencionan acciones (data-iac) o fondos (data-ifo) y qué menciona (data-inv).
 * -1 si no hay declaración. Solo se suman importes legibles.
 */
function datosInversion(d: Diputado) {
  const fz = d.finanzas;
  if (!fz) return { 'data-itot': -1, 'data-iac': -1, 'data-ifo': -1, 'data-inv': '' };
  const filas = fz.valores?.filas ?? [];
  const r = resumenInversiones(filas);
  const inv = [filas.length ? 'v' : 'no', r.nAcciones ? 'a' : '', r.nFondos ? 'f' : ''].filter(Boolean).join(' ');
  return { 'data-itot': Math.round(fz.valores?.total ?? 0), 'data-iac': r.acciones, 'data-ifo': r.fondos, 'data-inv': inv };
}
const datos = (d: Diputado) => ({
  'data-id': slug(d), 'data-n': d.apellidos, 'data-busca': busca(d), 'data-g': d.grupoCorto, 'data-c': d.circunscripcion, 'data-f': d.perfil?.tipoFormacion ?? 'sin-datos',
  'data-pr': d.patrimonio.propiedades ?? -1, 'data-v': d.patrimonio.viviendas ?? -1, 'data-co': d.patrimonio.vehiculos ?? -1, 'data-r': d.retribucion.totalMensual, 'data-l': nLeg(d),
  'data-vc': codigosVinculos(d), 'data-vin': 0, ...datosInversion(d),
});
const c = t.col;
const columnas = [
  { k: 'pr', t: c.propiedades, corto: c.propiedadesCorto },
  { k: 'v', t: c.viviendas, corto: c.viviendasCorto },
  { k: 'co', t: c.vehiculos, corto: c.vehiculosCorto },
  { k: 'r', t: c.retribucion, corto: c.retribucionCorto },
];
const ruct = `<a href="https://www.educacion.gob.es/ruct/consultauniversidades?actual=universidades" rel="noopener">${t.formacion.ruct}</a>`;
---
<Base title={t.titulo} description={t.descripcion}>
  <h1>{t.titulo}</h1>
  <p class="lead">
    {t.lead}{' '}
    <span class="lead-mas">{t.leadMas}</span>
  </p>

  <div class="vista-barra">
    <div class="segmentado" role="group" aria-label={t.vistas.aria}>
      <button class="btn" type="button" data-vista="tarjetas" aria-pressed="true"><Icono n="fichas" tam={19} /><span>{t.vistas.fichas}</span></button>
      <button class="btn" type="button" data-vista="tabla" aria-pressed="false"><Icono n="tabla" tam={19} /><span class="largo">{t.vistas.tabla}</span><span class="corto">{t.vistas.tablaCorto}</span></button>
      <button class="btn" type="button" data-vista="grupos" aria-pressed="false"><Icono n="grupos" tam={19} /><span class="largo">{t.vistas.grupos}</span><span class="corto">{t.vistas.gruposCorto}</span></button>
      <button class="btn" type="button" data-vista="mapa" aria-pressed="false"><Icono n="mapa" tam={19} /><span class="largo">{t.vistas.mapa}</span><span class="corto">{t.vistas.mapaCorto}</span></button>
    </div>
  </div>
  <div class="filtros" id="filtros" role="search" aria-label={t.filtros.aria}>
    <label class="sr-only" for="f-texto">{t.filtros.buscar}</label>
    <input type="search" id="f-texto" placeholder={t.filtros.placeholder} autocomplete="off" />
    <button class="btn boton-filtrar" type="button" id="abrir-filtros" aria-haspopup="dialog" aria-controls="dlg-filtros"><Icono n="filtros" tam={19} /><span>{t.filtros.filtrar}</span><span class="n-filtros" id="n-filtros" hidden></span></button>
    <div class="filtros-mas" id="filtros-mas">
    <label class="sr-only" for="f-grupo">{t.filtros.grupo}</label>
    <select id="f-grupo">
      <option value="">{t.filtros.todosGrupos}</option>
      {grupos.map((g) => <option value={g.corto}>{g.corto}</option>)}
    </select>
    <label class="sr-only" for="f-prov">{t.filtros.provincia}</label>
    <select id="f-prov">
      <option value="">{t.filtros.todasProvincias}</option>
      {provincias.map((p) => <option value={p}>{p}</option>)}
    </select>
    <label class="sr-only" for="f-form">{t.filtros.formacion}</label>
    <select id="f-form">
      <option value="">{t.filtros.todaFormacion}</option>
      <option value="publica">{t.filtros.publica}</option>
      <option value="privada">{t.filtros.privada}</option>
      <option value="ambas">{t.filtros.ambas}</option>
      <option value="sin-centro">{t.filtros.sinCentro}</option>
      <option value="sin-datos">{t.filtros.sinDatos}</option>
    </select>
    <label class="sr-only" for="f-inv">{t.filtros.inv}</label>
    <select id="f-inv">
      <option value="">{t.filtros.todaInversion}</option>
      <option value="a">{t.filtros.invAcciones}</option>
      <option value="f">{t.filtros.invFondos}</option>
      <option value="v">{t.filtros.invAlguno}</option>
      <option value="no">{t.filtros.invNinguno}</option>
    </select>
    <label class="sr-only" for="f-vtipo">{t.filtros.vtipo}</label>
    <select id="f-vtipo">
      <option value="">{t.filtros.todasEntidades}</option>
      {TIPOS_ENTIDAD.map((x, i) => <option value={String(i)}>{tv.tipos[x]}</option>)}
    </select>
    <label class="sr-only" for="f-vrel">{t.filtros.vrel}</label>
    <select id="f-vrel">
      <option value="">{t.filtros.todasRelaciones}</option>
      {RELACIONES.map((x, i) => <option value={String(i)}>{tv.relaciones[x]}</option>)}
    </select>
    <label class="sr-only" for="f-vrem">{t.filtros.vrem}</label>
    <select id="f-vrem">
      <option value="">{t.filtros.todaRemuneracion}</option>
      <option value="s">{tv.remuneracion.si}</option>
      <option value="n">{tv.remuneracion.no}</option>
      <option value="d">{tv.remuneracion.dietas}</option>
      <option value="c">{tv.remuneracion.complemento}</option>
      <option value="x">{tv.remuneracion.nc}</option>
    </select>
    <label class="sr-only" for="f-orden">{t.filtros.ordenar}</label>
    <select id="f-orden">
      <option value="n">{t.filtros.orden.n}</option>
      <option value="l">{t.filtros.orden.l}</option>
      <option value="pr">{t.filtros.orden.pr}</option>
      <option value="v">{t.filtros.orden.v}</option>
      <option value="co">{t.filtros.orden.co}</option>
      <option value="r">{t.filtros.orden.r}</option>
      <option value="itot">{t.filtros.orden.itot}</option>
      <option value="iac">{t.filtros.orden.iac}</option>
      <option value="ifo">{t.filtros.orden.ifo}</option>
      <option value="vin">{t.filtros.orden.vin}</option>
    </select>
    </div>
    <span class="small muted cuenta" id="f-cuenta" aria-live="polite"></span>
  </div>
  <p class="small muted nota-vin" id="nota-inv" hidden>{t.filtros.notaInversion}<a href={u('/metodologia#rentas')}>{t.formacion.comoSeObtiene}</a>.</p>
  <p class="small muted nota-vin" id="nota-vin" hidden>{t.filtros.notaVinculos}<a href={u('/metodologia#entidades')}>{t.formacion.comoSeObtiene}</a>.</p>
  <HojaFiltros id="dlg-filtros" titulo={t.filtros.titulo} quitar={{ id: 'quitar-filtros', texto: t.filtros.quitar }} ver={{ id: 'ver-resultados', texto: t.filtros.verResultados }} />

  <ul class="tarjetas" id="tarjetas">
    {alfabetico.map((d) => (
      <li class="tarjeta" {...datos(d)} style={`--g:${colorGrupo(d.grupoCorto)}`}>
        <a href={u(`/diputado/${slug(d)}`)}>
          <img src={d.fotoUrl} alt="" width="64" height="80" loading="lazy" referrerpolicy="no-referrer" />
          <span class="t-cuerpo">
            <strong class="t-nombre">{d.nombreCompleto}</strong>
            <span class="t-sub"><span class="dot" style={`background:${colorGrupo(d.grupoCorto)}`}></span> {etiquetaPartido(d, lang)} · {d.circunscripcion}</span>
            <span class="t-form">{formacionCorta(d) ?? <span class="muted">{t.ficha.sinEstudios}</span>}</span>
            <span class="t-pie">
              {d.perfil && etTipo[d.perfil.tipoFormacion] && <span class={`pill tipo ${d.perfil.tipoFormacion}`}>{etTipo[d.perfil.tipoFormacion]}</span>}
              {nLeg(d) > 0 && <span class="pill">{pl(nLeg(d), t.ficha.legislaturas, lang)}</span>}
              {d.patrimonio.propiedades !== null && <span class="pill">{pl(d.patrimonio.propiedades, palabras.propiedades, lang)} ({pl(d.patrimonio.viviendas ?? 0, palabras.viviendas, lang)})</span>}
              <span class="pill p-vin" hidden></span>
            </span>
          </span>
          <span class="t-cifra">
            <span data-k="pr"><strong>{d.patrimonio.propiedades ?? '—'}</strong><small><span class="sr-only">{t.ficha.srPropiedades}</span>{f(t.ficha.vivAbrev, { n: d.patrimonio.viviendas ?? '—' })}</small></span>
            <span data-k="v"><strong>{d.patrimonio.viviendas ?? '—'}</strong><small>{t.ficha.viviendas}</small></span>
            <span data-k="co"><strong>{d.patrimonio.vehiculos ?? '—'}</strong><small>{t.ficha.vehiculos}</small></span>
            <span data-k="r"><strong>{fmtNum(Math.round(d.retribucion.totalMensual))}</strong><small>{t.ficha.alMes}</small></span>
            <span data-k="l"><strong>{nLeg(d) || '—'}</strong><small>{nLeg(d) === 1 ? t.ficha.legislatura[0] : t.ficha.legislatura[1]}</small></span>
            <span data-k="vin"><strong class="n-vin">0</strong><small>{t.ficha.entidades}</small></span>
            <span data-k="itot"><strong>{fmtNum(Math.round(d.finanzas?.valores?.total ?? 0))} €</strong><small>{t.ficha.enValores}</small></span>
            <span data-k="iac"><strong>{fmtNum(resumenInversiones(d.finanzas?.valores?.filas ?? []).acciones)} €</strong><small>{t.ficha.enAcciones}</small></span>
            <span data-k="ifo"><strong>{fmtNum(resumenInversiones(d.finanzas?.valores?.filas ?? []).fondos)} €</strong><small>{t.ficha.enFondos}</small></span>
          </span>
          <Icono n="derecha" tam={18} class="t-flecha" />
        </a>
        <BotonCompartir class="compartir-tarjeta" d={d} />
      </li>
    ))}
  </ul>
  <DialogoCompartir />

  <div id="vista-tabla" hidden>
  <div class="table-scroll card" style="padding:0">
    <!-- La tabla (350 filas) se crea al abrir su vista: así la página carga con menos nodos. Sus filas toman los datos
         de filtro y orden de las fichas (data-id), para no repetirlos en el HTML -->
    <template id="plantilla-tabla">
    <table id="tabla-ranking">
      <caption class="sr-only">{t.tabla.caption}</caption>
      <thead>
        <tr>
          <th scope="col" class="num pos-h">#</th>
          <th scope="col"><button class="orden" data-k="n">{c.diputado}</button></th>
          {columnas.map((col) => (
            <th scope="col" class="num" aria-sort={col.k === 'pr' ? 'descending' : undefined}>
              <button class="orden" data-k={col.k}><span class="largo">{col.t}</span><span class="corto">{col.corto}</span></button>
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {filas.map((d, i) => (
          <tr data-id={slug(d)}>
            <td class="num muted pos">{i + 1}</td>
            <td class="quien">
              <a href={u(`/diputado/${slug(d)}`)}>{d.nombreCompleto}</a>{(d.patrimonio.revisar || conAviso(d)) && <span title={t.tabla.avisoTitulo} class="aviso">*</span>}
              <button class="desplegar" type="button" aria-expanded="false" aria-label={f(t.tabla.desplegar, { nombre: d.nombreCompleto })}><Icono n="abajo" tam={18} /></button>
              <span class="sub"><span class="dot" style={`background:${colorGrupo(d.grupoCorto)}`}></span> {etiquetaPartido(d, lang)} · {d.circunscripcion}</span>
            </td>
            <td class="num dato" data-k="pr" data-label={c.propiedades} data-corto={c.propiedadesCorto}><strong>{d.patrimonio.propiedades ?? '—'}</strong></td>
            <td class="num dato" data-k="v" data-label={c.viviendas} data-corto={c.viviendasCorto}>{d.patrimonio.viviendas ?? '—'}</td>
            <td class="num dato" data-k="co" data-label={c.vehiculos} data-corto={c.vehiculosCorto}>{d.patrimonio.vehiculos ?? '—'}</td>
            <td class="num dato" data-k="r" data-label={c.retribucionCorto} data-corto={c.retribucionCorto}>{fmtNum(Math.round(d.retribucion.totalMensual))}<span class="eur">&nbsp;€</span></td>
          </tr>
        ))}
      </tbody>
    </table>
    </template>
  </div>
  <p class="small muted">
    <span class="aviso">*</span> {t.tabla.aviso}{' '}
    {t.tabla.propiedades} <a href={u('/metodologia#propiedades')}>{t.tabla.comoSeCuentan}</a>.
  </p>
  </div>
  <p class="small muted" id="nota-formacion">
    <Fragment set:html={f(t.formacion.nota, { ruct })} />{' '}
    <a href={u('/metodologia#perfil')}>{t.formacion.comoSeObtiene}</a>.
  </p>

  <section id="vista-grupos" hidden aria-labelledby="h-grupos">
    <h2 id="h-grupos" class="sr-only">{t.grupos.titulo}</h2>
    <div class="grid-stats cifras-congreso">
      <div class="card stat destacada"><span class="c-ico"><Icono n="propiedades" /></span><span class="v">{fmtNum(totalProp)}</span><span class="l">{t.grupos.statTotal}</span></div>
      <div class="card stat"><span class="c-ico"><Icono n="vivienda" /></span><span class="v">{fmtNum(totalViv)}</span><span class="l">{t.grupos.statViviendas}</span></div>
      <div class="card stat"><span class="c-ico"><Icono n="vivienda" /></span><span class="v">{pct(conVivienda)}</span><span class="l">{t.grupos.statConVivienda}</span></div>
      <div class="card stat"><span class="c-ico"><Icono n="viviendas" /></span><span class="v">{pct(tresOMas)}</span><span class="l">{t.grupos.statTresOMas}</span></div>
    </div>
    <div class="table-scroll card" style="padding:0">
      <table class="tabla-grupos">
        <thead>
          <tr>
            <th scope="col">{c.grupo}</th>
            <th scope="col" class="num"><span class="largo">{c.diputados}</span><abbr class="corto" title={c.diputados}>{c.diputadosCorto}</abbr></th>
            <th scope="col" class="col-barra">{c.propiedades} <span class="muted">{t.grupos.deEllasViviendas}</span></th>
            <th scope="col" class="num"><span class="largo">{c.propiedades}</span><abbr class="corto" title={c.propiedades}>{c.propiedadesCorto}</abbr></th>
            <th scope="col" class="num"><span class="largo">{c.viviendas}</span><abbr class="corto" title={c.viviendas}>{c.viviendasCorto}</abbr></th>
            <th scope="col" class="num"><span class="largo">{c.vehiculos}</span><abbr class="corto" title={c.vehiculos}>{c.vehiculosCorto}</abbr></th>
          </tr>
        </thead>
        <tbody>
          {porGrupo.map((g) => (
            <tr>
              <th scope="row"><span class="dot" style={`background:${g.color}`}></span> {g.corto}</th>
              <td class="num" data-label={c.diputados}>{g.diputados}</td>
              <td class="col-barra" aria-hidden="true">
                <span class="pista">
                  <span class="relleno" style={`width:${(100 * g.propiedades) / max}%;--c:${g.color}`}>
                    <span class="viv" style={`width:${(100 * g.viviendas) / Math.max(1, g.propiedades)}%`}></span>
                  </span>
                </span>
              </td>
              <td class="num" data-label={c.propiedades}><strong>{fmtNum(g.propiedades)}</strong></td>
              <td class="num" data-label={c.viviendas}>{fmtNum(g.viviendas)}</td>
              <td class="num" data-label={c.vehiculos}>{fmtNum(g.vehiculos)}</td>
            </tr>
          ))}
        </tbody>
        <tfoot>
          <tr>
            <th scope="row">{c.total}</th>
            <td class="num" data-label={c.diputados}>{porGrupo.reduce((a, g) => a + g.diputados, 0)}</td>
            <td class="col-barra"></td>
            <td class="num" data-label={c.propiedades}><strong>{fmtNum(porGrupo.reduce((a, g) => a + g.propiedades, 0))}</strong></td>
            <td class="num" data-label={c.viviendas}>{fmtNum(porGrupo.reduce((a, g) => a + g.viviendas, 0))}</td>
            <td class="num" data-label={c.vehiculos}>{fmtNum(porGrupo.reduce((a, g) => a + g.vehiculos, 0))}</td>
          </tr>
        </tfoot>
      </table>
    </div>
    <p class="small muted leyenda-barras"><span class="ley-barras"><span class="muestra m-prop"></span> {t.grupos.leyendaPropiedades} <span class="muestra m-viv"></span> {t.grupos.leyendaViviendas} ·</span> {t.grupos.suma} · <a href={u('/metodologia#propiedades')}>{t.tabla.comoSeCuentan}</a></p>
    <p class="small muted">
      {t.grupos.notaPropiedades}{' '}
      {t.grupos.notaSociedades}{' '}
      {conDatos.length < diputados.length && <>{f(t.grupos.conDatos, { con: conDatos.length, total: diputados.length })}{' '}</>}
      {f(t.grupos.consultados, { fecha: fmtFecha(meta.generado.slice(0, 10)) })}
    </p>
  </section>

  <div id="vista-mapa" hidden>
    <MapaProvincias enVista />
  </div>

  <script type="application/json" id="vin-claves" set:html={JSON.stringify({ tipos: TIPOS_ENTIDAD, relaciones: RELACIONES })} />
  <script type="application/json" data-textos="diputados" set:html={JSON.stringify(t.cliente)} />
</Base>

<script>
  import { textos, pl, locale } from '../../i18n/cliente';
  const t = textos<{ cuenta: string[]; ver: string[]; filtrarActivos: string[]; filtrarYOrdenar: string; entidades: string[] }>('diputados');
  const loc = locale();
  const lista = document.getElementById('tarjetas') as HTMLUListElement;
  const tarjetas = [...lista.children] as HTMLLIElement[];
  // La tabla de patrimonio se crea al abrir su vista (crearTabla)
  let tabla: HTMLTableElement | null = null;
  let cuerpo: HTMLTableSectionElement | null = null;
  let filas: HTMLTableRowElement[] = [];
  const vistaTabla = document.getElementById('vista-tabla')!;
  const vistaGrupos = document.getElementById('vista-grupos')!;
  const vistaMapa = document.getElementById('vista-mapa')!;
  const filtros = document.getElementById('filtros')!;
  const notaFormacion = document.getElementById('nota-formacion')!;
  const botonesVista = [...document.querySelectorAll<HTMLButtonElement>('[data-vista]')];
  const texto = document.getElementById('f-texto') as HTMLInputElement;
  const grupo = document.getElementById('f-grupo') as HTMLSelectElement;
  const prov = document.getElementById('f-prov') as HTMLSelectElement;
  const form = document.getElementById('f-form') as HTMLSelectElement;
  const vtipo = document.getElementById('f-vtipo') as HTMLSelectElement;
  const vrel = document.getElementById('f-vrel') as HTMLSelectElement;
  const vrem = document.getElementById('f-vrem') as HTMLSelectElement;
  const notaVin = document.getElementById('nota-vin')!;
  const inv = document.getElementById('f-inv') as HTMLSelectElement;
  const notaInv = document.getElementById('nota-inv')!;
  const orden = document.getElementById('f-orden') as HTMLSelectElement;
  const cuenta = document.getElementById('f-cuenta')!;
  const filtrosMas = document.getElementById('filtros-mas')!;
  const dlgFiltros = document.getElementById('dlg-filtros') as HTMLDialogElement;
  const abrirFiltros = document.getElementById('abrir-filtros') as HTMLButtonElement;
  const nFiltros = document.getElementById('n-filtros')!;
  const verResultados = document.getElementById('ver-resultados') as HTMLButtonElement;
  const quitarTildes = (s: string) => s.normalize('NFD').replace(/[\u0300-\u036f]/g, '');
  const VISTAS = ['tarjetas', 'tabla', 'grupos', 'mapa'];
  // Cada lista recuerda su orden: las fichas, por nombre; la tabla de patrimonio, por más propiedades
  const ordenes: Record<string, { clave: string; desc: boolean }> = { tarjetas: { clave: 'n', desc: false }, tabla: { clave: 'pr', desc: true } };
  let clave = 'n', desc = false, vista = 'tarjetas';

  const valor = (f: HTMLElement, k: string) => parseFloat(f.dataset[k] ?? '0');
  const comparar = (a: HTMLElement, b: HTMLElement) => {
    let r = clave === 'n' ? (a.dataset.n ?? '').localeCompare(b.dataset.n ?? '', loc) : valor(a, clave) - valor(b, clave);
    if (r === 0 && clave !== 'n') r = (b.dataset.n ?? '').localeCompare(a.dataset.n ?? '', loc);
    return desc ? -r : r;
  };
  // Cada palabra de la búsqueda tiene que aparecer (en cualquier orden): «pp sevilla», «abogada icade»…
  const textoBusca = new Map<HTMLElement, string>(tarjetas.map((f) => [f, f.dataset.busca ?? '']));
  const fichaDe = new Map(tarjetas.map((f) => [f.dataset.id!, f]));
  /** Crea la tabla desde su plantilla la primera vez que se ve; cada fila copia los datos de su ficha. */
  function crearTabla() {
    if (tabla) return;
    const tpl = document.getElementById('plantilla-tabla') as HTMLTemplateElement;
    tpl.replaceWith(tpl.content.cloneNode(true));
    tabla = document.getElementById('tabla-ranking') as HTMLTableElement;
    cuerpo = tabla.tBodies[0];
    filas = [...cuerpo.rows];
    for (const f of filas) {
      const ficha = fichaDe.get(f.dataset.id!)!;
      const { id: _id, busca, ...resto } = ficha.dataset;
      Object.assign(f.dataset, resto);
      textoBusca.set(f, busca ?? '');
    }
    tabla.querySelectorAll<HTMLButtonElement>('button.orden').forEach((b) => b.addEventListener('click', () => {
      const k = b.dataset.k!;
      desc = k === clave ? !desc : k !== 'n';
      clave = k; marcar(); aplicar();
    }));
    // Móvil: cada fila de la tabla enseña la cifra por la que se ordena; el botón despliega las cuatro
    cuerpo.addEventListener('click', (e) => {
      const t = e.target as Element;
      if (t.closest('a')) return;
      const fila = t.closest('tr');
      const boton = fila?.querySelector<HTMLButtonElement>('.desplegar');
      if (!fila || !boton || getComputedStyle(boton).display === 'none') return;
      const abierta = fila.classList.toggle('abierta');
      boton.setAttribute('aria-expanded', String(abierta));
    });
  }
  /** Empresas y entidades distintas que cumplen los filtros de participación (códigos en data-vt). */
  const codigos = new Map<HTMLElement, string[][]>();
  const codigosDe = (f: HTMLElement) => { let c = codigos.get(f); if (!c) { c = (f.dataset.vc ?? '').split(' ').filter(Boolean).map((x) => x.split('.')); codigos.set(f, c); } return c; };
  const filtroVin = () => !!(vtipo.value || vrel.value || vrem.value);
  let ultimoVin = '';
  function contarVinculos(f: HTMLElement) {
    const ids = new Set<string>();
    for (const [i, ti, ri, rm] of codigosDe(f)) {
      if ((!vtipo.value || ti === vtipo.value) && (!vrel.value || ri === vrel.value) && (!vrem.value || rm === vrem.value)) ids.add(i);
    }
    f.dataset.vin = String(ids.size);
    return ids.size;
  }
  /** Reordena las filas y las fichas (solo cuando cambia el orden o la vista: mover nodos es lo que más cuesta). */
  // Solo se reordena la lista que se ve y solo si su orden cambia: cambiar de vista no mueve 700 nodos cada vez
  const ordenHecho = { tabla: '', tarjetas: '' };
  function ordenar() {
    const k = `${clave}:${desc}` + (clave === 'vin' ? `:${vtipo.value}.${vrel.value}.${vrem.value}` : '');
    if (vista === 'tabla' && cuerpo && ordenHecho.tabla !== k) { ordenHecho.tabla = k; filas.sort(comparar); cuerpo.append(...filas); }
    if (vista === 'tarjetas' && ordenHecho.tarjetas !== k) { ordenHecho.tarjetas = k; tarjetas.sort(comparar); lista.append(...tarjetas); }
  }
  function aplicar(reordenar = true) {
    // La cifra de empresas y entidades depende de los filtros: se calcula antes de ordenar
    const verVin = filtroVin() || clave === 'vin';
    const kv = `${vtipo.value}.${vrel.value}.${vrem.value}.${verVin}.${filas.length}`;
    if (kv !== ultimoVin) for (const f of [...tarjetas, ...filas]) {
      const n = contarVinculos(f);
      const pill = f.querySelector<HTMLElement>('.p-vin');
      if (pill) { pill.hidden = !verVin; if (verVin) pill.textContent = pl(n, t.entidades); }
      const cifra = f.querySelector<HTMLElement>('.n-vin');
      if (cifra) cifra.textContent = String(n);
    }
    ultimoVin = kv;
    notaVin.hidden = !verVin;
    notaInv.hidden = !(inv.value || ['itot', 'iac', 'ifo'].includes(clave));
    if (reordenar || clave === 'vin') ordenar();
    const palabras = quitarTildes(texto.value.trim().toLowerCase()).split(/\s+/).filter(Boolean);
    const pasa = (f: HTMLElement) => (!grupo.value || f.dataset.g === grupo.value) && (!prov.value || f.dataset.c === prov.value)
      && (!form.value || f.dataset.f === form.value) && (!filtroVin() || f.dataset.vin !== '0') && (!inv.value || (f.dataset.inv ?? '').split(' ').includes(inv.value)) && palabras.every((w) => textoBusca.get(f)!.includes(w));
    let n = 0;
    for (const f of filas) {
      const ok = pasa(f);
      if (f.hidden === ok) f.hidden = !ok;
      if (ok) { n++; const pos = f.querySelector('.pos') as HTMLElement; if (pos.textContent !== String(n)) { pos.textContent = String(n); (f.querySelector('.quien') as HTMLElement).dataset.pos = String(n); } }
    }
    // La tabla se crea al abrir su vista: la cuenta sale de las fichas, que siempre están
    let visibles = 0;
    for (const t of tarjetas) { const ok = pasa(t); if (t.hidden === ok) t.hidden = !ok; if (ok) visibles++; }
    cuenta.textContent = pl(visibles, t.cuenta);
    verResultados.textContent = pl(visibles, t.ver);
    const activos = [grupo, prov, form, inv, vtipo, vrel, vrem].filter((x) => x.value).length;
    nFiltros.hidden = !activos; nFiltros.textContent = String(activos);
    abrirFiltros.setAttribute('aria-label', activos ? pl(activos, t.filtrarActivos) : t.filtrarYOrdenar);
    if (ordenes[vista]) ordenes[vista] = { clave, desc };
    try { localStorage.setItem('diputados', JSON.stringify({ g: grupo.value, f: form.value, vt: vtipo.value, vr: vrel.value, vm: vrem.value, iv: inv.value, ordenes, vista })); } catch {}
  }
  function marcar() {
    if (tabla) {
      tabla.querySelectorAll('thead th').forEach((th) => th.removeAttribute('aria-sort'));
      tabla.querySelector(`button.orden[data-k="${clave}"]`)?.closest('th')?.setAttribute('aria-sort', desc ? 'descending' : 'ascending');
      tabla.dataset.clave = clave;
    }
    lista.dataset.clave = clave;
    orden.value = clave;
  }
  function verVista(v: string) {
    if (!VISTAS.includes(v)) v = 'tarjetas';
    if (v === 'tabla') crearTabla();
    vista = v; vistaTabla.hidden = v !== 'tabla'; lista.hidden = v !== 'tarjetas'; vistaGrupos.hidden = v !== 'grupos'; vistaMapa.hidden = v !== 'mapa';
    // Los filtros y el orden solo tienen sentido en las dos listas (fichas y tabla)
    filtros.hidden = !ordenes[v]; notaFormacion.hidden = v !== 'tarjetas';
    if (ordenes[v]) ({ clave, desc } = ordenes[v]);
    botonesVista.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.vista === v)));
    // La vista queda en la dirección para poder enlazarla (/diputados?vista=mapa)
    const u = new URL(location.href);
    if (v === 'tarjetas') u.searchParams.delete('vista'); else u.searchParams.set('vista', v);
    history.replaceState(null, '', u);
  }
  orden.addEventListener('change', () => { clave = orden.value; desc = clave !== 'n'; marcar(); aplicar(); });
  botonesVista.forEach((b) => b.addEventListener('click', () => { verVista(b.dataset.vista!); marcar(); aplicar(); }));
  // La búsqueda espera a que se deje de escribir un momento y no reordena la lista: así no se traba al teclear
  let espera = 0;
  texto.addEventListener('input', () => { clearTimeout(espera); espera = window.setTimeout(() => requestAnimationFrame(() => aplicar(false)), 140); });

  // Los selectores van en la ventana de filtros (components/HojaFiltros.astro), como en Votaciones.
  // Sin JavaScript se quedan en la fila del buscador.
  dlgFiltros.querySelector('.df-cuerpo')!.appendChild(filtrosMas);
  document.getElementById('quitar-filtros')!.addEventListener('click', () => { grupo.value = ''; prov.value = ''; form.value = ''; vtipo.value = ''; vrel.value = ''; vrem.value = ''; inv.value = ''; aplicar(false); });

  [grupo, prov, form, inv, vtipo, vrel, vrem].forEach((e) => e.addEventListener('change', () => aplicar(false)));
  try {
    const s = JSON.parse(localStorage.getItem('diputados') ?? 'null');
    if (s) { grupo.value = s.g ?? ''; form.value = s.f ?? ''; vtipo.value = s.vt ?? ''; vrel.value = s.vr ?? ''; vrem.value = s.vm ?? ''; inv.value = s.iv ?? ''; vista = s.vista ?? 'tarjetas'; if (s.ordenes) Object.assign(ordenes, s.ordenes); }
  } catch {}
  // Filtros desde la dirección: /diputados?provincia=Sevilla&grupo=PSOE&q=derecho
  const ps = new URLSearchParams(location.search);
  if (ps.has('provincia')) prov.value = ps.get('provincia')!;
  if (ps.has('grupo')) grupo.value = ps.get('grupo')!;
  if (ps.has('q')) texto.value = ps.get('q')!;
  // /diputados?entidad=empresa&relacion=autorizada&remuneracion=s&inversion=f: un enlace así sustituye los filtros guardados de participación
  if (['entidad', 'relacion', 'remuneracion', 'inversion'].some((k) => ps.has(k))) { vtipo.value = ''; vrel.value = ''; vrem.value = ''; inv.value = ''; }
  const ix = (lista: readonly string[], k: string) => (ps.has(k) && lista.includes(ps.get(k)!) ? String(lista.indexOf(ps.get(k)!)) : null);
  const tiposVin = JSON.parse(document.getElementById('vin-claves')!.textContent!) as { tipos: string[]; relaciones: string[] };
  vtipo.value = ix(tiposVin.tipos, 'entidad') ?? vtipo.value;
  vrel.value = ix(tiposVin.relaciones, 'relacion') ?? vrel.value;
  if (ps.has('remuneracion')) vrem.value = ps.get('remuneracion')!;
  if (ps.has('inversion')) inv.value = ps.get('inversion')!;
  if (ps.has('vista')) vista = ps.get('vista')!;
  else if (location.hash === '#mapa') vista = 'mapa';
  verVista(vista); marcar(); aplicar();
</script>

