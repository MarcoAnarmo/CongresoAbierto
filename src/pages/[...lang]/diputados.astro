    .t-nombre { padding-right: 0; font-size: .98rem; }
    .t-sub { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: .82rem; }
    .t-cifra { display: block; flex: none; text-align: right; line-height: 1.2; min-width: 52px; }
    .t-cifra > span { display: none; flex-direction: column; align-items: flex-end; }
    .t-cifra strong { font-size: 1.15rem; font-variant-numeric: tabular-nums; }
