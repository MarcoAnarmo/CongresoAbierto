---
/**
 * Descargas al estilo del INE, pensadas para el móvil: 1) tabla, 2) filtros, 3) columnas, 4) formato y descargar.
 * La lógica está en src/scripts/descargas.ts y las tablas en src/lib/datos/tablas.ts.
 * Sin JavaScript se ven las tablas completas en CSV, el diccionario y la licencia.
 */
import Base from '../../layouts/Base.astro';
import PestanasDatos from '../../components/PestanasDatos.astro';
import Icono from '../../components/Icono.astro';
import { url, grupos, TEMAS, meta } from '../../lib/data';
import { TABLAS, rutaCsvFijo } from '../../lib/datos/tablas';
import { filasTabla, aniosVotos, filasVotos } from '../../lib/datos/filas';
import { LICENCIA_DATOS } from '../../lib/datos/licencia';
import { conjuntoDatos, migas } from '../../lib/seo';
import { rutasIdioma, idiomaDe, enlace, pl, f } from '../../i18n';
import comun from '../../i18n/textos/comun';
import textos from '../../i18n/textos/datos';

export const getStaticPaths = rutasIdioma;
const lang = idiomaDe(Astro.params.lang);
const t = textos[lang];
const tc = comun[lang];
const u = (p: string) => enlace(p, lang);

// Filas de cada tabla (votos: votaciones × diputados con voto)
const filas: Record<string, number> = Object.fromEntries(TABLAS.filter((x) => x.particion === 'unica').map((x) => [x.id, filasTabla(x).length]));
filas.votos = filasVotos();
const nombre = (id: string) => t.tablas[id as keyof typeof t.tablas];

const config = {
  base: url(''),
  filas,
  anios: aniosVotos(),
  grupos: [...grupos].sort((a, b) => a.orden - b.orden).map((g) => g.corto),
  temas: Object.fromEntries(TEMAS.map((x) => [x.id, tc.temas[x.id] ?? x.nombre])),
  tx: { ...Object.fromEntries(Object.entries(t).filter(([, v]) => typeof v === 'string')) },
  plFilas: t.filas,
  nombresColumnas: Object.fromEntries(Object.entries(t.columnas).map(([k, v]) => [k, v.nombre])),
  nombresTablas: Object.fromEntries(Object.entries(t.tablas).map(([k, v]) => [k, v.nombre])),
  nombresFiltros: t.filtros,
};
const jsonLd = [
  conjuntoDatos({
    nombre: t.tituloSeo, descripcion: t.descripcion, ruta: u('/datos'), licencia: LICENCIA_DATOS.url, lang, modificado: meta.generado.slice(0, 10),
    palabras: ['Congreso de los Diputados', 'diputados', 'patrimonio', 'votaciones', 'transparencia', 'España'],
    descargas: TABLAS.filter((x) => x.csvFijo).map((x) => ({ nombre: nombre(x.id).nombre, ruta: rutaCsvFijo(x), formato: 'text/csv' })),
  }),
  migas([[tc.nav.estadisticas, u('/estadisticas')], [t.titulo, u('/datos')]]),
];
const licencia = `<a href="${LICENCIA_DATOS.url}" rel="license noopener">${LICENCIA_DATOS.nombre}</a>`;
---
<Base title={t.titulo} tituloSeo={`${t.tituloSeo} · Congreso Abierto`} description={t.descripcion} jsonLd={jsonLd}>
  <PestanasDatos actual="datos" />
  <h1>{t.titulo}</h1>
  <p class="lead">{t.lead}</p>

  <div class="pasos" id="descargas">
    <fieldset class="paso card">
      <legend><span class="num">1</span>{t.paso1}</legend>
      <div class="tablas">
        {TABLAS.map((x, i) => (
          <label class="opcion">
            <input type="radio" name="d-tabla" value={x.id} checked={i === 0} />
            <span class="o-texto">
              <span class="o-nombre">{nombre(x.id).nombre}</span>
              <span class="o-desc">{nombre(x.id).descripcion}</span>
            </span>
            <span class="o-n">{pl(filas[x.id], t.filas, lang)}</span>
          </label>
        ))}
      </div>
      <p class="small muted nota-tabla" data-nota-tabla="votos" hidden>{t.nota_votos}</p>
      <p class="small muted nota-tabla" data-nota-tabla="inmuebles" hidden>{t.nota_inmuebles}</p>
    </fieldset>

    <section class="paso card" aria-labelledby="d-p2">
      <h2 class="leyenda" id="d-p2"><span class="num">2</span>{t.paso2}</h2>
      <div class="filtros" id="d-filtros"><p class="muted small">{t.cargando}</p></div>
      <button class="btn btn-texto" type="button" id="d-quitar" hidden>{t.quitarFiltros}</button>
    </section>

    <section class="paso card" aria-labelledby="d-p3">
      <h2 class="leyenda" id="d-p3"><span class="num">3</span>{t.paso3}</h2>
      <details class="cols">
        <summary><span id="d-cols-n"></span><Icono n="abajo" tam={18} /></summary>
        <div class="cols-botones"><button class="btn btn-texto" type="button" id="d-cols-defecto">{t.porDefecto}</button><button class="btn btn-texto" type="button" id="d-cols-todas">{t.todas}</button></div>
        <div class="f-chips" id="d-columnas"></div>
      </details>
    </section>

    <section class="paso card" aria-labelledby="d-p4">
      <h2 class="leyenda" id="d-p4"><span class="num">4</span>{t.paso4}</h2>
      <div class="formatos">
        <label class="opcion"><input type="radio" name="d-formato" value="excel" checked /><span class="o-texto"><span class="o-nombre">{t.excel}</span><span class="o-desc">{t.excelAyuda}</span></span></label>
        <label class="opcion"><input type="radio" name="d-formato" value="csv" /><span class="o-texto"><span class="o-nombre">{t.csv}</span><span class="o-desc">{t.csvAyuda}</span></span></label>
      </div>
      <p class="estado" id="d-estado" aria-live="polite">{t.cargando}</p>
      <button class="btn primario descargar" type="button" id="d-descargar" disabled><Icono n="descarga" tam={20} />{t.descargar}</button>
      <div class="previa" id="d-previa"></div>
    </section>
  </div>

  <section class="extra" aria-labelledby="d-completas">
    <h2 id="d-completas">{t.completos}</h2>
    <p class="muted">{t.completosTexto}</p>
    <ul class="completas" role="list">
      {TABLAS.filter((x) => x.csvFijo).map((x) => <li><a href={url(rutaCsvFijo(x))} download><Icono n="descarga" tam={18} />{nombre(x.id).nombre}</a> <span class="muted small">{pl(filas[x.id], t.filas, lang)} · CSV</span></li>)}
    </ul>

    <details class="diccionario">
      <summary>{t.diccionario}</summary>
      {TABLAS.map((x) => (
        <div class="dic-tabla">
          <h3>{nombre(x.id).nombre}</h3>
          <dl>{x.columnas.map((c) => <><dt><code>{c.id}</code> · {t.columnas[c.id as keyof typeof t.columnas].nombre}</dt><dd>{t.columnas[c.id as keyof typeof t.columnas].descripcion}</dd></>)}</dl>
        </div>
      ))}
    </details>

    <div class="licencia warn">
      <p set:html={f(t.licencia, { licencia })} />
      <p class="cita"><q>{LICENCIA_DATOS.cita}</q></p>
      <p class="small">{t.fuentes}</p>
    </div>
  </section>

  <script type="application/json" id="datos-config" set:html={JSON.stringify(config).replace(/</g, '\\u003c')} />
</Base>

<script>
  import '../../scripts/descargas';
</script>

<style>
  .pasos { display: grid; gap: 12px; }
  .paso { margin: 0; padding: 14px; min-width: 0; }
  fieldset.paso { border: 1px solid var(--border); }
  .paso legend, .leyenda { display: flex; align-items: center; gap: 10px; font-weight: 750; font-size: 1.05rem; margin: 0 0 10px; padding: 0; letter-spacing: -.01em; }
  fieldset.paso legend { float: left; width: 100%; }
  fieldset.paso legend + * { clear: both; }
  .num { display: inline-grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; background: var(--accent-soft); color: var(--accent-text); font-size: .85rem; flex: none; }
  .tablas, .formatos { display: grid; gap: 8px; }
  .opcion { display: flex; align-items: flex-start; gap: 10px; padding: 10px 12px; border: 1px solid var(--border); border-radius: 12px; cursor: pointer; transition: border-color .15s, background .15s; }
  .opcion:has(input:checked) { border-color: var(--accent); background: var(--accent-soft); }
  .opcion input { margin: 4px 0 0; accent-color: var(--accent-strong); width: 18px; height: 18px; flex: none; }
  .o-texto { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .o-nombre { font-weight: 650; line-height: 1.3; }
  .o-desc { font-size: .85rem; color: var(--muted); line-height: 1.35; }
  .o-n { flex: none; font-size: .8rem; color: var(--muted); font-variant-numeric: tabular-nums; white-space: nowrap; margin-top: 2px; }
  /* Móvil estrecho: la cifra de filas pasa debajo del nombre en vez de empujar la caja */
  @media (max-width: 420px) { .opcion { flex-wrap: wrap; } .o-texto { flex-basis: calc(100% - 28px); } .o-n { margin-left: 28px; } }
  .nota-tabla { margin: 8px 0 0; }
  /* Filtros: los pinta el script, por eso van en :global */
  .filtros { display: grid; gap: 8px; }
  .filtros :global(.f-valores) { border: 1px solid var(--border); border-radius: 12px; }
  .filtros :global(.f-valores > summary) { display: flex; align-items: center; justify-content: space-between; gap: 10px; min-height: 48px; padding: 6px 12px; cursor: pointer; list-style: none; }
  .filtros :global(.f-valores > summary::-webkit-details-marker) { display: none; }
  .filtros :global(.f-nombre) { font-weight: 650; flex: none; }
  .filtros :global(.f-resumen) { color: var(--muted); font-size: .88rem; text-align: right; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
  .filtros :global(.f-valores[open] > summary) { border-bottom: 1px solid var(--border); }
  .filtros :global(.f-valores .f-chips) { padding: 10px 12px 12px; max-height: 50vh; overflow-y: auto; }
  .filtros :global(.f-texto), .filtros :global(.f-fechas label) { display: flex; flex-direction: column; gap: 4px; font-weight: 650; font-size: .92rem; }
  .filtros :global(.f-texto input), .filtros :global(.f-fechas input) { border: 1px solid var(--border); background: var(--surface); border-radius: 10px; padding: 8px 12px; min-height: 44px; font-weight: 400; width: 100%; }
  .filtros :global(.f-fechas) { border: 0; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 8px; min-width: 0; }
  .filtros :global(.f-fechas legend) { font-weight: 650; font-size: .92rem; margin-bottom: 4px; padding: 0; }
  .filtros :global(.f-fechas span) { font-weight: 400; color: var(--muted); font-size: .85rem; }
  .f-chips, .filtros :global(.f-chips) { display: flex; flex-wrap: wrap; gap: 6px; }
  .f-chips :global(.chip), .filtros :global(.chip) { display: inline-flex; align-items: center; gap: 6px; min-height: 40px; padding: 4px 12px 4px 8px; border: 1px solid var(--border); border-radius: 999px; font-size: .88rem; cursor: pointer; background: var(--surface); }
  .f-chips :global(.chip:has(input:checked)), .filtros :global(.chip:has(input:checked)) { border-color: var(--accent); background: var(--accent-soft); color: var(--accent-text); font-weight: 600; }
  .f-chips :global(.chip input), .filtros :global(.chip input) { accent-color: var(--accent-strong); width: 16px; height: 16px; margin: 0; }
  .btn-texto { border: 0; background: none; color: var(--accent-text); padding: 6px 4px; min-height: 40px; }
  .cols { border: 1px solid var(--border); border-radius: 12px; }
  .cols > summary { display: flex; align-items: center; justify-content: space-between; min-height: 48px; padding: 6px 12px; cursor: pointer; list-style: none; font-weight: 600; }
  .cols > summary::-webkit-details-marker { display: none; }
  .cols[open] > summary :global(svg) { transform: rotate(180deg); }
  .cols-botones { display: flex; gap: 12px; padding: 0 12px; }
  .cols .f-chips { padding: 4px 12px 12px; }
  .estado { margin: 14px 0 8px; }
  .descargar { width: 100%; display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 52px; font-size: 1.05rem; }
  .descargar:disabled { opacity: .55; cursor: default; }
  .previa { margin-top: 14px; }
  .previa :global(table) { font-size: .82rem; }
  .previa :global(td) { white-space: nowrap; }
  .previa :global(.table-scroll) { border: 1px solid var(--border); border-radius: 10px; }
  .extra { margin-top: 28px; }
  .completas { list-style: none; margin: 0 0 16px; padding: 0; display: grid; gap: 8px; }
  .completas a { display: inline-flex; align-items: center; gap: 8px; min-height: 40px; font-weight: 600; }
  .diccionario { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 0 14px; margin-bottom: 16px; }
  .diccionario > summary { min-height: 48px; display: flex; align-items: center; cursor: pointer; font-weight: 650; }
  .dic-tabla h3 { font-size: 1rem; margin: 12px 0 6px; }
  .dic-tabla dl { margin: 0 0 12px; display: grid; gap: 2px; }
  .dic-tabla dt { font-weight: 600; font-size: .88rem; margin-top: 6px; overflow-wrap: anywhere; }
  .dic-tabla dd { margin: 0; color: var(--muted); font-size: .85rem; }
  .dic-tabla code { font-size: .82rem; background: var(--chip); padding: 1px 5px; border-radius: 5px; }
  .licencia p { margin: 4px 0; }
  .cita { font-weight: 600; }
  @media (min-width: 900px) {
    .pasos { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: start; }
    .paso:last-child { grid-column: 1 / -1; }
  }
</style>
