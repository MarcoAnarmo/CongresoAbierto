---
/**
 * Galería de tarjetas para compartir, por tipos (pestañas): resumen, votaciones, provincias y diputados.
 * Al tocar una tarjeta se abre la ventana de compartir (DialogoCompartir, una sola por página) con la tarjeta grande,
 * los botones de redes y las descargas vertical y horizontal. Las imágenes solo se cargan al ver su pestaña.
 * Las provincias se filtran con un buscador; los diputados se buscan en un JSON (diputados.json) que se descarga
 * solo al abrir su pestaña. Sin JavaScript se ven todas las tarjetas y cada una abre su imagen.
 */
import Base from '../../../layouts/Base.astro';
import DialogoCompartir from '../../../components/DialogoCompartir.astro';
import Icono from '../../../components/Icono.astro';
import Pestanas from '../../../components/Pestanas.astro';
import { votaciones, url, grupos, circunscripciones } from '../../../lib/data';
import { rutaTarjeta, temaCorto, compartir, type ModoHemiciclo } from '../../../lib/tarjetas';
import { favorable } from '../../../lib/votaciones';
import { rutasIdioma, idiomaDe, enlace, formatos, f, prefijo } from '../../../i18n';
import textos from '../../../i18n/textos/tarjetas-pagina';
import comun from '../../../i18n/textos/comun';
import { sinTildes } from '../../../lib/texto';

export const getStaticPaths = rutasIdioma;
const lang = idiomaDe(Astro.params.lang);
const t = textos[lang];
const { fecha: fmtFecha } = formatos(lang);
const resultados = comun[lang].resultado as Record<string, string>;
const r = rutaTarjeta;
const norm = (s: string) => sinTildes(s).toLowerCase();

const vots = [...votaciones].sort((a, b) => b.fecha.localeCompare(a.fecha));
const MODOS: ModoHemiciclo[] = ['grupo', 'propiedades', 'viviendas'];
// Datos de cada tarjeta para la ventana de compartir (los lee DialogoCompartir de los atributos data-*)
const datos = (historia: string, horizontal: string, nombre: string, c: { enlace: string; texto: string }, titulo: string) => ({
  href: url(historia), 'data-compartir': nombre, 'data-historia': url(historia), 'data-horizontal': url(horizontal),
  'data-nombre': nombre, 'data-enlace': c.enlace, 'data-ct': c.texto, 'data-titulo': titulo,
  'aria-label': f(t.abrir, { nombre: titulo }), 'aria-haspopup': 'dialog' as const,
});
const config = {
  json: url(`${prefijo(lang)}/tarjetas/diputados.json`),
  colores: Object.fromEntries(grupos.map((g) => [g.corto, g.color])),
  abrir: t.abrir, sinResultados: t.sinResultados, mas: t.masResultados,
};
const PESTANAS = [
  { id: 'resumen', texto: t.categorias.resumen, icono: 'hemiciclo' as const },
  { id: 'votaciones', texto: t.categorias.votaciones, icono: 'votaciones' as const },
  { id: 'provincias', texto: t.categorias.provincias, icono: 'mapa' as const },
  { id: 'diputados', texto: t.categorias.diputados, icono: 'fichas' as const },
];
---
<Base title={t.titulo} imagen={r.pagina('tarjetas')} description={t.descripcion}>
  <h1>{t.titulo}</h1>
  <p class="lead">{t.lead}</p>

  <a class="crear" href={enlace('/votaciones', lang)}>
    <span class="crear-ico" aria-hidden="true"><Icono n="imagen" tam={24} /></span>
    <span class="crear-txt"><strong>{t.crear.titulo}</strong><span>{t.crear.texto}</span></span>
    <span class="crear-ir"><span class="crear-boton">{t.crear.boton}</span><Icono n="derecha" tam={20} /></span>
  </a>

  <Pestanas etiqueta={t.categorias.aria} pestanas={PESTANAS} />

  <section class="panel-pestana" id="resumen" role="tabpanel" aria-labelledby="tab-resumen" data-activo>
    <h2 class="panel-tit">{t.cifras}</h2>
    <ul class="galeria" role="list">
      {MODOS.map((m) => (
        <li>
          <a class="tarjeta" {...datos(r.resumen('historia', lang, m), r.resumen('horizontal', lang, m), `congreso-abierto${m === 'grupo' ? '' : `-${m}`}`, compartir.resumen(lang), t.modos[m])}>
            <img src={url(r.resumen('historia', lang, m))} alt={t.altResumen} width="270" height="480" loading="lazy" decoding="async" />
            <span class="t-pie"><strong>{t.modos[m]}</strong></span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="panel-pestana" id="votaciones" role="tabpanel" aria-labelledby="tab-votaciones">
    <h2 class="panel-tit">{t.votaciones}</h2>
    <ul class="galeria" role="list">
      {vots.map((v) => (
        <li>
          <a class="tarjeta" {...datos(r.votacion(v, 'historia', lang), r.votacion(v, 'horizontal', lang), `congreso-abierto-${v.id}`, compartir.votacion(v, lang), temaCorto(v.tema))}>
            <img src={url(r.votacion(v, 'historia', lang))} alt={f(t.altVotacion, { tema: temaCorto(v.tema), fecha: fmtFecha(v.fecha), resultado: resultados[v.resultado] ?? v.resultado })} width="270" height="480" loading="lazy" decoding="async" />
            <span class="t-pie">
              <strong>{temaCorto(v.tema)}</strong>
              <span class="t-meta"><span class:list={['res', favorable(v.resultado)]}>{resultados[v.resultado] ?? v.resultado}</span>{fmtFecha(v.fecha)}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="panel-pestana" id="provincias" role="tabpanel" aria-labelledby="tab-provincias">
    <h2 class="panel-tit">{t.provincia}</h2>
    <label class="buscador">
      <Icono n="buscar" tam={20} />
      <span class="sr-only">{t.buscarProvincia}</span>
      <input type="search" id="t-prov" placeholder={t.buscarProvincia} autocomplete="off" enterkeyhint="search" />
    </label>
    <ul class="lista" role="list" id="t-prov-lista">
      {circunscripciones.map((c) => (
        <li data-n={norm(c.legible)}>
          <a class="fila" {...datos(r.provincia(c.id, 'historia', lang), r.provincia(c.id, 'horizontal', lang), `congreso-abierto-${c.id}`, compartir.provincia(c.id, lang), c.legible)}>
            <span class="f-nombre">{c.legible}</span><span class="f-ico" aria-hidden="true"><svg width="18" height="18"><use href="#i-compartir" /></svg></span>
          </a>
        </li>
      ))}
    </ul>
    <p class="vacio muted" id="t-prov-vacio" hidden>{t.sinResultados}</p>
  </section>

  <section class="panel-pestana" id="diputados" role="tabpanel" aria-labelledby="tab-diputados">
    <h2 class="panel-tit">{t.diputado}</h2>
    <label class="buscador">
      <Icono n="buscar" tam={20} />
      <span class="sr-only">{t.buscarDiputado}</span>
      <input type="search" id="t-dip" placeholder={t.buscarDiputado} autocomplete="off" enterkeyhint="search" />
    </label>
    <ul class="lista" role="list" id="t-dip-lista" aria-live="polite"></ul>
    <p class="vacio muted small" id="t-dip-mas" hidden></p>
    <p class="small muted tambien" set:html={f(t.tambien, { enlace: `<a href="${enlace('/diputados', lang)}">${t.fichaEnlace}</a>` })} />
  </section>

  <DialogoCompartir />
  <script type="application/json" id="tarjetas-cfg" set:html={JSON.stringify(config).replace(/</g, '\\u003c')} />
</Base>

<script>
  import { sinTildes } from '../../../lib/texto';
  import { f, pl } from '../../../i18n/cliente';
  const cfg = JSON.parse(document.getElementById('tarjetas-cfg')!.textContent!) as { json: string; colores: Record<string, string>; abrir: string; sinResultados: string; mas: [string, string] };
  const norm = (s: string) => sinTildes(s).toLowerCase().trim();
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  // ---------- Provincias: filtrar la lista ----------
  const prov = document.getElementById('t-prov') as HTMLInputElement;
  const filasProv = [...document.querySelectorAll<HTMLElement>('#t-prov-lista > li')];
  const filtrarProv = () => {
    const q = norm(prov.value);
    let n = 0;
    filasProv.forEach((li) => { const si = !q || li.dataset.n!.includes(q); li.hidden = !si; if (si) n++; });
    document.getElementById('t-prov-vacio')!.hidden = n > 0;
  };
  prov.addEventListener('input', filtrarProv);

  // ---------- Diputados: se descargan al abrir su pestaña y se buscan por nombre, grupo o provincia ----------
  type Fila = [slug: string, nombre: string, grupo: string, provincia: string, texto: string];
  const MAX = 30;
  const dip = document.getElementById('t-dip') as HTMLInputElement;
  const lista = document.getElementById('t-dip-lista')!;
  const mas = document.getElementById('t-dip-mas')!;
  let filas: (Fila & { q?: string })[] | null = null;
  let indice: string[] = [];
  let cargando: Promise<void> | null = null;
  const cargar = () => (cargando ??= fetch(cfg.json).then((r) => r.json()).then((x: Fila[]) => {
    filas = x;
    indice = x.map(([, n, g, p]) => norm(`${n} ${g} ${p}`));
    pintar();
  }).catch(() => { cargando = null; }));
  function pintar() {
    if (!filas) return;
    const palabras = norm(dip.value).split(/\s+/).filter(Boolean);
    const hallados = filas.filter((_, i) => palabras.every((w) => indice[i].includes(w)));
    lista.innerHTML = hallados.slice(0, MAX).map(([s, n, g, p, t]) =>
      `<li><button type="button" class="fila" data-compartir="${esc(s)}" data-cn="${esc(n)}" data-ct="${esc(t)}" aria-haspopup="dialog" aria-label="${esc(f(cfg.abrir, { nombre: n }))}">`
      + `<span class="dot" style="background:${esc(cfg.colores[g] ?? 'var(--muted)')}"></span><span class="f-nombre">${esc(n)}<span class="f-sub">${esc(g)} · ${esc(p)}</span></span>`
      + '<span class="f-ico" aria-hidden="true"><svg width="18" height="18"><use href="#i-compartir" /></svg></span></button></li>').join('');
    const resto = hallados.length - MAX;
    mas.hidden = !(resto > 0 || !hallados.length);
    mas.textContent = !hallados.length ? cfg.sinResultados : resto > 0 ? pl(resto, cfg.mas) : '';
  }
  let espera = 0;
  dip.addEventListener('input', () => { clearTimeout(espera); espera = window.setTimeout(pintar, 120); });
  dip.addEventListener('focus', cargar, { once: true });
  const panelDip = document.getElementById('diputados')!;
  document.addEventListener('pestana', (e) => { if ((e as CustomEvent<string>).detail === 'diputados') cargar(); });
  if (panelDip.hasAttribute('data-activo')) cargar();
  // El navegador puede recordar lo escrito al volver atrás
  addEventListener('pageshow', () => { filtrarProv(); if (filas) pintar(); });
</script>

<style>
  h1 { margin-bottom: .3rem; }
  .lead { margin-top: 0; }
  /* Crear la tarjeta de cualquier votación */
  .crear {
    display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: 12px 14px; margin: 16px 0 20px; padding: 14px 16px;
    border-radius: 16px; text-decoration: none; color: var(--text); background: var(--accent-soft);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 35%, transparent); transition: box-shadow .15s;
  }
  .crear:hover { color: var(--text); box-shadow: inset 0 0 0 1.5px var(--accent); }
  .crear-ico { display: grid; place-items: center; width: 46px; height: 46px; border-radius: 14px; background: var(--surface); color: var(--accent-text); }
  .crear-txt { display: flex; flex-direction: column; gap: 2px; line-height: 1.35; }
  .crear-txt span { font-size: .88rem; color: var(--muted); }
  .crear { grid-template-columns: auto minmax(0, 1fr) auto; }
  .crear-ir { display: inline-flex; align-items: center; justify-content: center; gap: 4px; min-width: 40px; min-height: 40px; border-radius: 12px; background: var(--accent-strong); color: #fff; font-weight: 650; }
  .crear-boton { display: none; }
  @media (min-width: 721px) {
    .crear { padding: 16px 20px; }
    .crear-ir { min-height: 44px; padding: 0 16px 0 20px; }
    .crear-boton { display: inline; }
  }

  .panel-tit { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  :global(html:not(.js)) .panel-tit { position: static; width: auto; height: auto; clip: auto; }
  .panel-pestana { scroll-margin-top: calc(var(--tope) + 72px); }

  /* Galería de tarjetas verticales */
  .galeria { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px 12px; }
  @media (min-width: 600px) { .galeria { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px 18px; } }
  @media (min-width: 1000px) { .galeria { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .tarjeta { display: flex; flex-direction: column; gap: 10px; text-decoration: none; color: var(--text); -webkit-tap-highlight-color: transparent; }
  .tarjeta img {
    display: block; width: 100%; height: auto; aspect-ratio: 9 / 16; object-fit: cover; border-radius: 14px; background: var(--chip);
    box-shadow: 0 1px 2px rgb(0 0 0 / .06), 0 8px 24px rgb(0 0 0 / .08); outline: 1px solid var(--border); outline-offset: -1px;
    transition: transform .2s ease, box-shadow .2s ease;
  }
  .tarjeta:hover { color: var(--text); }
  .tarjeta:hover img { transform: translateY(-3px); box-shadow: 0 2px 4px rgb(0 0 0 / .08), 0 16px 36px rgb(0 0 0 / .14); }
  .tarjeta:active img { transform: scale(.98); }
  .t-pie { display: flex; flex-direction: column; gap: 4px; line-height: 1.3; font-size: .9rem; }
  .t-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 8px; font-size: .8rem; color: var(--muted); }
  .res { padding: 1px 8px; border-radius: 999px; font-weight: 650; font-size: .74rem; }
  .res.si { background: color-mix(in srgb, var(--si) 16%, transparent); color: var(--si); }
  .res.no { background: color-mix(in srgb, var(--no) 14%, transparent); color: var(--no); }
  :global(:root[data-theme='dark']) .res.si { color: #7fd287; }
  :global(:root[data-theme='dark']) .res.no { color: #ff8a80; }

  /* Provincias y diputados: buscador y lista */
  .buscador { position: relative; display: block; max-width: 520px; margin: 0 0 12px; }
  .buscador :global(svg) { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--muted); pointer-events: none; }
  .buscador input { width: 100%; min-height: 50px; padding: 10px 14px 10px 44px; border-radius: 14px; font-size: 1rem; }
  .lista { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  @media (min-width: 600px) { .lista { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1000px) { .lista { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .lista li[hidden] { display: none; }
  .lista :global(.fila) {
    width: 100%; display: flex; align-items: center; gap: 10px; min-height: 54px; padding: 8px 12px 8px 16px; border: 1px solid var(--border);
    border-radius: 14px; background: var(--surface); color: var(--text); text-decoration: none; text-align: left; font-weight: 600; cursor: pointer;
    transition: border-color .15s, background-color .15s;
  }
  .lista :global(.fila:hover) { border-color: var(--accent); color: var(--text); }
  .lista :global(.fila:active) { background: var(--accent-soft); }
  .lista :global(.f-nombre) { flex: 1; min-width: 0; display: flex; flex-direction: column; line-height: 1.3; }
  .lista :global(.f-sub) { font-size: .8rem; font-weight: 450; color: var(--muted); }
  .lista :global(.f-ico) { display: grid; place-items: center; width: 34px; height: 34px; flex: none; border-radius: 50%; background: var(--chip); color: var(--muted); }
  .lista :global(.fila:hover .f-ico) { background: var(--accent-soft); color: var(--accent-text); }
  .lista :global(.dot) { width: 10px; height: 10px; }
  .vacio { margin: 12px 0 0; }
  .tambien { margin-top: 16px; }
</style>
