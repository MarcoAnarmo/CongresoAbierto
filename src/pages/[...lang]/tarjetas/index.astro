---
import Base from '../../../layouts/Base.astro';
import BotonesTarjeta from '../../../components/BotonesTarjeta.astro';
import { diputados, votaciones, url, slug } from '../../../lib/data';
import { rutaTarjeta, temaCorto, compartir } from '../../../lib/tarjetas';
import { circunscripciones } from '../../../lib/data';
import { rutasIdioma, idiomaDe, enlace, formatos, f } from '../../../i18n';
import textos from '../../../i18n/textos/tarjetas-pagina';
import comun from '../../../i18n/textos/comun';

export const getStaticPaths = rutasIdioma;
const lang = idiomaDe(Astro.params.lang);
const t = textos[lang];
const { fecha: fmtFecha, comparar } = formatos(lang);
const resultados = comun[lang].resultado as Record<string, string>;

const vots = [...votaciones].sort((a, b) => b.fecha.localeCompare(a.fecha));
const dips = [...diputados].sort((a, b) => comparar(a.apellidos, b.apellidos));
// Las tarjetas de cada idioma llevan su prefijo (/ca/tarjetas/…); la imagen de la página la pone Base en el idioma de la página
const r = rutaTarjeta;
---
<Base title={t.titulo} imagen={r.pagina('tarjetas')} description={t.descripcion}>
  <h1>{t.titulo}</h1>
  <p class="lead">{t.lead}</p>

  <h2>{t.cifras}</h2>
  <div class="rejilla">
    <figure class="tarjeta">
      <img src={url(r.resumen('historia', lang))} alt={t.altResumen} width="270" height="480" loading="lazy" />
      <figcaption><BotonesTarjeta historia={r.resumen('historia', lang)} horizontal={r.resumen('horizontal', lang)} nombre="congreso-abierto-resumen" {...compartir.resumen(lang)} /></figcaption>
    </figure>
  </div>

  <h2>{t.votaciones}</h2>
  <div class="rejilla">
    {vots.map((v) => (
      <figure class="tarjeta">
        <img src={url(r.votacion(v, 'historia', lang))} alt={f(t.altVotacion, { tema: temaCorto(v.tema), fecha: fmtFecha(v.fecha), resultado: resultados[v.resultado] ?? v.resultado })} width="270" height="480" loading="lazy" />
        <figcaption>
          <p class="small"><strong>{temaCorto(v.tema)}</strong><br /><span class="muted">{fmtFecha(v.fecha)}</span></p>
          <BotonesTarjeta historia={r.votacion(v, 'historia', lang)} horizontal={r.votacion(v, 'horizontal', lang)} nombre={`congreso-abierto-${v.id}`} {...compartir.votacion(v, lang)} />
        </figcaption>
      </figure>
    ))}
  </div>

  <h2>{t.provincia}</h2>
  <label class="sr-only" for="t-prov">{t.eligeProvincia}</label>
  <select id="t-prov" class="selector" data-grupo="prov">
    {circunscripciones.map((c) => <option value={c.id} selected={c.id === 'madrid'}>{c.legible}</option>)}
  </select>
  <div class="rejilla">
    {circunscripciones.map((c) => (
      <figure class="tarjeta" data-prov={c.id} hidden={c.id !== 'madrid'}>
        <img src={url(r.provincia(c.id, 'historia', lang))} alt={f(t.altProvincia, { provincia: c.legible })} width="270" height="480" loading="lazy" />
        <figcaption><BotonesTarjeta historia={r.provincia(c.id, 'historia', lang)} horizontal={r.provincia(c.id, 'horizontal', lang)} nombre={`congreso-abierto-${c.id}`} {...compartir.provincia(c.id, lang)} /></figcaption>
      </figure>
    ))}
  </div>

  <h2>{t.diputado}</h2>
  <p class="small muted" set:html={f(t.tambien, { enlace: `<a href="${enlace('/diputados', lang)}">${t.fichaEnlace}</a>` })} />
  <label class="sr-only" for="t-dip">{t.eligeDiputado}</label>
  <select id="t-dip" class="selector" data-grupo="dip">
    <option value="">{t.eligeDiputadoOpcion}</option>
    {dips.map((d) => <option value={slug(d)}>{d.apellidos}, {d.nombre} ({d.grupoCorto})</option>)}
  </select>
  <div class="rejilla">
    {dips.map((d) => (
      <figure class="tarjeta" data-dip={slug(d)} hidden>
        <img src={url(r.diputado(d, 'historia', lang))} alt={f(t.altDiputado, { nombre: d.nombreCompleto })} width="270" height="480" loading="lazy" />
        <figcaption><BotonesTarjeta historia={r.diputado(d, 'historia', lang)} horizontal={r.diputado(d, 'horizontal', lang)} nombre={`congreso-abierto-${slug(d)}`} {...compartir.diputado(d, lang)} /></figcaption>
      </figure>
    ))}
  </div>
</Base>

<script>
  document.querySelectorAll<HTMLSelectElement>('select.selector').forEach((sel) => {
    const g = sel.dataset.grupo!;
    sel.addEventListener('change', () => {
      document.querySelectorAll<HTMLElement>(`figure[data-${g}]`).forEach((f) => { f.hidden = f.dataset[g] !== sel.value; });
    });
  });
</script>

<style>
  .lead { max-width: 62ch; }
  .rejilla { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 20px; margin-top: 14px; }
  .tarjeta { margin: 0; display: flex; flex-direction: column; gap: 10px; }
  .tarjeta[hidden] { display: none; }
  .tarjeta img { width: 100%; max-width: 300px; height: auto; aspect-ratio: 9 / 16; border-radius: 14px; border: 1px solid var(--border); background: var(--chip); }
  .tarjeta figcaption p { margin: 0 0 6px; }
  .selector { width: 100%; max-width: 360px; }
</style>
