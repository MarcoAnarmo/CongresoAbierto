---
/**
 * Galería de tarjetas para compartir, por tipos (pestañas): resumen, estadísticas, votaciones, provincias y diputados.
 * Al tocar una tarjeta se abre la ventana de compartir (DialogoCompartir, una sola por página) con la tarjeta grande,
 * los botones de redes y las descargas vertical y horizontal. Las imágenes solo se cargan al ver su pestaña.
 * Provincias y diputados: una tarjeta de muestra y, al lado, la lista con buscador; al elegir uno, la muestra cambia
 * (en el móvil se abre ya la ventana de compartir). Los diputados llegan en un JSON (diputados.json) que se descarga
 * solo al abrir su pestaña; sin buscar se ven los que declaran más propiedades.
 * Las tarjetas de cualquier votación y las comparaciones se crean en Votaciones (?crear=1): el aviso de arriba lleva allí.
 * Sin JavaScript se ven las tarjetas ya hechas y cada una abre su imagen.
 */
import Base from '../../../layouts/Base.astro';
import DialogoCompartir from '../../../components/DialogoCompartir.astro';
import Icono from '../../../components/Icono.astro';
import Pestanas from '../../../components/Pestanas.astro';
import { votaciones, diputados, url, grupos, circunscripciones, slug } from '../../../lib/data';
import { nombreLegible, tipoCirc } from '../../../lib/provincias';
import { rutaTarjeta, temaCorto, compartir, type ModoHemiciclo } from '../../../lib/tarjetas';
import { ESTADISTICAS } from '../../../lib/tarjetas-estadisticas';
import textosTarjetas from '../../../i18n/textos/tarjetas';
import { favorable } from '../../../lib/votaciones';
import { rutasIdioma, idiomaDe, enlace, formatos, f, pl, prefijo } from '../../../i18n';
import textos from '../../../i18n/textos/tarjetas-pagina';
import comun from '../../../i18n/textos/comun';
import textosCompartir from '../../../i18n/textos/compartir';
import { sinTildes } from '../../../lib/texto';

export const getStaticPaths = rutasIdioma;
const lang = idiomaDe(Astro.params.lang);
const t = textos[lang];
const tc = comun[lang];
const tco = textosCompartir[lang];
const { fecha: fmtFecha, comparar } = formatos(lang);
const resultados = tc.resultado as Record<string, string>;
const r = rutaTarjeta;
const norm = (s: string) => sinTildes(s).toLowerCase();
const dip = (n: number) => pl(n, tc.palabras.diputados, lang);

const vots = [...votaciones].sort((a, b) => b.fecha.localeCompare(a.fecha));
const MODOS: ModoHemiciclo[] = ['grupo', 'propiedades', 'viviendas'];
// Estadísticas: cada tarjeta enlaza a su caja en Estadísticas
const tte = textosTarjetas[lang].estadisticas;
const ANCLA = { rentas: 'mas-rentas', inversiones: 'acciones-fondos', empresas: 'relacion-empresas', ong: 'ong' } as const;
// Datos de cada tarjeta para la ventana de compartir (los lee DialogoCompartir de los atributos data-*)
const datos = (historia: string, horizontal: string, nombre: string, c: { enlace: string; texto: string }, titulo: string) => ({
  href: url(historia), 'data-compartir': nombre, 'data-historia': url(historia), 'data-horizontal': url(horizontal),
  'data-nombre': nombre, 'data-enlace': c.enlace, 'data-ct': c.texto, 'data-titulo': titulo,
  'aria-label': f(t.abrir, { nombre: titulo }), 'aria-haspopup': 'dialog' as const,
});
const sinHref = ({ href: _, ...x }: ReturnType<typeof datos>) => x;
// Provincias: cuántos diputados elige cada una; muestra inicial, Barcelona
const nDip = (nombre: string) => diputados.filter((d) => d.circunscripcion === nombre).length;
const provIni = circunscripciones.find((c) => c.id === 'barcelona') ?? circunscripciones[0];
// Diputados: muestra inicial, quien declara más propiedades
const dipIni = [...diputados].sort((a, b) => (b.patrimonio.propiedades ?? -1) - (a.patrimonio.propiedades ?? -1) || comparar(a.apellidos, b.apellidos))[0];
const subDip = (d: typeof dipIni) => `${d.grupoCorto} · ${nombreLegible(d.circunscripcion)}`;
const config = {
  json: url(`${prefijo(lang)}/tarjetas/diputados.json`),
  colores: Object.fromEntries(grupos.map((g) => [g.corto, g.color])),
  abrir: t.abrir, sinResultados: t.sinResultados, mas: t.masResultados, masPropiedades: t.masPropiedades,
  diputados: tc.palabras.diputados, propiedades: tc.palabras.propiedades,
};
const PESTANAS = [
  { id: 'resumen', texto: t.categorias.resumen, icono: 'hemiciclo' as const },
  { id: 'estadisticas', texto: t.categorias.estadisticas, icono: 'estadisticas' as const },
  { id: 'votaciones', texto: t.categorias.votaciones, icono: 'votaciones' as const },
  { id: 'provincias', texto: t.categorias.provincias, icono: 'mapa' as const },
  { id: 'diputados', texto: t.categorias.diputados, icono: 'fichas' as const },
];
const icoCompartir = '<svg width="18" height="18" aria-hidden="true"><use href="#i-compartir" /></svg>';
---
<Base title={t.titulo} imagen={r.pagina('tarjetas')} description={t.descripcion}>
  <h1>{t.titulo}</h1>
  <p class="lead">{t.lead}</p>

  <a class="crear" href={`${enlace('/votaciones', lang)}?crear=1`}>
    <span class="crear-ico" aria-hidden="true"><Icono n="imagen" tam={24} /></span>
    <span class="crear-txt"><strong>{t.crear.titulo}</strong><span>{t.crear.texto}</span></span>
    <span class="crear-ir"><span class="crear-boton">{t.crear.boton}</span><Icono n="derecha" tam={20} /></span>
  </a>

  <Pestanas etiqueta={t.categorias.aria} pestanas={PESTANAS} />

  <section class="panel-pestana" id="resumen" role="tabpanel" aria-labelledby="tab-resumen" data-activo>
    <h2 class="panel-tit">{t.cifras}</h2>
    <ul class="galeria" role="list">
      {MODOS.map((m) => (
        <li>
          <a class="tarjeta" {...datos(r.resumen('historia', lang, m), r.resumen('horizontal', lang, m), `congreso-abierto${m === 'grupo' ? '' : `-${m}`}`, compartir.resumen(lang), t.modos[m])}>
            <img src={url(r.mini('resumen', m, lang))} alt={t.altResumen} width="270" height="480" loading="lazy" decoding="async" />
            <span class="t-pie"><strong>{t.modos[m]}</strong></span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="panel-pestana" id="estadisticas" role="tabpanel" aria-labelledby="tab-estadisticas">
    <h2 class="panel-tit">{t.categorias.estadisticas}</h2>
    <ul class="galeria" role="list">
      {ESTADISTICAS.map((id) => (
        <li>
          <a class="tarjeta" {...datos(r.estadistica(id, 'historia', lang), r.estadistica(id, 'horizontal', lang), `congreso-abierto-${id}`, compartir.estadistica(id, tte[id].titulo, ANCLA[id], lang), tte[id].titulo)}>
            <img src={url(r.mini('estadistica', id, lang))} alt={tte[id].titulo} width="270" height="480" loading="lazy" decoding="async" />
            <span class="t-pie"><strong>{tte[id].titulo}</strong><span class="t-meta">{tte[id].etiqueta}</span></span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="panel-pestana" id="votaciones" role="tabpanel" aria-labelledby="tab-votaciones">
    <h2 class="panel-tit">{t.votaciones}</h2>
    <ul class="galeria" role="list">
      {vots.map((v) => (
        <li>
          <a class="tarjeta" {...datos(r.votacion(v, 'historia', lang), r.votacion(v, 'horizontal', lang), `congreso-abierto-${v.id}`, compartir.votacion(v, lang), temaCorto(v.tema))}>
            <img src={url(r.mini('votacion', v.id, lang))} alt={f(t.altVotacion, { tema: temaCorto(v.tema), fecha: fmtFecha(v.fecha), resultado: resultados[v.resultado] ?? v.resultado })} width="270" height="480" loading="lazy" decoding="async" />
            <span class="t-pie">
              <strong>{temaCorto(v.tema)}</strong>
              <span class="t-meta"><span class:list={['res', favorable(v.resultado)]}>{resultados[v.resultado] ?? v.resultado}</span>{fmtFecha(v.fecha)}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- Provincias: muestra (Barcelona) y lista con buscador -->
  <section class="panel-pestana" id="provincias" role="tabpanel" aria-labelledby="tab-provincias">
    <h2 class="panel-tit">{t.provincia}</h2>
    <div class="elige" data-elige="prov">
      <figure class="muestra">
        <button type="button" class="m-img" tabindex="-1" aria-hidden="true">
          <img src={url(r.mini('provincia', provIni.id, lang))} alt={f(t.altProvincia, { provincia: provIni.legible, ...tipoCirc(provIni.nombre) })} width="270" height="480" loading="lazy" decoding="async" />
        </button>
        <figcaption>
          <strong class="m-nombre">{provIni.legible}</strong>
          <span class="m-sub">{dip(nDip(provIni.nombre))}</span>
          <button type="button" class="btn primario m-compartir" {...sinHref(datos(r.provincia(provIni.id, 'historia', lang), r.provincia(provIni.id, 'horizontal', lang), `congreso-abierto-${provIni.id}`, compartir.provincia(provIni.id, lang), provIni.legible))}><Fragment set:html={icoCompartir} />{tco.ui.dialogo}</button>
          <span class="m-ayuda small muted">{t.ejemplo}</span>
        </figcaption>
      </figure>
      <div class="e-lista">
        <label class="buscador">
          <Icono n="buscar" tam={20} />
          <span class="sr-only">{t.buscarProvincia}</span>
          <input type="search" data-filtro placeholder={t.buscarProvincia} autocomplete="off" enterkeyhint="search" />
        </label>
        <ul class="lista" role="list">
          {circunscripciones.map((c) => (
            <li data-n={norm(c.legible)}>
              <a class="fila" href={url(r.provincia(c.id, 'historia', lang))} aria-current={c.id === provIni.id ? 'true' : undefined}
                data-t-historia={url(r.provincia(c.id, 'historia', lang))} data-t-mini={url(r.mini('provincia', c.id, lang))} data-t-horizontal={url(r.provincia(c.id, 'horizontal', lang))}
                data-t-nombre={`congreso-abierto-${c.id}`} data-t-enlace={compartir.provincia(c.id, lang).enlace} data-t-ct={compartir.provincia(c.id, lang).texto}
                data-t-titulo={c.legible} data-t-sub={dip(nDip(c.nombre))} data-t-alt={f(t.altProvincia, { provincia: c.legible, ...tipoCirc(c.nombre) })}>
                <span class="f-nombre">{c.legible}<span class="f-sub">{dip(nDip(c.nombre))}</span></span><Icono n="derecha" tam={18} class="f-ir" />
              </a>
            </li>
          ))}
        </ul>
        <p class="vacio muted small" data-vacio hidden>{t.sinResultados}</p>
      </div>
    </div>
  </section>

  <!-- Diputados: muestra (quien declara más propiedades) y lista con buscador -->
  <section class="panel-pestana" id="diputados" role="tabpanel" aria-labelledby="tab-diputados">
    <h2 class="panel-tit">{t.diputado}</h2>
    <div class="elige" data-elige="dip">
      <figure class="muestra">
        <button type="button" class="m-img" tabindex="-1" aria-hidden="true">
          <img src={url(r.diputado(dipIni, 'historia', lang))} alt={f(t.altDiputado, { nombre: dipIni.nombreCompleto })} width="270" height="480" loading="lazy" decoding="async" />
        </button>
        <figcaption>
          <strong class="m-nombre">{dipIni.nombreCompleto}</strong>
          <span class="m-sub">{subDip(dipIni)}</span>
          <button type="button" class="btn primario m-compartir" data-compartir={slug(dipIni)} data-cn={dipIni.nombreCompleto} data-ct={compartir.diputado(dipIni, lang).texto} aria-haspopup="dialog" aria-label={f(t.abrir, { nombre: dipIni.nombreCompleto })}><Fragment set:html={icoCompartir} />{tco.ui.dialogo}</button>
          <span class="m-ayuda small muted">{t.ejemplo}</span>
        </figcaption>
      </figure>
      <div class="e-lista">
        <label class="buscador">
          <Icono n="buscar" tam={20} />
          <span class="sr-only">{t.buscarDiputado}</span>
          <input type="search" data-filtro placeholder={t.buscarDiputado} autocomplete="off" enterkeyhint="search" />
        </label>
        <p class="e-tit small" id="t-dip-tit">{t.masPropiedades}</p>
        <ul class="lista" role="list" id="t-dip-lista" aria-live="polite"></ul>
        <p class="vacio muted small" id="t-dip-mas" hidden></p>
        <p class="small muted tambien" set:html={f(t.tambien, { enlace: `<a href="${enlace('/diputados', lang)}">${t.fichaEnlace}</a>` })} />
      </div>
    </div>
  </section>

  <DialogoCompartir />
  <script type="application/json" id="tarjetas-cfg" set:html={JSON.stringify(config).replace(/</g, '\\u003c')} />
</Base>

<script>
  import { sinTildes } from '../../../lib/texto';
  import { f, pl, prefijo } from '../../../i18n/cliente';
  const cfg = JSON.parse(document.getElementById('tarjetas-cfg')!.textContent!) as {
    json: string; colores: Record<string, string>; abrir: string; sinResultados: string; mas: [string, string]; masPropiedades: string;
    diputados: [string, string]; propiedades: [string, string];
  };
  const norm = (s: string) => sinTildes(s).toLowerCase().trim();
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const movil = matchMedia('(max-width: 720px)');

  /** Muestra de una tarjeta (provincia o diputado) con su botón de compartir. */
  function muestra(raiz: HTMLElement) {
    const img = raiz.querySelector<HTMLImageElement>('.muestra img')!;
    const boton = raiz.querySelector<HTMLButtonElement>('.m-compartir')!;
    raiz.querySelector('.m-img')!.addEventListener('click', () => boton.click());
    return (d: { imagen: string; titulo: string; sub: string; alt: string; datos: Record<string, string> }) => {
      img.src = d.imagen;
      img.alt = d.alt;
      raiz.querySelector('.m-nombre')!.textContent = d.titulo;
      raiz.querySelector('.m-sub')!.textContent = d.sub;
      // Datos para la ventana de compartir: los de antes se borran (provincia: rutas completas; diputado: solo el slug)
      Object.keys(boton.dataset).forEach((k) => delete boton.dataset[k]);
      Object.assign(boton.dataset, d.datos);
      boton.setAttribute('aria-label', f(cfg.abrir, { nombre: d.titulo }));
      // En el móvil la muestra puede quedar fuera de la vista: se abre ya la ventana de compartir
      if (movil.matches) boton.click();
    };
  }
  const marcar = (lista: HTMLElement, el: Element) => lista.querySelectorAll('[aria-current]').forEach((x) => x !== el && x.removeAttribute('aria-current'));

  // ---------- Provincias ----------
  const prov = document.querySelector<HTMLElement>('[data-elige="prov"]')!;
  const provLista = prov.querySelector<HTMLElement>('.lista')!;
  const provFiltro = prov.querySelector<HTMLInputElement>('[data-filtro]')!;
  const mostrarProv = muestra(prov);
  const filtrarProv = () => {
    const q = norm(provFiltro.value);
    let n = 0;
    provLista.querySelectorAll<HTMLElement>('li').forEach((li) => { const si = !q || li.dataset.n!.includes(q); li.hidden = !si; if (si) n++; });
    prov.querySelector<HTMLElement>('[data-vacio]')!.hidden = n > 0;
  };
  provFiltro.addEventListener('input', filtrarProv);
  provLista.addEventListener('click', (e) => {
    const a = (e.target as Element).closest<HTMLAnchorElement>('a.fila');
    if (!a) return;
    e.preventDefault();
    const x = a.dataset;
    a.setAttribute('aria-current', 'true');
    marcar(provLista, a);
    mostrarProv({
      imagen: x.tMini!, titulo: x.tTitulo!, sub: x.tSub!, alt: x.tAlt!,
      datos: { compartir: x.tNombre!, historia: x.tHistoria!, horizontal: x.tHorizontal!, nombre: x.tNombre!, enlace: x.tEnlace!, ct: x.tCt!, titulo: x.tTitulo! },
    });
  });

  // ---------- Diputados: se descargan al abrir su pestaña ----------
  type Fila = [slug: string, nombre: string, grupo: string, provincia: string, texto: string, propiedades: number | null];
  const MAX = 15;
  const dipRaiz = document.querySelector<HTMLElement>('[data-elige="dip"]')!;
  const dipFiltro = dipRaiz.querySelector<HTMLInputElement>('[data-filtro]')!;
  const lista = document.getElementById('t-dip-lista')!;
  const mas = document.getElementById('t-dip-mas')!;
  const titulo = document.getElementById('t-dip-tit')!;
  const mostrarDip = muestra(dipRaiz);
  let filas: Fila[] | null = null;
  let indice: string[] = [];
  let porPropiedades: number[] = [];
  let cargando: Promise<void> | null = null;
  const cargar = () => (cargando ??= fetch(cfg.json).then((r) => r.json()).then((x: Fila[]) => {
    filas = x;
    indice = x.map(([, n, g, p]) => norm(`${n} ${g} ${p}`));
    // Sin buscar: quienes declaran más propiedades (y, a igualdad, por apellidos, como llega la lista)
    porPropiedades = x.map((_, i) => i).sort((a, b) => (x[b][5] ?? -1) - (x[a][5] ?? -1) || a - b);
    pintar();
  }).catch(() => { cargando = null; }));
  function pintar() {
    if (!filas) return;
    const palabras = norm(dipFiltro.value).split(/\s+/).filter(Boolean);
    const hallados = palabras.length ? filas.map((_, i) => i).filter((i) => palabras.every((w) => indice[i].includes(w))) : porPropiedades;
    titulo.textContent = palabras.length ? pl(hallados.length, cfg.diputados) : cfg.masPropiedades;
    const actual = lista.querySelector<HTMLElement>('[aria-current]')?.dataset.slug;
    lista.innerHTML = hallados.slice(0, MAX).map((i) => {
      const [s, n, g, p, , prop] = filas![i];
      return `<li><button type="button" class="fila" data-i="${i}" data-slug="${esc(s)}"${s === actual ? ' aria-current="true"' : ''}>`
        + `<span class="dot" style="background:${esc(cfg.colores[g] ?? 'var(--muted)')}"></span><span class="f-nombre">${esc(n)}<span class="f-sub">${esc(g)} · ${esc(p)}</span></span>`
        + (prop ? `<span class="f-n">${esc(pl(prop, cfg.propiedades))}</span>` : '')
        + '</button></li>';
    }).join('');
    const resto = hallados.length - MAX;
    mas.hidden = !(resto > 0 || !hallados.length);
    mas.textContent = !hallados.length ? cfg.sinResultados : resto > 0 ? pl(resto, cfg.mas) : '';
  }
  lista.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>('.fila');
    if (!b || !filas) return;
    const [s, n, g, p, texto] = filas[Number(b.dataset.i)];
    b.setAttribute('aria-current', 'true');
    marcar(lista, b);
    const historia = `${prefijo()}/tarjetas/historia/diputado/${s}.png`;
    mostrarDip({ imagen: historia, titulo: n, sub: `${g} · ${p}`, alt: n, datos: { compartir: s, cn: n, ct: texto } });
  });
  let espera = 0;
  dipFiltro.addEventListener('input', () => { clearTimeout(espera); espera = window.setTimeout(pintar, 120); });
  dipFiltro.addEventListener('focus', cargar, { once: true });
  document.addEventListener('pestana', (e) => { if ((e as CustomEvent<string>).detail === 'diputados') cargar(); });
  if (document.getElementById('diputados')!.hasAttribute('data-activo')) cargar();
  // El navegador puede recordar lo escrito al volver atrás
  addEventListener('pageshow', () => { filtrarProv(); if (filas) pintar(); });
</script>

<style>
  h1 { margin-bottom: .3rem; }
  .lead { margin-top: 0; }
  /* Crear la tarjeta de cualquier votación: lleva a Votaciones */
  .crear {
    display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 12px 14px; margin: 16px 0 20px; padding: 14px 16px;
    border-radius: 16px; text-decoration: none; color: var(--text); background: var(--accent-soft);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 35%, transparent); transition: box-shadow .15s;
  }
  .crear:hover { color: var(--text); box-shadow: inset 0 0 0 1.5px var(--accent); }
  .crear-ico { display: grid; place-items: center; width: 46px; height: 46px; border-radius: 14px; background: var(--surface); color: var(--accent-text); }
  .crear-txt { display: flex; flex-direction: column; gap: 2px; line-height: 1.35; }
  .crear-txt span { font-size: .88rem; color: var(--muted); }
  .crear-ir { display: inline-flex; align-items: center; justify-content: center; gap: 4px; min-width: 40px; min-height: 40px; border-radius: 12px; background: var(--accent-strong); color: #fff; font-weight: 650; }
  .crear-boton { display: none; }
  @media (min-width: 721px) {
    .crear { padding: 16px 20px; }
    .crear-ir { min-height: 44px; padding: 0 16px 0 20px; }
    .crear-boton { display: inline; }
  }

  .panel-tit { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  :global(html:not(.js)) .panel-tit { position: static; width: auto; height: auto; clip: auto; }
  .panel-pestana { scroll-margin-top: calc(var(--tope) + 90px); }

  /* Galería de tarjetas verticales */
  .galeria { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px 12px; }
  @media (min-width: 600px) { .galeria { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px 18px; } }
  @media (min-width: 1000px) { .galeria { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .tarjeta { display: flex; flex-direction: column; gap: 10px; text-decoration: none; color: var(--text); -webkit-tap-highlight-color: transparent; }
  .tarjeta img, .muestra img {
    display: block; width: 100%; height: auto; aspect-ratio: 9 / 16; object-fit: cover; border-radius: 14px; background: var(--chip);
    box-shadow: 0 1px 2px rgb(0 0 0 / .06), 0 8px 24px rgb(0 0 0 / .08); outline: 1px solid var(--border); outline-offset: -1px;
    transition: transform .2s ease, box-shadow .2s ease;
  }
  .tarjeta:hover { color: var(--text); }
