---
/**
 * Diputados de una circunscripción. Es la página a la que llega quien busca «diputados de Sevilla» y la que se
 * comparte con la tarjeta de la provincia. HTML estático y ligero: sin scripts propios, salvo el de compartir.
 */
import Base from '../../../layouts/Base.astro';
import BotonCompartir from '../../../components/BotonCompartir.astro';
import DialogoCompartir from '../../../components/DialogoCompartir.astro';
import { diputados, circunscripciones, grupos, colorGrupo, slug, type Circunscripcion } from '../../../lib/data';
import { compartir, rutaTarjeta } from '../../../lib/tarjetas';
import { migas } from '../../../lib/seo';
import { conIdiomas, enlace, formatos, f, pl, type Idioma } from '../../../i18n';
import comun from '../../../i18n/textos/comun';
import textos from '../../../i18n/textos/provincia';

export function getStaticPaths() {
  return conIdiomas(circunscripciones.map((c) => ({ params: { id: c.id }, props: { c } })));
}
const { c, lang } = Astro.props as { c: Circunscripcion; lang: Idioma };
const t = textos[lang];
const tc = comun[lang];
const { num: fmtNum, comparar } = formatos(lang);
const u = (p: string) => enlace(p, lang);

const orden = new Map(grupos.map((g) => [g.corto, g.orden]));
const ds = diputados.filter((d) => d.circunscripcion === c.nombre)
  .sort((a, b) => (orden.get(a.grupoCorto) ?? 99) - (orden.get(b.grupoCorto) ?? 99) || comparar(a.apellidos, b.apellidos));
const conDatos = ds.filter((d) => d.patrimonio.viviendas !== null);
const propiedades = conDatos.reduce((a, d) => a + (d.patrimonio.propiedades ?? 0), 0);
const viviendas = conDatos.reduce((a, d) => a + (d.patrimonio.viviendas ?? 0), 0);
const sinDecl = ds.length - conDatos.length;
const porGrupo = [...new Set(ds.map((d) => d.grupoCorto))].map((g) => ({ g, n: ds.filter((d) => d.grupoCorto === g).length }));
const nDip = pl(ds.length, tc.palabras.diputados, lang);
const ruta = u(`/provincia/${c.id}`);
const sh = compartir.provincia(c.id, lang);
const tarjeta = {
  historia: rutaTarjeta.provincia(c.id, 'historia', lang), horizontal: rutaTarjeta.provincia(c.id, 'horizontal', lang),
  nombre: `congreso-abierto-${c.id}`, enlace: sh.enlace, texto: sh.texto,
  titulo: f(t.tituloTarjeta, { provincia: c.legible }), etiqueta: f(t.compartir, { provincia: c.legible }),
};
const bienes = (d: (typeof ds)[number]) => d.patrimonio.viviendas === null
  ? t.sinDeclaracion
  : `${pl(d.patrimonio.propiedades ?? 0, tc.palabras.propiedades, lang)} · ${pl(d.patrimonio.viviendas, tc.palabras.viviendas, lang)}`;
const otras = circunscripciones.filter((x) => x.id !== c.id);
---
<Base
  title={f(t.titulo, { provincia: c.legible })}
  tituloSeo={`${f(t.tituloSeo, { provincia: c.legible })} · Congreso Abierto`}
  description={f(t.descripcion, { diputados: nDip, provincia: c.legible })}
  imagen={rutaTarjeta.provincia(c.id, 'horizontal')}
  jsonLd={migas([[tc.nav.diputados, u('/diputados')], [c.legible, ruta]])}
>
  <p class="volver-p"><a class="volver" href={u('/diputados')}>← {tc.nav.diputados}</a></p>
  <div class="cab">
    <h1>{f(t.titulo, { provincia: c.legible })}</h1>
    <BotonCompartir tarjeta={tarjeta} />
  </div>
  <p class="lead">{f(t.lead, { provincia: c.legible })}</p>

  <div class="cifras">
    <div class="card stat destacada"><span class="v">{fmtNum(ds.length)}</span><span class="l">{t.cifras.diputados}</span></div>
    <div class="card stat"><span class="v">{conDatos.length ? fmtNum(propiedades) : '—'}</span><span class="l">{t.cifras.propiedades}</span></div>
    <div class="card stat"><span class="v">{conDatos.length ? fmtNum(viviendas) : '—'}</span><span class="l">{t.cifras.viviendas}</span></div>
  </div>
  {sinDecl > 0 && <p class="small muted">{pl(sinDecl, t.sinDeclaracionN, lang)}</p>}

  <h2 class="sr-only">{t.porGrupo}</h2>
  <ul class="grupos" role="list" aria-label={t.porGrupo}>
    {porGrupo.map(({ g, n }) => <li class="pill"><span class="dot" style={`background:${colorGrupo(g)}`}></span>{g} {n}</li>)}
  </ul>

  <h2>{t.lista}</h2>
  <ul class="lista" role="list">
    {ds.map((d) => (
      <li>
        <a href={u(`/diputado/${slug(d)}`)}>
          <img src={d.fotoUrl} alt="" width="44" height="56" loading="lazy" decoding="async" referrerpolicy="no-referrer" style={`--g:${colorGrupo(d.grupoCorto)}`} />
          <span class="l-texto">
            <span class="l-nombre">{d.nombreCompleto}</span>
            <span class="l-sub"><span class="dot" style={`background:${colorGrupo(d.grupoCorto)}`}></span>{d.grupoCorto} · {bienes(d)}</span>
          </span>
          <svg class="l-ir" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6" /></svg>
        </a>
      </li>
    ))}
  </ul>

  <details class="otras">
    <summary>{t.otras}</summary>
    <ul role="list">
      {otras.map((x) => <li><a href={u(`/provincia/${x.id}`)}>{x.legible}</a></li>)}
    </ul>
  </details>
  <DialogoCompartir />
</Base>

<style>
  .volver-p { margin: 0 0 6px; }
  .cab { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
  .cab h1 { margin-bottom: .3rem; overflow-wrap: anywhere; }
  .cab :global(.boton-compartir) { flex: none; margin-top: 4px; }
  .cifras { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; margin: 1rem 0 .4rem; }
  .cifras .card { padding: 12px; }
  .grupos { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; margin: 14px 0 0; padding: 0; }
  .lista { list-style: none; margin: 0; padding: 0; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; }
  .lista li + li { border-top: 1px solid var(--border); }
  .lista a { display: flex; align-items: center; gap: 12px; padding: 10px 12px; min-height: 64px; text-decoration: none; color: var(--text); background-image: none; }
  .lista a:hover { background: color-mix(in srgb, var(--accent) 6%, transparent); color: var(--text); }
  .lista img { flex: none; width: 44px; height: 56px; object-fit: cover; border-radius: 8px; background: var(--chip); box-shadow: inset 0 -3px 0 var(--g); }
  .l-texto { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
  .l-nombre { font-weight: 650; line-height: 1.3; overflow-wrap: anywhere; }
  .l-sub { font-size: .85rem; color: var(--muted); line-height: 1.4; }
  .l-sub .dot { width: 8px; height: 8px; margin: -2px 5px 0 0; }
  .l-ir { flex: none; color: var(--muted); }
  .otras { margin-top: 28px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); }
  .otras summary { cursor: pointer; padding: 12px 16px; min-height: 48px; display: flex; align-items: center; font-weight: 650; }
  .otras ul { list-style: none; margin: 0; padding: 0 16px 16px; display: flex; flex-wrap: wrap; gap: 6px 14px; font-size: .92rem; }
  .otras li a { display: inline-block; padding: 4px 0; }
  @media (max-width: 420px) {
    .cifras { gap: 8px; }
    .cifras .card { padding: 10px; }
    .cifras .v { font-size: 1.35rem; }
    .cifras .l { font-size: .78rem; }
  }
</style>
