---
/**
 * Estadísticas: todo se calcula en la build (src/lib/estadisticas.ts) y se pinta en HTML y CSS.
 * Cifras clave arriba y tres pestañas (Votos, Perfil y Dinero), con la pestaña en la dirección (#votos…).
 * El JavaScript solo cambia de pestaña (components/Pestanas.astro) y de tema o grupo (components/Selector.astro); sin él se ven todas las estadísticas, una debajo de otra.
 */
import Base from '../../layouts/Base.astro';
import Barras from '../../components/Barras.astro';
import BarraApilada from '../../components/BarraApilada.astro';
import Selector from '../../components/Selector.astro';
import HojaInfo from '../../components/HojaInfo.astro';
import Icono from '../../components/Icono.astro';
import PestanasDatos from '../../components/PestanasDatos.astro';
import Pestanas from '../../components/Pestanas.astro';
import Tarjeta from '../../components/TarjetaEstadistica.astro';
import { diputados, votacionesPleno, grupos, colorGrupo, slug, TEMAS } from '../../lib/data';
import type { NombreIcono } from '../../lib/iconos';
import * as E from '../../lib/estadisticas';
import { rutasIdioma, idiomaDe, enlace, formatos, f, pl } from '../../i18n';
import comun from '../../i18n/textos/comun';
import textos from '../../i18n/textos/estadisticas';
import { migas } from '../../lib/seo';

export const getStaticPaths = rutasIdioma;
const lang = idiomaDe(Astro.params.lang);
const t = textos[lang];
const tc = comun[lang];
const { num, eur } = formatos(lang);
const u = (p: string) => enlace(p, lang);

const G = [...grupos].sort((a, b) => a.orden - b.orden).map((g) => g.corto);
const POSICIONES = ['Sí', 'No', 'Abstención', 'Empate'] as const;
const COLOR = { 'Sí': 'var(--si)', 'No': 'var(--no)', 'Abstención': 'var(--abs)', 'Empate': 'var(--novota)' } as const;
// Cifra dentro de la barra: oscura sobre los colores claros (abstención, empate)
const TINTA = { 'Sí': '#fff', 'No': '#fff', 'Abstención': '#1b1b1b', 'Empate': '#1b1b1b' } as const;
const etVoto = { 'Sí': tc.voto['Sí'], 'No': tc.voto['No'], 'Abstención': tc.voto['Abstención'], 'Empate': t.votoTema.empate };
const nombreTema = (id: string) => tc.temas[id] ?? id;
const MUJERES = '#c2410c', HOMBRES = '#5f6b7a';

// Votos · por tema (los temas con más votaciones primero; «Otros» al final)
const { porTema, nVotaciones } = E.votoPorTema(votacionesPleno, G);
const temas = TEMAS.map((x) => x.id).filter((id) => (nVotaciones.get(id) ?? 0) > 0)
  .sort((a, b) => Number(a === 'otros') - Number(b === 'otros') || (nVotaciones.get(b) ?? 0) - (nVotaciones.get(a) ?? 0));
const temaInicial = temas.includes('vivienda') ? 'vivienda' : temas[0];

// Votos · coincidencias entre grupos y votos distintos del grupo
const coin = E.coincidencias(votacionesPleno, G);
const pctCoin = (a: string, b: string) => { const c = coin.get(a)!.get(b)!; return c.ambos ? (100 * c.iguales) / c.ambos : null; };
const distintos = E.masDistintos(diputados, 10);
const nDistintos = diputados.filter((d) => (d.participacion?.distintoGrupo ?? 0) > 0).length;

// Perfil
const genero = E.generoPorGrupo(diputados, G);
const nMujeres = genero.reduce((a, x) => a + x.F, 0);
const dec = E.decadas(diputados);
const tipos = E.contar(diputados, (d) => d.perfil?.tipoFormacion ?? 'sin-datos', E.TIPOS_FORMACION);
const univ = E.universidades(diputados, 10);
const areas = E.areasEstudio(diputados);

// Dinero
const rentas = E.tramosRentas(diputados);
const cortes = E.CORTES_RENTAS;
const etTramo = (i: number) => i === 0 ? t.rentas.ninguna
  : i === 1 ? f(t.rentas.menos, { a: eur(cortes[0]) })
  : i <= cortes.length ? f(t.rentas.entre, { a: eur(cortes[i - 2]), b: eur(cortes[i - 1]) })
  : f(t.rentas.mas, { a: eur(cortes[cortes.length - 1]) });
const alquiler = E.conRentasDeAlquiler(diputados).sort((a, b) => G.indexOf(a.grupoCorto) - G.indexOf(b.grupoCorto) || a.apellidos.localeCompare(b.apellidos, 'es'));
const alquilerGrupo = G.map((g) => ({ g, n: alquiler.filter((d) => d.grupoCorto === g).length })).filter((x) => x.n > 0).sort((a, b) => b.n - a.n);

const dip = (n: number) => pl(n, tc.palabras.diputados, lang);
const pct = (n: number, de: number) => (de ? `${Math.round((100 * n) / de)} %` : '—');

type Pestana = 'votos' | 'perfil' | 'dinero';
const PESTANAS: { id: Pestana; icono: NombreIcono }[] = [
  { id: 'votos', icono: 'votaciones' },
  { id: 'perfil', icono: 'fichas' },
  { id: 'dinero', icono: 'rentas' },
];
const CIFRAS: { v: number; l: string; p: Pestana }[] = [
  { v: votacionesPleno.length, l: t.cifras.votaciones, p: 'votos' },
  { v: nDistintos, l: t.cifras.distintos, p: 'votos' },
  { v: nMujeres, l: t.cifras.mujeres, p: 'perfil' },
  { v: alquiler.length, l: t.cifras.alquiler, p: 'dinero' },
];
---
<Base title={t.titulo} tituloSeo={`${t.tituloSeo} · Congreso Abierto`} description={t.descripcion} jsonLd={migas([[t.titulo, u('/estadisticas')]])}>
  <PestanasDatos actual="estadisticas" />
  <h1>{t.titulo}</h1>
  <p class="lead">{t.lead}</p>

  <ul class="cifras" role="list">
    {CIFRAS.map((c) => <li><a href={`#${c.p}`} data-ir={c.p}><strong>{num(c.v)}</strong><span>{c.l}</span></a></li>)}
  </ul>

  <Pestanas etiqueta={t.pestanas.aria} pestanas={PESTANAS.map((p) => ({ ...p, texto: t.pestanas[p.id] }))} />

  <!-- ===================== Votos ===================== -->
  <div class="panel panel-pestana" role="tabpanel" id="votos" aria-labelledby="tab-votos" data-activo>
    <h2 class="panel-tit">{t.pestanas.votos}</h2>
    <Tarjeta id="voto-por-tema" titulo={t.votoTema.titulo} intro={t.votoTema.intro} como={t.votoTema.nota} descargar={u('/datos?tabla=votos-grupo')}>
      <Selector elige="tema" etiqueta={t.votoTema.elige} inicial={temaInicial} opciones={temas.map((id) => ({ id, texto: nombreTema(id), n: num(nVotaciones.get(id) ?? 0) }))} />
      <p class="leyenda small">{POSICIONES.map((k) => <span><span class="dot" style={`background:${COLOR[k]}`}></span>{etVoto[k]}</span>)}</p>
      {temas.map((id) => (
        <div class="bloque" data-bloque="tema" data-id={id} data-activo={id === temaInicial ? '' : undefined}>
          <h3 class="b-tit">{nombreTema(id)} · {pl(nVotaciones.get(id) ?? 0, t.votoTema.votaciones, lang)}</h3>
          {G.map((g) => {
            const c = porTema.get(id)!.get(g)!;
            return <BarraApilada etiqueta={g} punto={colorGrupo(g)} tramos={POSICIONES.map((k) => ({ valor: c[k], color: COLOR[k], tinta: TINTA[k], corto: num(c[k]), texto: `${etVoto[k]} ${num(c[k])}` }))} />;
          })}
          <p class="b-pie small"><span class="muted">{t.verCifras}</span> <a href={u(`/votaciones?tema=${id}`)}>{t.votoTema.ver}<Icono n="derecha" tam={15} /></a></p>
        </div>
      ))}
    </Tarjeta>

    <Tarjeta id="votos-distintos" titulo={t.distintos.titulo} intro={t.distintos.intro} como={t.distintos.nota} descargar={u('/datos?tabla=diputados')}>
      <Barras items={distintos.map((d) => ({ etiqueta: `${d.nombreCompleto} (${d.grupoCorto})`, punto: colorGrupo(d.grupoCorto), href: u(`/diputado/${slug(d)}`), valor: d.participacion!.distintoGrupo, texto: pl(d.participacion!.distintoGrupo, t.distintos.veces, lang) }))} />
    </Tarjeta>

    <Tarjeta id="coincidencias" titulo={t.coincidencia.titulo} intro={t.coincidencia.intro} como={t.coincidencia.nota} descargar={u('/datos?tabla=votos-grupo')} ancho>
      <!-- Ordenador: matriz grupo × grupo -->
      <div class="matriz-caja">
        <table class="matriz">
          <caption class="small muted">{t.matriz}</caption>
          <thead><tr><td class="m-vacia"></td>{G.map((b) => <th scope="col"><span class="dot" style={`background:${colorGrupo(b)}`}></span>{b}</th>)}</tr></thead>
          <tbody>
            {G.map((a) => (
              <tr>
                <th scope="row"><span class="dot" style={`background:${colorGrupo(a)}`}></span>{a}</th>
                {G.map((b) => {
                  if (a === b) return <td class="m-diag" aria-label="—"></td>;
                  const p = pctCoin(a, b);
                  const c = coin.get(a)!.get(b)!;
                  return <td style={p === null ? '' : `--p:${Math.round(p)}%;${p >= 62 ? 'color:#1b1b1b' : ''}`} title={`${a} · ${b}: ${f(t.coincidencia.fila, { iguales: num(c.iguales), ambos: num(c.ambos) })}`}>{p === null ? '—' : `${Math.round(p)} %`}</td>;
                })}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <!-- Móvil: un grupo cada vez -->
      <div class="coin-movil">
        <Selector elige="grupo" etiqueta={t.coincidencia.elige} inicial={G[0]} opciones={G.map((g) => ({ id: g, texto: g, punto: colorGrupo(g) }))} />
        {G.map((g, i) => {
          const filas = [...coin.get(g)!].map(([b, c]) => ({ b, ...c })).sort((x, y) => y.iguales / (y.ambos || 1) - x.iguales / (x.ambos || 1));
          return (
            <div class="bloque" data-bloque="grupo" data-id={g} data-activo={i === 0 ? '' : undefined}>
              <h3 class="b-tit"><span class="dot" style={`background:${colorGrupo(g)}`}></span> {g}</h3>
              <Barras max={100} items={filas.map((x) => ({ etiqueta: x.b, punto: colorGrupo(x.b), color: colorGrupo(x.b), valor: x.ambos ? (100 * x.iguales) / x.ambos : 0, texto: `${pct(x.iguales, x.ambos)} · ${f(t.coincidencia.fila, { iguales: num(x.iguales), ambos: num(x.ambos) })}` }))} />
            </div>
          );
        })}
      </div>
    </Tarjeta>
  </div>

  <!-- ===================== Perfil ===================== -->
  <div class="panel panel-pestana" role="tabpanel" id="perfil" aria-labelledby="tab-perfil">
    <h2 class="panel-tit">{t.pestanas.perfil}</h2>
    <Tarjeta id="perfil-genero" titulo={t.perfil.titulo} descargar={u('/datos?tabla=diputados')}>
      <p class="leyenda small"><span><span class="dot" style={`background:${MUJERES}`}></span>{t.perfil.mujeres} · {num(nMujeres)}</span><span><span class="dot" style={`background:${HOMBRES}`}></span>{t.perfil.hombres} · {num(diputados.length - nMujeres)}</span></p>
      {genero.map((x) => <BarraApilada etiqueta={x.g} punto={colorGrupo(x.g)} total={dip(x.F + x.M)} tramos={[{ valor: x.F, color: MUJERES, corto: num(x.F), texto: `${t.perfil.mujeres} ${num(x.F)}` }, { valor: x.M, color: HOMBRES, corto: num(x.M), texto: `${t.perfil.hombres} ${num(x.M)}` }]} />)}
    </Tarjeta>

    <Tarjeta id="nacimiento" titulo={t.perfil.nacTitulo} intro={t.perfil.nacIntro} descargar={u('/datos?tabla=diputados')}>
      <Barras items={dec.porDecada.map(([d, n]) => ({ etiqueta: `${d}–${d + 9}`, valor: n, texto: num(n) }))} />
    </Tarjeta>

    <Tarjeta id="formacion" titulo={t.formacion.titulo} intro={t.formacion.intro} descargar={u('/datos?tabla=diputados')} ancho>
      <div class="tres">
        <div>
          <h3 class="sub">{t.formacion.areaTitulo}</h3>
          <Barras items={areas.map((a) => ({ etiqueta: t.formacion.areas[a.id as keyof typeof t.formacion.areas], valor: a.n, texto: num(a.n) }))} />
          <p class="nota small muted">{t.formacion.areaNota}</p>
        </div>
        <div>
          <h3 class="sub">{t.formacion.univTitulo}</h3>
          <Barras items={univ.map((x) => ({ etiqueta: x.nombre, valor: x.n, texto: num(x.n) }))} />
          <p class="nota small muted">{t.formacion.univNota}</p>
        </div>
        <div>
          <h3 class="sub">{t.formacion.tipoTitulo}</h3>
          <Barras max={diputados.length} items={E.TIPOS_FORMACION.map((k) => ({ etiqueta: t.formacion.tipos[k], valor: tipos.get(k) ?? 0, texto: num(tipos.get(k) ?? 0) }))} />
        </div>
      </div>
    </Tarjeta>
  </div>

  <!-- ===================== Dinero ===================== -->
  <div class="panel panel-pestana" role="tabpanel" id="dinero" aria-labelledby="tab-dinero">
    <h2 class="panel-tit">{t.pestanas.dinero}</h2>
    <Tarjeta id="rentas" titulo={t.rentas.titulo} intro={t.rentas.intro} descargar={u('/datos?tabla=diputados')}>
      <Barras items={rentas.tramos.map((n, i) => ({ etiqueta: etTramo(i), valor: n, texto: num(n) }))} />
      <p class="nota small muted">{pl(rentas.alMenos, t.rentas.alMenos, lang)} {rentas.sinDeclaracion > 0 && pl(rentas.sinDeclaracion, t.rentas.sinDecl, lang)}</p>
    </Tarjeta>

    <Tarjeta id="alquileres" titulo={t.alquiler.titulo} como={t.alquiler.nota} descargar={u('/datos?tabla=diputados')}>
      <p class="cifra-grande"><strong>{num(alquiler.length)}</strong> <span>{pl(alquiler.length, t.alquiler.intro, lang).replace(/^\S+\s/, '')}</span></p>
      <h3 class="sub">{t.alquiler.porGrupo}</h3>
      <Barras items={alquilerGrupo.map((x) => ({ etiqueta: x.g, punto: colorGrupo(x.g), color: colorGrupo(x.g), valor: x.n, texto: num(x.n) }))} />
      <details class="lista-nombres">
        <summary>{t.alquiler.verLista}<Icono n="abajo" tam={18} /></summary>
        <ul role="list">{alquiler.map((d) => <li><a href={u(`/diputado/${slug(d)}#rentas`)}><span class="dot" style={`background:${colorGrupo(d.grupoCorto)}`}></span>{d.nombreCompleto}</a> <span class="muted small">{d.grupoCorto} · {d.circunscripcion}</span></li>)}</ul>
      </details>
    </Tarjeta>
  </div>

  <HojaInfo />
</Base>


<style>
  h1 { margin-bottom: .3rem; }
  .lead { margin-top: 0; }
  /* Cifras clave */
  .cifras { list-style: none; margin: 16px 0 18px; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .cifras a {
    display: flex; flex-direction: column; gap: 4px; height: 100%; padding: 14px; border-radius: 14px; text-decoration: none;
    background: var(--surface); border: 1px solid var(--border); transition: border-color .15s, transform .15s;
  }
  .cifras a:hover { border-color: var(--accent); color: inherit; }
  .cifras li:first-child a { background: var(--accent-soft); border-color: transparent; box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 35%, transparent); }
  .cifras strong { font-size: clamp(1.5rem, 6vw, 2rem); line-height: 1.05; font-weight: 750; font-variant-numeric: tabular-nums; letter-spacing: -.02em; }
  .cifras li:first-child strong { color: var(--accent-text); }
  .cifras span { font-size: .82rem; line-height: 1.3; color: var(--muted); }
  @media (min-width: 721px) { .cifras { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; } .cifras a { padding: 16px 18px; } }

  /* Paneles: con JavaScript, solo el activo; en el ordenador, en dos columnas */
  .panel { display: grid; gap: 14px; margin-bottom: 24px; scroll-margin-top: calc(var(--tope) + 72px); }
  .panel-tit { margin: 12px 0 0; }
  :global(html.js) .panel-tit { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @media (min-width: 900px) { .panel { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 18px; align-items: start; } .panel-tit { grid-column: 1 / -1; } }

  /* Contenido de las estadísticas */
  .leyenda { display: flex; flex-wrap: wrap; gap: 4px 14px; margin: 0 0 10px; color: var(--muted); }
  .leyenda .dot { margin: -2px 6px 0 0; width: 9px; height: 9px; }
  :global(html.js) .bloque:not([data-activo]) { display: none; }
  /* Con JavaScript el selector ya dice qué tema o grupo se ve */
  :global(html.js) .bloque > .b-tit { display: none; }
  .bloque + .bloque { margin-top: 24px; }
  .b-tit { font-size: .9rem; margin: 0 0 8px; color: var(--muted); font-weight: 650; }
  .b-pie { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 6px 12px; margin: 12px 0 0; }
  .b-pie a { display: inline-flex; align-items: center; gap: 2px; color: var(--accent-text); font-weight: 600; text-decoration: none; }
  .b-pie a:hover { text-decoration: underline; }
  .sub { font-size: .95rem; margin: 18px 0 10px; }
  .tres > div:first-child .sub { margin-top: 0; }
  .nota { margin: 10px 0 0; }
  @media (min-width: 900px) { .tres { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; } .tres .sub { margin-top: 0; } }

  /* Coincidencias: matriz en el ordenador, chips y barras en el móvil */
  .matriz-caja { display: none; }
  @media (min-width: 900px) {
    .coin-movil { display: none; }
    .matriz-caja { display: block; overflow-x: auto; }
  }
  .matriz { width: 100%; border-collapse: separate; border-spacing: 3px; table-layout: fixed; font-size: .85rem; }
  .matriz caption { caption-side: bottom; text-align: left; padding-top: 8px; }
  .matriz th { padding: 6px 4px; font-size: .78rem; text-transform: none; letter-spacing: 0; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; border: 0; }
  .matriz thead th { text-align: center; }
  .matriz th .dot { width: 8px; height: 8px; margin: -2px 5px 0 0; }
  .matriz tbody th { text-align: left; width: 96px; }
  .matriz td {
    height: 42px; padding: 0; text-align: center; vertical-align: middle; border: 0; border-radius: 6px; font-weight: 650; font-variant-numeric: tabular-nums;
    background: color-mix(in srgb, var(--accent) var(--p, 0%), var(--chip));
  }
  .matriz td.m-vacia { background: none; }
  .matriz td.m-diag { background: repeating-linear-gradient(135deg, var(--chip) 0 4px, transparent 4px 8px); }
  .matriz tbody tr:hover { background: none; }

  .cifra-grande { display: flex; align-items: baseline; gap: 10px; margin: 0 0 6px; line-height: 1.25; }
  .cifra-grande strong { font-size: clamp(2.2rem, 9vw, 3rem); color: var(--accent-text); font-variant-numeric: tabular-nums; }
  .lista-nombres { margin-top: 14px; border-top: 1px solid var(--border); }
  .lista-nombres summary { cursor: pointer; min-height: 48px; display: flex; align-items: center; justify-content: space-between; color: var(--accent-text); font-weight: 600; font-size: .92rem; list-style: none; }
  .lista-nombres summary::-webkit-details-marker { display: none; }
  .lista-nombres[open] summary :global(svg) { transform: rotate(180deg); }
  .lista-nombres ul { list-style: none; margin: 0 0 4px; padding: 0; display: grid; gap: 8px; }
  .lista-nombres li { line-height: 1.35; }
  .lista-nombres .dot { margin: -2px 6px 0 0; width: 8px; height: 8px; }
</style>
