# Cabeceras de Cloudflare Pages. HSTS se configura en el panel de Cloudflare (SSL/TLS → Edge Certificates), no aquí.

# JS, CSS y fuentes de Astro: el nombre lleva un hash, así que no cambian nunca
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# Tarjetas para compartir: la URL no cambia entre builds, así que caché corta y se refresca en segundo plano
/tarjetas/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/ca/tarjetas/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/eu/tarjetas/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/gl/tarjetas/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/en/tarjetas/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
